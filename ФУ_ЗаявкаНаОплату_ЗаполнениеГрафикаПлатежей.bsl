// Документ.ФУ_ЗаявкаНаОплату — заполнение табличной части ГрафикПлатежей
// Поля ТЧ: ДатаПлатежа, СуммаКОплате, Статус, ПлатежноеПоручение,
//          ПлатежныйДокумент, ДатаПлатежаФакт, ИсторияСогласования
// Реквизиты шапки: Сумма, ПланируемаяДатаОплаты, ОплатаПоЧастям
//
// Куда вставлять:
//   модуль объекта документа ФУ_ЗаявкаНаОплату — процедуры без &НаКлиенте/&НаСервере;
//   модуль формы — клиентские команды + серверные обёртки ниже.

#Область ПрограммныйИнтерфейс

// Одна строка графика = сумма заявки на планируемую дату оплаты.
// Оплаченные строки (Статус = Истина) не трогаем.
Процедура ЗаполнитьГрафикПлатежей() Экспорт
	
	ДатаПлатежа = ДатаПлатежаПоУмолчанию();
	Если Не ЗначениеЗаполнено(ДатаПлатежа) Тогда
		ВызватьИсключение "Не заполнены дата документа и планируемая дата оплаты.";
	КонецЕсли;
	
	Если Сумма = 0 Тогда
		ВызватьИсключение "Не заполнена сумма заявки.";
	КонецЕсли;
	
	УдалитьНеоплаченныеСтрокиГрафика();
	
	ОплаченоПоГрафику = СуммаОплаченныхСтрокГрафика();
	Остаток = Сумма - ОплаченоПоГрафику;
	Если Остаток <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСтрокуГрафика(ДатаПлатежа, Остаток);
	
КонецПроцедуры

// Равные доли: КоличествоПлатежей начиная с ДатыПервогоПлатежа, шаг ПериодМесяцев.
// Копейки уходят в последнюю неоплаченную строку. Флаг ОплатаПоЧастям включается.
//
// Пример: 12 платежей раз в месяц с 01.10.2026
//   ЗаполнитьГрафикПлатежейПоЧастям(12, Дата(2026, 10, 1), 1);
Процедура ЗаполнитьГрафикПлатежейПоЧастям(КоличествоПлатежей, ДатаПервогоПлатежа = Неопределено, ПериодМесяцев = 1) Экспорт
	
	Если КоличествоПлатежей < 1 Тогда
		ВызватьИсключение "Количество платежей должно быть не меньше 1.";
	КонецЕсли;
	Если ПериодМесяцев < 1 Тогда
		ВызватьИсключение "Период в месяцах должен быть не меньше 1.";
	КонецЕсли;
	Если Сумма = 0 Тогда
		ВызватьИсключение "Не заполнена сумма заявки.";
	КонецЕсли;
	
	ДатаСтарта = ДатаПервогоПлатежа;
	Если Не ЗначениеЗаполнено(ДатаСтарта) Тогда
		ДатаСтарта = ДатаПлатежаПоУмолчанию();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСтарта) Тогда
		ВызватьИсключение "Не задана дата первого платежа.";
	КонецЕсли;
	
	УдалитьНеоплаченныеСтрокиГрафика();
	
	ОплаченоПоГрафику = СуммаОплаченныхСтрокГрафика();
	Остаток = Сумма - ОплаченоПоГрафику;
	Если Остаток <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОплатаПоЧастям = Истина;
	
	ОплаченныхСтрок = 0;
	Для Каждого СтрокаГрафика Из ГрафикПлатежей Цикл
		Если СтрокаГрафика.Статус Тогда
			ОплаченныхСтрок = ОплаченныхСтрок + 1;
		КонецЕсли;
	КонецЦикла;
	
	ОсталосьПлатежей = КоличествоПлатежей - ОплаченныхСтрок;
	Если ОсталосьПлатежей < 1 Тогда
		ОсталосьПлатежей = 1;
	КонецЕсли;
	
	СуммаДоли = Окр(Остаток / ОсталосьПлатежей, 2);
	НакопленнаяСумма = 0;
	
	Для Номер = 1 По ОсталосьПлатежей Цикл
		
		Если Номер = ОсталосьПлатежей Тогда
			СуммаСтроки = Остаток - НакопленнаяСумма;
		Иначе
			СуммаСтроки = СуммаДоли;
			НакопленнаяСумма = НакопленнаяСумма + СуммаСтроки;
		КонецЕсли;
		
		Если СуммаСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДатаСтроки = ДобавитьМесяц(ДатаСтарта, (Номер - 1) * ПериодМесяцев);
		ДобавитьСтрокуГрафика(ДатаСтроки, СуммаСтроки);
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ПланируемаяДатаОплаты) Тогда
		ПланируемаяДатаОплаты = ДатаСтарта;
	КонецЕсли;
	
КонецПроцедуры

// Перенос дат/сумм из ТЧ Оплаты (факт/план оплат) в график. Оплаченные строки графика сохраняются.
Процедура ЗаполнитьГрафикПлатежейИзОплат() Экспорт
	
	Если Оплаты.Количество() = 0 Тогда
		ВызватьИсключение "Табличная часть «Оплаты» пустая.";
	КонецЕсли;
	
	УдалитьНеоплаченныеСтрокиГрафика();
	
	Для Каждого СтрокаОплаты Из Оплаты Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаОплаты.ДатаОплаты) Или СтрокаОплаты.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДобавитьСтрокуГрафика(СтрокаОплаты.ДатаОплаты, СтрокаОплаты.Сумма);
		НоваяСтрока.ПлатежныйДокумент = СтрокаОплаты.ПлатежныйДокумент;
		НоваяСтрока.ПлатежноеПоручение = СтрокаОплаты.ДокументОснования;
		Если ЗначениеЗаполнено(СтрокаОплаты.ПлатежныйДокумент) Тогда
			НоваяСтрока.Статус = Истина;
			НоваяСтрока.ДатаПлатежаФакт = СтрокаОплаты.ДатаОплаты;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Подтягивает график из документа ТИС_ГрафикПлатежейПоКредиту по тому же договору.
Процедура ЗаполнитьГрафикПлатежейПоКредиту() Экспорт
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		ВызватьИсключение "Не заполнен договор заявки.";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Шапка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ТИС_ГрафикПлатежейПоКредиту КАК Шапка
	|ГДЕ
	|	Шапка.Проведен
	|	И НЕ Шапка.ПометкаУдаления
	|	И Шапка.ДоговорКонтрагента = &Договор
	|	И Шапка.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Шапка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		ВызватьИсключение "По договору нет проведённого документа «График платежей по кредиту (ТИС)».";
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	ДокументГрафика = Выборка.Ссылка.ПолучитьОбъект();
	
	УдалитьНеоплаченныеСтрокиГрафика();
	
	Для Каждого СтрокаИсточника Из ДокументГрафика.ГрафикПлатежей Цикл
		Если СтрокаИсточника.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСтрокуГрафика(СтрокаИсточника.ДатаОплаты, СтрокаИсточника.Сумма);
	КонецЦикла;
	
	ОплатаПоЧастям = ГрафикПлатежей.Количество() > 1;
	
КонецПроцедуры

Функция СуммаГрафикаПлатежей() Экспорт
	
	Итог = 0;
	Для Каждого СтрокаГрафика Из ГрафикПлатежей Цикл
		Итог = Итог + СтрокаГрафика.СуммаКОплате;
	КонецЦикла;
	Возврат Итог;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДатаПлатежаПоУмолчанию()
	
	Если ЗначениеЗаполнено(ПланируемаяДатаОплаты) Тогда
		Возврат НачалоДня(ПланируемаяДатаОплаты);
	ИначеЕсли ЗначениеЗаполнено(Дата) Тогда
		Возврат НачалоДня(Дата);
	Иначе
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
КонецФункции

Процедура УдалитьНеоплаченныеСтрокиГрафика()
	
	Индекс = ГрафикПлатежей.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаГрафика = ГрафикПлатежей[Индекс];
		Если Не СтрокаГрафика.Статус Тогда
			ГрафикПлатежей.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

Функция СуммаОплаченныхСтрокГрафика()
	
	Итог = 0;
	Для Каждого СтрокаГрафика Из ГрафикПлатежей Цикл
		Если СтрокаГрафика.Статус Тогда
			Итог = Итог + СтрокаГрафика.СуммаКОплате;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
	
КонецФункции

Функция ДобавитьСтрокуГрафика(ДатаПлатежа, СуммаКОплате)
	
	НоваяСтрока = ГрафикПлатежей.Добавить();
	НоваяСтрока.ДатаПлатежа = НачалоДня(ДатаПлатежа);
	НоваяСтрока.СуммаКОплате = СуммаКОплате;
	НоваяСтрока.Статус = Ложь;
	НоваяСтрока.ДатаПлатежаФакт = Дата(1, 1, 1);
	НоваяСтрока.ИсторияСогласования = "";
	Возврат НоваяСтрока;
	
КонецФункции

Процедура ПередЗаписью_ПроверитьГрафик(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ГрафикПлатежей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если СуммаГрафикаПлатежей() <> Сумма Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(
			"Сумма графика платежей (%1) не равна сумме заявки (%2).",
			СуммаГрафикаПлатежей(),
			Сумма);
		Сообщение.Поле = "ГрафикПлатежей";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область МодульФормы

&НаКлиенте
Процедура ЗаполнитьГрафик(Команда)
	ЗаполнитьГрафикНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГрафикНаСервере()
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьГрафикПлатежей();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГрафикПоЧастям(Команда)
	
	ПоказатьВводЧисла(
		Новый ОписаниеОповещения("ЗаполнитьГрафикПоЧастямПослеВвода", ЭтотОбъект),
		12,
		"Количество платежей",
		3,
		0);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьГрафикПоЧастямПослеВвода(КоличествоПлатежей, ДополнительныеПараметры) Экспорт
	
	Если КоличествоПлатежей = Неопределено Или КоличествоПлатежей < 1 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьГрафикПоЧастямНаСервере(КоличествоПлатежей);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГрафикПоЧастямНаСервере(КоличествоПлатежей)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьГрафикПлатежейПоЧастям(КоличествоПлатежей);
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

#КонецОбласти
