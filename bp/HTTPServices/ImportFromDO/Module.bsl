// HTTP-сервис ImportFromDO, метод Download = живая ЗагрузкаCreateZayavka.
// Не отдавать тело "OK": ДО показывает его как есть.
// График из ДО — структура Стр1, Стр2 или массив. Если пусто — одна строка
// (срок / ДатаОплаты → ДатаПлатежа, она же запланированная дата).
// Реквизит плановой: ПлановаяЗаявка (если нет — Плановая).

Функция Download(Запрос)
	
	Возврат ЗагрузкаCreateZayavka(Запрос);
	
КонецФункции

Функция ЗагрузкаCreateZayavka(Запрос)
	
	ИмяСобытия = "ImportFromDO";
	
	Попытка
		
		Сообщение = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Download тело=" + Лев(Сообщение, 2000));
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Сообщение);
		МассивОбъектовJSON = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		тзСчетов = ПреобразованиеМассивВТаблицуЗначений(МассивОбъектовJSON);
		
		Орг = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
		Валюта = Справочники.Валюты.НайтиПоКоду("643");
		
		ДокументУспешноСоздан = Ложь;
		ТекстОшибки = "";
		ТекстУспеха = "Ваша заявка отправлена на согласование";
		
		Для Каждого ТекСчет Из тзСчетов Цикл
			
			Попытка
				
				Плановая = ЭтоПлановаяЗаявкаДО(ТекСчет);
				ПроверкаПлановой = Неопределено;
				Если Не Плановая Тогда
					ПроверкаПлановой = ПроверитьПлановуюДляСчета(ТекСчет);
					Если Не ПроверкаПлановой.Можно Тогда
						ТекстОшибки = ПроверкаПлановой.Сообщение;
						ВызватьИсключение ТекстОшибки;
					КонецЕсли;
				КонецЕсли;
				
				ДокЗаявка = Документы.ФУ_ЗаявкаНаОплату.СоздатьДокумент();
				ЗаполнитьШапкуЗаявкиИзДО(ДокЗаявка, ТекСчет, Орг, Валюта, Плановая);
				СвязатьСчетСПлановой(ДокЗаявка, ПроверкаПлановой);
				ЗаполнитьГрафикЗаявкиИзДО(ДокЗаявка, ТекСчет);
				ДозаполнитьСуммыИДатыПоГрафику(ДокЗаявка);
				Автоодобрение = (Не Плановая И ПроверкаПлановой <> Неопределено И ПроверкаПлановой.АвтоСогласовать);
				Если Автоодобрение Тогда
					ПометитьАвтоодобрение(ДокЗаявка);
					ПодготовитьАвтоодобрениеДоЗаписи(ДокЗаявка);
				КонецЕсли;
				
				ДокЗаявка.Записать(РежимЗаписиДокумента.Запись);
				
				ПрикрепитьФайлыИзДО(ДокЗаявка, ТекСчет);
				
				ЗаполнитьСогласующихЗаявки(ДокЗаявка);
				Если Автоодобрение Тогда
					ПометитьАвтоодобрение(ДокЗаявка);
					ПодготовитьАвтоодобрениеДоЗаписи(ДокЗаявка);
				КонецЕсли;
				ДокЗаявка.Записать(РежимЗаписиДокумента.Запись);
				
				Если Автоодобрение Тогда
					ПометитьАвтоодобрение(ДокЗаявка);
					ПодготовитьАвтоодобрениеДоЗаписи(ДокЗаявка);
				КонецЕсли;
				ДокЗаявка.Записать(РежимЗаписиДокумента.Проведение);
				
				Если Не Плановая Тогда
					Если Автоодобрение Тогда
						АвтосогласоватьЗаявкуПоПлановой(ДокЗаявка, ПроверкаПлановой);
						ЗафиксироватьОдобрениеБезТиповыхОбработчиков(ДокЗаявка.Ссылка);
						ЗафиксироватьОдобрениеБезТиповыхОбработчиков(ДокЗаявка.Ссылка);
						ТекстУспеха = "Ваша заявка отправлена на согласование. Счёт согласован автоматически: сумма в пределах 5% от согласованной плановой заявки.";
					Иначе
						ДокЗаявка.Статус = Перечисления.ФУ_СтатусыЗаявок.НаСогласовании;
						ДокЗаявка.Записать(РежимЗаписиДокумента.Запись);
					КонецЕсли;
				Иначе
					ДокЗаявка.Статус = Перечисления.ФУ_СтатусыЗаявок.НаСогласовании;
					ДокЗаявка.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;
				
				ДокументУспешноСоздан = Истина;
				
			Исключение
				ТекстОшибки = ОписаниеОшибки();
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			КонецПопытки;
			
		КонецЦикла;
		
		Если ДокументУспешноСоздан Тогда
			Возврат ОтветJSONDownload(Истина, ТекстУспеха);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТекстОшибки) Тогда
			ТекстОшибки = "Не удалось создать заявку";
		КонецЕсли;
		Возврат ОтветJSONDownload(Ложь, ТекстОшибки);
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветJSONDownload(Ложь, ТекстОшибки);
		
	КонецПопытки;
	
КонецФункции

Процедура ЗаполнитьШапкуЗаявкиИзДО(ДокЗаявка, ТекСчет, Орг, Валюта, Плановая)
	
	ДокЗаявка.Дата = ТекущаяДата();
	
	Попытка
		ДокЗаявка.Организация = ФУ_ОбщийМодульСервер.ВыводОрганизацияПоУмолчанию();
	Исключение
		ДокЗаявка.Организация = Орг;
	КонецПопытки;
	Если Не ЗначениеЗаполнено(ДокЗаявка.Организация) Тогда
		ДокЗаявка.Организация = Орг;
	КонецЕсли;
	
	ДокЗаявка.Статус = Перечисления.ФУ_СтатусыЗаявок.Создана;
	ДокЗаявка.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная;
	ДокЗаявка.Валюта = Валюта;
	ДокЗаявка.СуммаОдобрено = 0;
	ДокЗаявка.СуммаОплачено = 0;
	ДокЗаявка.СуммаВозвращено = 0;
	
	Попытка
		ДокЗаявка.ОтветственныйОплаты = ПараметрыСеанса.ТекущийПользователь;
	Исключение
	КонецПопытки;
	
	Тема = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "Тема")));
	Если Не ЗначениеЗаполнено(Тема) Тогда
		Тема = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "Заголовок")));
	КонецЕсли;
	ДокЗаявка.Тема = Тема;
	
	Назначение = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "Назначение")));
	Если Не ЗначениеЗаполнено(Назначение) Тогда
		Назначение = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "НазначениеПлатежа")));
	КонецЕсли;
	ДокЗаявка.Назначение = Назначение;
	
	ИННКонтрагента = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "КонтрагентИНН")));
	Если ЗначениеЗаполнено(ИННКонтрагента) Тогда
		ДокЗаявка.Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИННКонтрагента);
	КонецЕсли;
	
	КодСтатьи = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "СтатьяДДС")));
	Если ЗначениеЗаполнено(КодСтатьи) Тогда
		ДокЗаявка.СтатьяДвиженияДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(КодСтатьи);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДокЗаявка.СтатьяДвиженияДС) Тогда
		ИмяСтатьи = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "СтатьяДДСНаим")));
		Если ЗначениеЗаполнено(ИмяСтатьи) Тогда
			ДокЗаявка.СтатьяДвиженияДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(ИмяСтатьи, Истина);
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьСтатьюЗатратИФонд(ДокЗаявка);
	
	ДокЗаявка.Сумма = ЧислоИзЗначенияДО(ЗначениеКолонки(ТекСчет, "Сумма"));
	
	РегНомДоговор = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "РегНомДоговор")));
	Если ЗначениеЗаполнено(РегНомДоговор) И ЗначениеЗаполнено(ДокЗаявка.Контрагент) Тогда
		ДокЗаявка.Договор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(
			РегНомДоговор, Ложь, , ДокЗаявка.Контрагент);
	КонецЕсли;
	
	ДокЗаявка.НомерСчетаДО = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "КодСчета")));
	Если Не ЗначениеЗаполнено(ДокЗаявка.НомерСчетаДО) Тогда
		ДокЗаявка.НомерСчетаДО = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "РегистрационныйНомер")));
	КонецЕсли;
	ДокЗаявка.ДатаСчетаДО = ДатаИзЗначенияДО(ЗначениеКолонки(ТекСчет, "ДатаСозданияСчета"));
	
	ДокЗаявка.СверхлимитнаяЗаявка = БулевоИзЗначенияДО(ЗначениеКолонки(ТекСчет, "Сверхлимит,СверхЛимит"));
	УстановитьПризнакПлановой(ДокЗаявка, Плановая);
	
КонецПроцедуры

Процедура ЗаполнитьСтатьюЗатратИФонд(ДокЗаявка)
	
	Если Не ЗначениеЗаполнено(ДокЗаявка.СтатьяДвиженияДС) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СвязьСтатейДДСиЗатрат.СтатьяЗатрат КАК СтатьяЗатрат
		|ИЗ
		|	РегистрСведений.ФУ_СвязьСтатейДДСиЗатрат КАК СвязьСтатейДДСиЗатрат
		|ГДЕ
		|	СвязьСтатейДДСиЗатрат.СтатьяДДС = &СтатьяДДС";
		Запрос.УстановитьПараметр("СтатьяДДС", ДокЗаявка.СтатьяДвиженияДС);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДокЗаявка.СтатьяЗатрат = Выборка.СтатьяЗатрат;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Попытка
		ЗапросФонд = Новый Запрос;
		ЗапросФонд.Текст =
		"ВЫБРАТЬ
		|	ФУ_СвязиСтатейИФондов.Фонд КАК Фонд
		|ИЗ
		|	РегистрСведений.ФУ_СвязиСтатейИФондов КАК ФУ_СвязиСтатейИФондов
		|ГДЕ
		|	ФУ_СвязиСтатейИФондов.СтатьяДДС = &СтатьяДДС";
		ЗапросФонд.УстановитьПараметр("СтатьяДДС", ДокЗаявка.СтатьяДвиженияДС);
		ВыборкаФонд = ЗапросФонд.Выполнить().Выбрать();
		Если ВыборкаФонд.Количество() = 1 И ВыборкаФонд.Следующий() Тогда
			ДокЗаявка.Фонд = ВыборкаФонд.Фонд;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьСогласующихЗаявки(ДокЗаявка)
	
	ДокЗаявка.Согласующие.Очистить();
	
	Попытка
		ТЗ = ФУ_ОбщийМодульСервер.ЗаполнитьСогласующих(
			Перечисления.ФУ_ВидыДокументов.ЗаявкаНаОплату, ТекущаяДата(), ДокЗаявка.Ссылка);
		Если ТЗ <> 0 И ТЗ <> Неопределено Тогда
			ДокЗаявка.Согласующие.Загрузить(ТЗ);
			Возврат;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	ЗапросСогласующих = Новый Запрос;
	ЗапросСогласующих.Текст =
	"ВЫБРАТЬ
	|	ФУ_РегистрСогласующихСрезПоследних.Должность КАК ДолжностьСогласующего
	|ИЗ
	|	РегистрСведений.ФУ_РегистрСогласующих.СрезПоследних(&Период, ВидДокумента = &ВидДокумента) КАК ФУ_РегистрСогласующихСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФУ_РегистрСогласующихСрезПоследних.Индекс";
	ЗапросСогласующих.УстановитьПараметр("Период", ТекущаяДата());
	ЗапросСогласующих.УстановитьПараметр("ВидДокумента", Перечисления.ФУ_ВидыДокументов.ЗаявкаНаОплату);
	ВыборкаСогласующих = ЗапросСогласующих.Выполнить().Выбрать();
	Пока ВыборкаСогласующих.Следующий() Цикл
		НоваяСтрокаСогл = ДокЗаявка.Согласующие.Добавить();
		Попытка
			НоваяСтрокаСогл.ДолжностьСогласующего = Строка(ВыборкаСогласующих.ДолжностьСогласующего);
		Исключение
			НоваяСтрокаСогл.ДолжностьСогласующего = ВыборкаСогласующих.ДолжностьСогласующего;
		КонецПопытки;
		НоваяСтрокаСогл.Согласовано = Ложь;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДозаполнитьСуммыИДатыПоГрафику(ДокЗаявка)
	
	Если ДокЗаявка.ГрафикПлатежей.Количество() > 0 Тогда
		ИтогГрафика = ДокЗаявка.ГрафикПлатежей.Итог("СуммаКОплате");
		Если ИтогГрафика <> 0 Тогда
			ДокЗаявка.Сумма = ИтогГрафика;
		КонецЕсли;
		ДокЗаявка.ПланируемаяДатаОплаты = ДокЗаявка.ГрафикПлатежей[0].ДатаПлатежа;
	КонецЕсли;
	
	Даты = "";
	Для Каждого Стр Из ДокЗаявка.ГрафикПлатежей Цикл
		Если Не ЗначениеЗаполнено(Стр.ДатаПлатежа) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Даты) Тогда
			Даты = Даты + ", ";
		КонецЕсли;
		Даты = Даты + Формат(Стр.ДатаПлатежа, "ДФ=dd.MM.yyyy");
	КонецЦикла;
	Попытка
		ДокЗаявка.ПланируемаяДатаОпл = Даты;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьГрафикЗаявкиИзДО(ДокЗаявка, ТекСчет)
	
	ДокЗаявка.ГрафикПлатежей.Очистить();
	
	ГрафикИсточник = Неопределено;
	Попытка
		ГрафикИсточник = ТекСчет.ГрафикПлатежей;
	Исключение
	КонецПопытки;
	
	Если ТипЗнч(ГрафикИсточник) = Тип("Массив") Тогда
		Для Каждого СтрокаГрафика Из ГрафикИсточник Цикл
			ДобавитьСтрокуГрафикаИзДанных(ДокЗаявка, СтрокаГрафика);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ГрафикИсточник) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из ГрафикИсточник Цикл
			ДобавитьСтрокуГрафикаИзДанных(ДокЗаявка, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ДокЗаявка.ГрафикПлатежей.Количество() > 0 Тогда
		Попытка
			ДокЗаявка.ПланируемаяДатаОплаты = ДокЗаявка.ГрафикПлатежей[0].ДатаПлатежа;
		Исключение
		КонецПопытки;
		Возврат;
	КонецЕсли;
	
	ДатаСтроки = ДатаЗапланированнаяИзСчетаДО(ТекСчет);
	НоваяСтрока = ДокЗаявка.ГрафикПлатежей.Добавить();
	НоваяСтрока.ДатаПлатежа = ДатаСтроки;
	НоваяСтрока.СуммаКОплате = ДокЗаявка.Сумма;
	НоваяСтрока.Статус = Ложь;
	Попытка
		ДокЗаявка.ПланируемаяДатаОплаты = ДатаСтроки;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура ДобавитьСтрокуГрафикаИзДанных(ДокЗаявка, ДанныеСтроки)
	
	Если ТипЗнч(ДанныеСтроки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСтроки = ДатаИзЗначенияДО(ЗначениеСвойстваСтруктуры(ДанныеСтроки, "ДатаПлатежа", Неопределено));
	СуммаСтроки = ЧислоИзЗначенияДО(ЗначениеСвойстваСтруктуры(ДанныеСтроки, "Сумма", 0));
	Если Не ЗначениеЗаполнено(ДатаСтроки) И СуммаСтроки = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаСтроки) Тогда
		ДатаСтроки = ТекущаяДата();
	КонецЕсли;
	
	НоваяСтрока = ДокЗаявка.ГрафикПлатежей.Добавить();
	НоваяСтрока.ДатаПлатежа = ДатаСтроки;
	НоваяСтрока.СуммаКОплате = СуммаСтроки;
	НоваяСтрока.Статус = Ложь;
	
КонецПроцедуры

Функция ДатаЗапланированнаяИзСчетаДО(ТекСчет)
	
	Для Каждого ИмяПоля Из СтрРазделить("ЗапланированнаяДата,ДатаОплаты,Срок,ДатаРегистрации,ДатаСозданияСчета", ",", Ложь) Цикл
		Попытка
			ДатаЗначение = ДатаИзЗначенияДО(ТекСчет[ИмяПоля]);
			Если ЗначениеЗаполнено(ДатаЗначение) Тогда
				Возврат ДатаЗначение;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат ТекущаяДата();
	
КонецФункции

Функция ЭтоПлановаяЗаявкаДО(ТекСчет)
	
	Попытка
		Если БулевоИзЗначенияДО(ТекСчет.ПлановаяЗаявка) Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Попытка
		ВидДокумента = ВРег(СокрЛП(Строка(ТекСчет.ВидДокумента)));
		Если ВидДокумента = "ПЛАНОВАЯЗАЯВКА" Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

Функция ПроверитьПлановуюДляСчета(ТекСчет)
	
	Результат = Новый Структура("Можно, АвтоСогласовать, Сообщение, СуммаПлановой, КодПлановой, СсылкаПлановой",
		Истина, Ложь, "", 0, "", Неопределено);
	
	КодПлановой = СокрЛП(Строка(ЗначениеКолонки(ТекСчет, "КодПлановойЗаявки")));
	СуммаИзJSON = ЧислоИзЗначенияДО(ЗначениеКолонки(ТекСчет, "СуммаПлановойЗаявки"));
	Если Не ЗначениеЗаполнено(КодПлановой) И СуммаИзJSON <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.КодПлановой = КодПлановой;
	ПлановаяСсылка = НайтиПлановуюЗаявкуБП(КодПлановой);
	Результат.СсылкаПлановой = ПлановаяСсылка;
	
	СуммаПлановой = 0;
	ПлановаяСогласована = Ложь;
	Если ЗначениеЗаполнено(ПлановаяСсылка) Тогда
		СуммаПлановой = ПлановаяСсылка.Сумма;
		ПлановаяСогласована = ЗаявкаСогласованаВБП(ПлановаяСсылка);
		Если Не ПлановаяСогласована Тогда
			Результат.Можно = Ложь;
			Результат.Сообщение = "Нельзя создать счёт на оплату: плановая заявка " + КодПлановой + " ещё не согласована.";
			Возврат Результат;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(КодПлановой) И СуммаИзJSON <= 0 Тогда
		ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Плановая заявка по коду [" + КодПлановой + "] в БП не найдена, правило 5% по JSON.");
	КонецЕсли;
	
	Если СуммаПлановой <= 0 Тогда
		СуммаПлановой = СуммаИзJSON;
	КонецЕсли;
	Результат.СуммаПлановой = СуммаПлановой;
	
	Если СуммаПлановой <= 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	СуммаСчета = ЧислоИзЗначенияДО(ЗначениеКолонки(ТекСчет, "Сумма"));
	СуммаУже = СуммаСчетовПоПлановой(ПлановаяСсылка, КодПлановой);
	Потолок = Окр(СуммаПлановой * 1.05, 2);
	ИтогоСЭтим = Окр(СуммаУже + СуммаСчета, 2);
	
	ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Информация, , ПлановаяСсылка,
		"Правило 5%: плановая=[" + КодПлановой + "] суммаПлановой=" + Формат(СуммаПлановой, "ЧГ=")
		+ " потолок=" + Формат(Потолок, "ЧГ=")
		+ " ужеСчетов=" + Формат(СуммаУже, "ЧГ=")
		+ " этотСчёт=" + Формат(СуммаСчета, "ЧГ=")
		+ " итого=" + Формат(ИтогоСЭтим, "ЧГ="));
	
	Если ИтогоСЭтим <= Потолок Тогда
		Результат.АвтоСогласовать = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиПлановуюЗаявкуБП(КодПлановой)
	
	Если Не ЗначениеЗаполнено(КодПлановой) Тогда
		Возврат Документы.ФУ_ЗаявкаНаОплату.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		Найденная = Документы.ФУ_ЗаявкаНаОплату.НайтиПоРеквизиту("НомерСчетаДО", КодПлановой);
		Если ЗначениеЗаполнено(Найденная) Тогда
			Возврат Найденная;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ФУ_ЗаявкаНаОплату.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ФУ_ЗаявкаНаОплату КАК ФУ_ЗаявкаНаОплату
		|ГДЕ
		|	НЕ ФУ_ЗаявкаНаОплату.ПометкаУдаления
		|	И ФУ_ЗаявкаНаОплату.НомерСчетаДО = &Код";
		Запрос.УстановитьПараметр("Код", КодПлановой);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Документы.ФУ_ЗаявкаНаОплату.ПустаяСсылка();
	
КонецФункции

Процедура СвязатьСчетСПлановой(ДокЗаявка, ПроверкаПлановой)
	
	Если ПроверкаПлановой = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПроверкаПлановой.СсылкаПлановой) Тогда
		Попытка
			ДокЗаявка.СсылкаНаПлановуюЗаявку = ПроверкаПлановой.СсылкаПлановой;
		Исключение
			ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Предупреждение, , ,
				"Не удалось записать СсылкаНаПлановуюЗаявку: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Попытка
			ДокЗаявка.ДокументОснование = ПроверкаПлановой.СсылкаПлановой;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПроверкаПлановой.КодПлановой) Тогда
		Попытка
			ДокЗаявка.КодПлановойЗаявки = ПроверкаПлановой.КодПлановой;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция СуммаСчетовПоПлановой(ПлановаяСсылка, КодПлановой)
	
	Если Не ЗначениеЗаполнено(ПлановаяСсылка) И Не ЗначениеЗаполнено(КодПлановой) Тогда
		Возврат 0;
	КонецЕсли;
	
	СтатусОтклонена = СтатусПеречисленияЗаявки("Отклонена");
	Сумма = 0;
	
	Если ЗначениеЗаполнено(ПлановаяСсылка) Тогда
		Сумма = СуммаСчетовПоСсылкеПлановой(ПлановаяСсылка, СтатусОтклонена);
	КонецЕсли;
	
	Если Сумма > 0 Или Не ЗначениеЗаполнено(КодПлановой) Тогда
		Возврат Сумма;
	КонецЕсли;
	
	Попытка
		ЗапросКод = Новый Запрос;
		ЗапросКод.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ФУ_ЗаявкаНаОплату.Сумма), 0) КАК Сумма
		|ИЗ
		|	Документ.ФУ_ЗаявкаНаОплату КАК ФУ_ЗаявкаНаОплату
		|ГДЕ
		|	НЕ ФУ_ЗаявкаНаОплату.ПометкаУдаления
		|	И ФУ_ЗаявкаНаОплату.ПлановаяЗаявка = ЛОЖЬ
		|	И ФУ_ЗаявкаНаОплату.КодПлановойЗаявки = &Код
		|	И (&ОтклоненаНеЗадана
		|		ИЛИ ФУ_ЗаявкаНаОплату.Статус <> &Отклонена)";
		ЗапросКод.УстановитьПараметр("Код", КодПлановой);
		ЗапросКод.УстановитьПараметр("Отклонена", СтатусОтклонена);
		ЗапросКод.УстановитьПараметр("ОтклоненаНеЗадана", Не ЗначениеЗаполнено(СтатусОтклонена));
		ВыборкаКод = ЗапросКод.Выполнить().Выбрать();
		Если ВыборкаКод.Следующий() Тогда
			Возврат ЧислоИзЗначенияДО(ВыборкаКод.Сумма);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Сумма;
	
КонецФункции

Функция СуммаСчетовПоСсылкеПлановой(ПлановаяСсылка, СтатусОтклонена)
	
	КонтрагентПлановой = ПлановаяСсылка.Контрагент;
	СтатьяПлановой = ПлановаяСсылка.СтатьяДвиженияДС;
	ДатаПлановой = ПлановаяСсылка.Дата;
	ЕстьКонтрагентИСтатья = ЗначениеЗаполнено(КонтрагентПлановой) И ЗначениеЗаполнено(СтатьяПлановой);
	
	ТекстыЗапроса = Новый Массив;
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ФУ_ЗаявкаНаОплату.Сумма), 0) КАК Сумма
	|ИЗ
	|	Документ.ФУ_ЗаявкаНаОплату КАК ФУ_ЗаявкаНаОплату
	|ГДЕ
	|	НЕ ФУ_ЗаявкаНаОплату.ПометкаУдаления
	|	И ФУ_ЗаявкаНаОплату.Ссылка <> &Плановая
	|	И ФУ_ЗаявкаНаОплату.ПлановаяЗаявка = ЛОЖЬ
	|	И (&ОтклоненаНеЗадана
	|		ИЛИ ФУ_ЗаявкаНаОплату.Статус <> &Отклонена)
	|	И (ФУ_ЗаявкаНаОплату.СсылкаНаПлановуюЗаявку = &Плановая
	|		ИЛИ ФУ_ЗаявкаНаОплату.ДокументОснование = &Плановая
	|		ИЛИ (&ЕстьКонтрагентИСтатья
	|			И ФУ_ЗаявкаНаОплату.СсылкаНаПлановуюЗаявку = ЗНАЧЕНИЕ(Документ.ФУ_ЗаявкаНаОплату.ПустаяСсылка)
	|			И ФУ_ЗаявкаНаОплату.ДокументОснование = ЗНАЧЕНИЕ(Документ.ФУ_ЗаявкаНаОплату.ПустаяСсылка)
	|			И ФУ_ЗаявкаНаОплату.Контрагент = &Контрагент
	|			И ФУ_ЗаявкаНаОплату.СтатьяДвиженияДС = &Статья
	|			И ФУ_ЗаявкаНаОплату.Дата >= &ДатаПлановой))");
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ФУ_ЗаявкаНаОплату.Сумма), 0) КАК Сумма
	|ИЗ
	|	Документ.ФУ_ЗаявкаНаОплату КАК ФУ_ЗаявкаНаОплату
	|ГДЕ
	|	НЕ ФУ_ЗаявкаНаОплату.ПометкаУдаления
	|	И ФУ_ЗаявкаНаОплату.Ссылка <> &Плановая
	|	И ФУ_ЗаявкаНаОплату.ПлановаяЗаявка = ЛОЖЬ
	|	И (&ОтклоненаНеЗадана
	|		ИЛИ ФУ_ЗаявкаНаОплату.Статус <> &Отклонена)
	|	И (ФУ_ЗаявкаНаОплату.СсылкаНаПлановуюЗаявку = &Плановая
	|		ИЛИ (&ЕстьКонтрагентИСтатья
	|			И ФУ_ЗаявкаНаОплату.СсылкаНаПлановуюЗаявку = ЗНАЧЕНИЕ(Документ.ФУ_ЗаявкаНаОплату.ПустаяСсылка)
	|			И ФУ_ЗаявкаНаОплату.Контрагент = &Контрагент
	|			И ФУ_ЗаявкаНаОплату.СтатьяДвиженияДС = &Статья
	|			И ФУ_ЗаявкаНаОплату.Дата >= &ДатаПлановой))");
	ТекстыЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ФУ_ЗаявкаНаОплату.Сумма), 0) КАК Сумма
	|ИЗ
	|	Документ.ФУ_ЗаявкаНаОплату КАК ФУ_ЗаявкаНаОплату
	|ГДЕ
	|	НЕ ФУ_ЗаявкаНаОплату.ПометкаУдаления
	|	И ФУ_ЗаявкаНаОплату.Ссылка <> &Плановая
	|	И ФУ_ЗаявкаНаОплату.ПлановаяЗаявка = ЛОЖЬ
	|	И (&ОтклоненаНеЗадана
	|		ИЛИ ФУ_ЗаявкаНаОплату.Статус <> &Отклонена)
	|	И (ФУ_ЗаявкаНаОплату.ДокументОснование = &Плановая
	|		ИЛИ (&ЕстьКонтрагентИСтатья
	|			И ФУ_ЗаявкаНаОплату.ДокументОснование = ЗНАЧЕНИЕ(Документ.ФУ_ЗаявкаНаОплату.ПустаяСсылка)
	|			И ФУ_ЗаявкаНаОплату.Контрагент = &Контрагент
	|			И ФУ_ЗаявкаНаОплату.СтатьяДвиженияДС = &Статья
	|			И ФУ_ЗаявкаНаОплату.Дата >= &ДатаПлановой))");
	
	Для Каждого ТекстЗапроса Из ТекстыЗапроса Цикл
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("Плановая", ПлановаяСсылка);
			Запрос.УстановитьПараметр("Отклонена", СтатусОтклонена);
			Запрос.УстановитьПараметр("ОтклоненаНеЗадана", Не ЗначениеЗаполнено(СтатусОтклонена));
			Запрос.УстановитьПараметр("Контрагент", КонтрагентПлановой);
			Запрос.УстановитьПараметр("Статья", СтатьяПлановой);
			Запрос.УстановитьПараметр("ДатаПлановой", ДатаПлановой);
			Запрос.УстановитьПараметр("ЕстьКонтрагентИСтатья", ЕстьКонтрагентИСтатья);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат ЧислоИзЗначенияДО(Выборка.Сумма);
			КонецЕсли;
			Возврат 0;
		Исключение
			ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Предупреждение, , ПлановаяСсылка,
				"СуммаСчетовПоПлановой: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

Функция ЗаявкаСогласованаВБП(ЗаявкаСсылка)
	
	Если Не ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Статус = Неопределено;
	Попытка
		Статус = ЗаявкаСсылка.Статус;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Имя = ВРег(СокрЛП(Строка(Статус)));
	Если СтрНайти(Имя, "ОДОБР") > 0 Или СтрНайти(Имя, "СОГЛАСОВ") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ИмяСтатуса Из СтрРазделить("Одобрена,Одобрен,Согласована,Согласован", ",", Ложь) Цикл
		ЗначениеСтатуса = СтатусПеречисленияЗаявки(ИмяСтатуса);
		Если ЗначениеЗаполнено(ЗначениеСтатуса) И Статус = ЗначениеСтатуса Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СтатусПеречисленияЗаявки(ИмяСтатуса)
	
	Попытка
		Возврат Перечисления.ФУ_СтатусыЗаявок[ИмяСтатуса];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура ПрикрепитьФайлыИзДО(ДокЗаявка, ТекСчет)
	
	ИсточникФайлов = Неопределено;
	Попытка
		ИсточникФайлов = ТекСчет.СопутствующиеФайлы;
	Исключение
		ИсточникФайлов = Неопределено;
	КонецПопытки;
	
	ОписанияФайлов = Новый Массив;
	Если ТипЗнч(ИсточникФайлов) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из ИсточникФайлов Цикл
			ОписанияФайлов.Добавить(КлючИЗначение.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ИсточникФайлов) = Тип("Массив") Тогда
		ОписанияФайлов = ИсточникФайлов;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Информация, , ДокЗаявка.Ссылка,
		"Файлов из ДО=" + ОписанияФайлов.Количество());
	
	Номер = 0;
	Для Каждого ОписаниеФайла Из ОписанияФайлов Цикл
		Если ТипЗнч(ОписаниеФайла) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ИмяБезРасширения = СокрЛП(Строка(ЗначениеСвойстваСтруктуры(ОписаниеФайла, "ИмяФайлаКлиентаБезРасширения", "")));
			Если Не ЗначениеЗаполнено(ИмяБезРасширения) Тогда
				ИмяБезРасширения = СокрЛП(Строка(ЗначениеСвойстваСтруктуры(ОписаниеФайла, "ИмяФайла", "Файл")));
			КонецЕсли;
			Расширение = СокрЛП(Строка(ЗначениеСвойстваСтруктуры(ОписаниеФайла, "РасширениеФайлаКлиента", "")));
			Если Не ЗначениеЗаполнено(Расширение) Тогда
				Расширение = СокрЛП(Строка(ЗначениеСвойстваСтруктуры(ОписаниеФайла, "Расширение", "")));
			КонецЕсли;
			Расширение = СтрЗаменить(Расширение, ".", "");
			СтрокаДанных = ЗначениеСвойстваСтруктуры(ОписаниеФайла, "ДвоичныеДанные", Неопределено);
			Если Не ЗначениеЗаполнено(СтрокаДанных) Тогда
				СтрокаДанных = ЗначениеСвойстваСтруктуры(ОписаниеФайла, "Данные", Неопределено);
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаДанных) Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
			ПараметрыФайла.ВладелецФайлов = ДокЗаявка.Ссылка;
			ПараметрыФайла.ИмяБезРасширения = ИмяБезРасширения;
			ПараметрыФайла.РасширениеБезТочки = Расширение;
			ДвоичДанныеФайла = Base64Значение(СтрокаДанных);
			АдресВХ = ПоместитьВоВременноеХранилище(ДвоичДанныеФайла);
			РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресВХ);
			Номер = Номер + 1;
		Исключение
			ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Ошибка, , ДокЗаявка.Ссылка,
				"Файл: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Информация, , ДокЗаявка.Ссылка,
		"Файлов записано=" + Номер);
	
КонецПроцедуры

Процедура ПометитьАвтоодобрение(ДокЗаявка)
	
	Попытка
		ДокЗаявка.ДополнительныеСвойства.Вставить("ак_АвтоодобрениеИзДО", Истина);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Процедура ПодготовитьАвтоодобрениеДоЗаписи(ДокЗаявка)
	
	ОтметитьГрафикИСогласующих(ДокЗаявка);
	
	СтатусОдобрен = Неопределено;
	Для Каждого ИмяСтатуса Из СтрРазделить("Одобрена,Одобрен,Согласована,Согласован", ",", Ложь) Цикл
		СтатусОдобрен = СтатусПеречисленияЗаявки(ИмяСтатуса);
		Если ЗначениеЗаполнено(СтатусОдобрен) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(СтатусОдобрен) Тогда
		ДокЗаявка.Статус = СтатусОдобрен;
	Иначе
		Попытка
			ДокЗаявка.Статус = Перечисления.ФУ_СтатусыЗаявок.Одобрена;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	СуммаПоГрафику = СуммаГрафикаЗаявки(ДокЗаявка);
	ДокЗаявка.СуммаОдобрено = СуммаПоГрафику;
	Попытка
		Если Не ЗначениеЗаполнено(ДокЗаявка.ДатаОдобрения) Тогда
			ДокЗаявка.ДатаОдобрения = ТекущаяДата();
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция СуммаГрафикаЗаявки(ДокЗаявка)
	
	СуммаПоГрафику = 0;
	Попытка
		СуммаПоГрафику = ДокЗаявка.ГрафикПлатежей.Итог("СуммаКОплате");
	Исключение
		СуммаПоГрафику = 0;
	КонецПопытки;
	Если СуммаПоГрафику = 0 Тогда
		Попытка
			СуммаПоГрафику = ДокЗаявка.Сумма;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат СуммаПоГрафику;
	
КонецФункции

Процедура ОтметитьГрафикИСогласующих(ДокЗаявка)
	
	ИменаГрафика = ИменаПризнаковСогласованияТЧ("ГрафикПлатежей");
	Для Каждого СтрокаГрафика Из ДокЗаявка.ГрафикПлатежей Цикл
		Для Каждого ИмяРеквизита Из ИменаГрафика Цикл
			УстановитьПризнакСтрокиГрафика(СтрокаГрафика, ИмяРеквизита, Истина);
		КонецЦикла;
	КонецЦикла;
	
	ИменаСогл = ИменаПризнаковСогласованияТЧ("Согласующие");
	Для Каждого СтрокаСогл Из ДокЗаявка.Согласующие Цикл
		Для Каждого ИмяРеквизита Из ИменаСогл Цикл
			УстановитьПризнакСтрокиГрафика(СтрокаСогл, ИмяРеквизита, Истина);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ИменаПризнаковСогласованияТЧ(ИмяТЧ)
	
	Имена = Новый Массив;
	Имена.Добавить("Статус");
	Имена.Добавить("Согласовано");
	Имена.Добавить("Одобрено");
	Имена.Добавить("Согласован");
	
	Попытка
		ТЧ = Метаданные.Документы.ФУ_ЗаявкаНаОплату.ТабличныеЧасти[ИмяТЧ];
		Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
			Имя = ВРег(Реквизит.Имя);
			ЭтоПризнак = СтрНайти(Имя, "СТАТУС") > 0
				Или СтрНайти(Имя, "СОГЛАС") > 0
				Или СтрНайти(Имя, "ОДОБР") > 0;
			Если Не ЭтоПризнак Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(Имя, "ОПЛАЧ") > 0 Или СтрНайти(Имя, "ОТКЛОН") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Имена.Найти(Реквизит.Имя) = Неопределено Тогда
				Имена.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат Имена;
	
КонецФункции

Процедура УстановитьПризнакСтрокиГрафика(СтрокаТаблицы, ИмяРеквизита, ЗначениеПризнака)
	
	Попытка
		СтрокаТаблицы[ИмяРеквизита] = ЗначениеПризнака;
		Возврат;
	Исключение
	КонецПопытки;
	
	Попытка
		ЗначениеПеречисления = ЗначениеПеречисленияСогласовано(ИмяРеквизита);
		Если ЗначениеПеречисления <> Неопределено Тогда
			СтрокаТаблицы[ИмяРеквизита] = ЗначениеПеречисления;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция ЗначениеПеречисленияСогласовано(ИмяРеквизита)
	
	Попытка
		Реквизит = Метаданные.Документы.ФУ_ЗаявкаНаОплату.ТабличныеЧасти.ГрафикПлатежей.Реквизиты[ИмяРеквизита];
		Для Каждого ТипРеквизита Из Реквизит.Тип.Типы() Цикл
			МетаПеречисления = Метаданные.НайтиПоТипу(ТипРеквизита);
			Если МетаПеречисления = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ЗначениеМета Из МетаПеречисления.ЗначенияПеречисления Цикл
				Имя = ВРег(ЗначениеМета.Имя);
				Если СтрНайти(Имя, "СОГЛАС") > 0 Или СтрНайти(Имя, "ОДОБР") > 0 Или Имя = "ДА" Тогда
					Возврат Перечисления[МетаПеречисления.Имя][ЗначениеМета.Имя];
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Процедура АвтосогласоватьЗаявкуПоПлановой(ДокЗаявка, ПроверкаПлановой)
	
	НомерДляДО = "";
	Попытка
		НомерДляДО = СокрЛП(Строка(ДокЗаявка.НомерСчетаДО));
	Исключение
	КонецПопытки;
	
	Попытка
		ДокЗаявка = ДокЗаявка.Ссылка.ПолучитьОбъект();
	Исключение
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ДокЗаявка.НомерСчетаДО) И ЗначениеЗаполнено(НомерДляДО) Тогда
		ДокЗаявка.НомерСчетаДО = НомерДляДО;
	КонецЕсли;
	
	ПометитьАвтоодобрение(ДокЗаявка);
	ПодготовитьАвтоодобрениеДоЗаписи(ДокЗаявка);
	
	ДокЗаявка.Записать(РежимЗаписиДокумента.Запись);
	
	ЗафиксироватьОдобрениеБезТиповыхОбработчиков(ДокЗаявка.Ссылка);
	ЗафиксироватьОдобрениеБезТиповыхОбработчиков(ДокЗаявка.Ссылка);
	
	ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Информация, , ДокЗаявка.Ссылка,
		"Автосогласование счёта: сумма " + Формат(ДокЗаявка.Сумма, "ЧГ=")
		+ " в пределах суммы всех счетов по плановой * 1,05"
		+ " плановая=[" + ПроверкаПлановой.КодПлановой + "]"
		+ " суммаПлановой=" + Формат(ПроверкаПлановой.СуммаПлановой, "ЧГ="));
	
	ОтправитьАвтостатусВДО(ДокЗаявка);
	
КонецПроцедуры

Процедура ЗафиксироватьОдобрениеБезТиповыхОбработчиков(ЗаявкаСсылка)
	
	Если Не ЗначениеЗаполнено(ЗаявкаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ДокЗаявка = ЗаявкаСсылка.ПолучитьОбъект();
		ПометитьАвтоодобрение(ДокЗаявка);
		ОтметитьГрафикИСогласующих(ДокЗаявка);
		Для Каждого СтрокаГрафика Из ДокЗаявка.ГрафикПлатежей Цикл
			Попытка
				СтрокаГрафика.Статус = Истина;
			Исключение
			КонецПопытки;
			Попытка
				СтрокаГрафика["Статус"] = Истина;
			Исключение
			КонецПопытки;
		КонецЦикла;
		СуммаПоГрафику = СуммаГрафикаЗаявки(ДокЗаявка);
		ДокЗаявка.СуммаОдобрено = СуммаПоГрафику;
		ДокЗаявка.ДополнительныеСвойства.Вставить("ак_ФиксацияГрафика", Истина);
		ДокЗаявка.ОбменДанными.Загрузка = Истина;
		ДокЗаявка.Записать(РежимЗаписиДокумента.Запись);
		
		Проверка = ЗаявкаСсылка.ПолучитьОбъект();
		ТекстСтрок = "";
		Для Каждого СтрокаГрафика Из Проверка.ГрафикПлатежей Цикл
			ЗначениеСтатуса = Неопределено;
			Попытка
				ЗначениеСтатуса = СтрокаГрафика["Статус"];
			Исключение
			КонецПопытки;
			ТекстСтрок = ТекстСтрок + " стр=" + СтрокаГрафика.НомерСтроки
				+ " Статус=[" + Строка(ЗначениеСтатуса) + "]";
		КонецЦикла;
		ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Информация, , ЗаявкаСсылка,
			"Зафиксировано одобрение графика. СуммаОдобрено=" + Формат(СуммаПоГрафику, "ЧГ=")
			+ ТекстСтрок);
	Исключение
		ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Предупреждение, , ЗаявкаСсылка,
			"Не удалось зафиксировать график: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтправитьАвтостатусВДО(ДокЗаявка)
	
	НомерСчета = "";
	Попытка
		НомерСчета = СокрЛП(Строка(ДокЗаявка.НомерСчетаДО));
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Предупреждение, , ДокЗаявка.Ссылка,
			"Автостатус в ДО не отправлен: пустой НомерСчетаДО");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("Статус", Истина);
	СтруктураОтправки.Вставить("КодСчета", НомерСчета);
	СтруктураОтправки.Вставить("АвтоСогласование", Истина);
	СтруктураОтправки.Вставить("Автосогласование", Истина);
	СтруктураОтправки.Вставить("Согласован", Истина);
	Если ДокЗаявка.ГрафикПлатежей.Количество() > 0 Тогда
		СтруктураОтправки.Вставить("ДатаПлатежа", Формат(ДокЗаявка.ГрафикПлатежей[0].ДатаПлатежа, "ДФ=yyyyMMdd"));
	КонецЕсли;
	
	Массив = Новый Массив;
	Массив.Добавить(СтруктураОтправки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Информация, , ДокЗаявка.Ссылка,
		"Автостатус JSON=" + СтрокаJSON);
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение(
			"1c.sah18.ru", 59795, "Администратор", "12345678", , , Новый ЗащищенноеСоединениеOpenSSL);
		ЗапросPOST = Новый HTTPЗапрос("/doc_akea/hs/FromBuhStatus/DownloadStatus");
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Информация, , ДокЗаявка.Ссылка,
			"Автостатус в ДО HTTP=" + Результат.КодСостояния + " тело=" + Лев(Результат.ПолучитьТелоКакСтроку("UTF-8"), 500));
	Исключение
		ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Предупреждение, , ДокЗаявка.Ссылка,
			"Не удалось отправить автостатус в ДО: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьПризнакПлановой(ДокЗаявка, Плановая)
	
	Попытка
		ДокЗаявка.ПлановаяЗаявка = Плановая;
		Возврат;
	Исключение
	КонецПопытки;
	
	Попытка
		ДокЗаявка.Плановая = Плановая;
	Исключение
		ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Нет реквизита ПлановаяЗаявка/Плановая на ФУ_ЗаявкаНаОплату. Добавьте булево «ПлановаяЗаявка».");
	КонецПопытки;
	
КонецПроцедуры

Функция ОтветJSONDownload(Успех, Сообщение)
	
	Данные = Новый Структура;
	Данные.Вставить("success", Успех);
	Данные.Вставить("message", Сообщение);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
КонецФункции

Функция ПреобразованиеМассивВТаблицуЗначений(Массив)
	
	ТЗ = Новый ТаблицаЗначений;
	
	Для Каждого СтрокаМассива Из Массив Цикл
		Если ТЗ.Колонки.Количество() = 0 Тогда
			Для Каждого ЭлементМассива Из СтрокаМассива Цикл
				ТЗ.Колонки.Добавить(ЭлементМассива.Ключ);
			КонецЦикла;
		КонецЕсли;
		НоваяСтрока = ТЗ.Добавить();
		Для Каждого ЭлементМассива Из СтрокаМассива Цикл
			НоваяСтрока[ЭлементМассива.Ключ] = ЭлементМассива.Значение;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции

Функция ЗначениеКолонки(СтрокаТЗ, ИменаЧерезЗапятую)
	
	Для Каждого Имя Из СтрРазделить(ИменаЧерезЗапятую, ",", Ложь) Цикл
		Попытка
			Возврат СтрокаТЗ[СокрЛП(Имя)];
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗначениеСвойстваСтруктуры(Данные, Имя, ЗначениеПоУмолчанию)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция БулевоИзЗначенияДО(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	СтрокаЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "ИСТИНА" Или СтрокаЗначения = "TRUE" Или СтрокаЗначения = "1" Или СтрокаЗначения = "ДА";
	
КонецФункции

Функция ЧислоИзЗначенияДО(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), ",", "."));
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

Функция ДатаИзЗначенияДО(Значение)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат НачалоДня(Значение);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	СтрокаДаты = СокрЛП(Строка(Значение));
	Если СтрДлина(СтрокаДаты) = 8 Тогда
		Попытка
			Возврат Дата(СтрокаДаты);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		Возврат НачалоДня(СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаДаты));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции
