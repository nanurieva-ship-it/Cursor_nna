Функция СуммаПоГрафику(График)
	
	Если График = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Итог = 0;
	Для Каждого КлючИЗначение Из График Цикл
		СтрокаГрафика = КлючИЗначение.Значение;
		Итог = Итог + ЧислоИзСтроки(ЗначениеСвойства(СтрокаГрафика, "Сумма", 0));
	КонецЦикла;
	
	Возврат Итог;
	
КонецФункции

#КонецОбласти

#Область СозданиеЗаявки

Функция СоздатьЗаявкуПоЗапросу(ДанныеЗапроса)
	
	ДокументДанные = ПервыйЭлементЗапроса(ДанныеЗапроса);
	
	Плановая = БулевоИзЗначения(ЗначениеСвойства(ДокументДанные, "ПлановаяЗаявка", Ложь));
	Если Не Плановая Тогда
		ВидДокумента = ВРег(СокрЛП(Строка(ЗначениеСвойства(ДокументДанные, "ВидДокумента", ""))));
		Плановая = (ВидДокумента = "ПЛАНОВАЯЗАЯВКА");
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации("ImportFromDO", УровеньЖурналаРегистрации.Информация, , ,
		"Download: рег.номер=" + Строка(ЗначениеСвойства(ДокументДанные, "РегистрационныйНомер", ""))
		+ " сумма=" + Строка(ЗначениеСвойства(ДокументДанные, "Сумма", 0))
		+ " статья=" + Строка(ЗначениеСвойства(ДокументДанные, "СтатьяДДС", ""))
		+ " ПлановаяЗаявка=" + (Плановая)
		+ " СверхЛимит=" + (БулевоИзЗначения(ЗначениеСвойства(ДокументДанные, "СверхЛимит", Ложь)))
		+ " НазначениеПлатежа=" + Лев(Строка(ЗначениеСвойства(ДокументДанные, "НазначениеПлатежа", "")), 200));
	
	// Подставьте создание документа заявки на оплату.
	// Обязательно: ПлановаяЗаявка = Плановая, НазначениеПлатежа, СверхЛимит.
	// Номер созданного документа верните в documentNumber.
	
	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("overLimit", Ложь);
	Ответ.Вставить("message", ?(Плановая, "Плановая заявка создана", "Заявка создана"));
	Ответ.Вставить("documentNumber", Строка(ЗначениеСвойства(ДокументДанные, "РегистрационныйНомер", "")));
	Ответ.Вставить("planned", Плановая);
	Ответ.Вставить("limits", Новый Массив);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область РазборЗапроса

Функция ПервыйЭлементЗапроса(ДанныеЗапроса)
	
	Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
		Если ДанныеЗапроса.Количество() = 0 Тогда
			ВызватьИсключение "Пустой массив в теле запроса";
		КонецЕсли;
		Возврат ДанныеЗапроса[0];
	КонецЕсли;
	
	Возврат ДанныеЗапроса;
	
КонецФункции

Функция ЗначениеСвойства(Данные, Имя, ЗначениеПоУмолчанию)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция БулевоИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	
	СтрокаЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "ИСТИНА"
		Или СтрокаЗначения = "TRUE"
		Или СтрокаЗначения = "1"
		Или СтрокаЗначения = "ДА";
	
КонецФункции

Функция ЧислоИзСтроки(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	
	СтрокаЧисла = СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), Символы.НПП, "");
	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, ",", ".");
	
	Попытка
		Возврат Число(СтрокаЧисла);
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

#КонецОбласти
