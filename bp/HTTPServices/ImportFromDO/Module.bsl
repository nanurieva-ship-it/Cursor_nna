// Модуль HTTP-сервиса ImportFromDO (Бухгалтерия предприятия).
// Шаблоны URL:
//   CheckLimits  POST  — лимиты графика платежей по статьям
//   Download     POST  — создание заявки на оплату
//
// Ответ всегда HTTP 200 + JSON в теле (success=true/false).
// HTTP 500 не отдаём: ДО читает тело, а 500 часто приходит пустым.

#Область ОбработчикиHTTPСервиса

Функция CheckLimits(Запрос)
	
	Возврат ВыполнитьМетодСервиса(Запрос, "CheckLimits");
	
КонецФункции

Функция Download(Запрос)
	
	Возврат ВыполнитьМетодСервиса(Запрос, "Download");
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьМетодСервиса(Запрос, ИмяМетода)
	
	Попытка
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();
		ДанныеЗапроса = ПрочитатьJSONВЗначение(ТелоЗапроса);
		
		Если ИмяМетода = "CheckLimits" Тогда
			ДанныеОтвета = ПроверитьЛимитыПоЗапросу(ДанныеЗапроса);
		Иначе
			ДанныеОтвета = СоздатьЗаявкуПоЗапросу(ДанныеЗапроса);
		КонецЕсли;
		
		Возврат HTTPОтветJSON(200, ДанныеОтвета);
		
	Исключение
		
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			"ImportFromDO",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(Инфо));
		
		Ошибка = Новый Структура;
		Ошибка.Вставить("success", Ложь);
		Ошибка.Вставить("overLimit", Ложь);
		Ошибка.Вставить("message", КраткоеПредставлениеОшибки(Инфо));
		Ошибка.Вставить("limits", Новый Массив);
		
		Возврат HTTPОтветJSON(200, Ошибка);
		
	КонецПопытки;
	
КонецФункции

// Формирует HTTPСервисОтвет с JSON в теле.
// Без УстановитьТелоИзСтроки клиент получает только код 200/500 и пустую строку.
Функция HTTPОтветJSON(КодСостояния, Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

Функция ПрочитатьJSONВЗначение(СтрокаJSON)
	
	Если Не ЗначениеЗаполнено(СтрокаJSON) Тогда
		ВызватьИсключение "Пустое тело запроса";
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции

#КонецОбласти

#Область ПроверкаЛимитов

// Ожидаемый JSON от ДО (массив из одного объекта, как в ВыгрузитьСчетВБП):
// [
//   {
//     "СтатьяДДС": "00-000012",
//     "Сумма": "25000.00",
//     "ГрафикПлатежей": {
//       "Стр1": {"ДатаПлатежа": "23.09.2026", "Сумма": 15000, "Согласовано": false}
//     }
//   }
// ]
Функция ПроверитьЛимитыПоЗапросу(ДанныеЗапроса)
	
	ДокументДанные = ПервыйЭлементЗапроса(ДанныеЗапроса);
	
	КодСтатьи = ЗначениеСвойства(ДокументДанные, "СтатьяДДС", "");
	СуммаДокумента = ЧислоИзСтроки(ЗначениеСвойства(ДокументДанные, "Сумма", 0));
	График = ЗначениеСвойства(ДокументДанные, "ГрафикПлатежей", Неопределено);
	
	СуммаКПроверке = СуммаПоГрафику(График);
	Если СуммаКПроверке = 0 Тогда
		СуммаКПроверке = СуммаДокумента;
	КонецЕсли;
	
	СтрокаЛимита = РассчитатьЛимитПоСтатье(КодСтатьи, СуммаКПроверке);
	
	МассивЛимитов = Новый Массив;
	МассивЛимитов.Добавить(СтрокаЛимита);
	
	Ответ = Новый Структура;
	Ответ.Вставить("success", Истина);
	Ответ.Вставить("overLimit", СтрокаЛимита.overLimit);
	Ответ.Вставить("message", ?(СтрокаЛимита.overLimit,
		СтрШаблон("Превышен лимит по статье %1: заявка %2, остаток %3",
			СтрокаЛимита.articleName,
			Формат(СтрокаЛимита.requestAmount, "ЧДЦ=2; ЧГ="),
			Формат(СтрокаЛимита.remainder, "ЧДЦ=2; ЧГ=")),
		""));
	Ответ.Вставить("limits", МассивЛимитов);
	
	Возврат Ответ;
	
КонецФункции

// Подставьте свой расчёт: регистр лимитов / график платежей БП.
// Сейчас — каркас: статья по коду, лимит и расход — заглушки под ваш запрос.
Функция РассчитатьЛимитПоСтатье(КодСтатьи, СуммаЗаявки)
	
	Статья = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(КодСтатьи);
	Если Не ЗначениеЗаполнено(Статья) Тогда
		ВызватьИсключение СтрШаблон("Не найдена статья ДДС с кодом %1", КодСтатьи);
	КонецЕсли;
	
	Лимит = ЛимитСтатьи(Статья);
	Израсходовано = ИзрасходованоПоСтатье(Статья);
	Остаток = Лимит - Израсходовано;
	Превышение = (СуммаЗаявки > Остаток);
	
	СтрокаЛимита = Новый Структура;
	СтрокаЛимита.Вставить("articleCode", СокрЛП(КодСтатьи));
	СтрокаЛимита.Вставить("articleName", Строка(Статья));
	СтрокаЛимита.Вставить("limitAmount", Лимит);
	СтрокаЛимита.Вставить("spentAmount", Израсходовано);
	СтрокаЛимита.Вставить("requestAmount", СуммаЗаявки);
	СтрокаЛимита.Вставить("remainder", Остаток);
	СтрокаЛимита.Вставить("overLimit", Превышение);
	
	Возврат СтрокаЛимита;
	
КонецФункции

