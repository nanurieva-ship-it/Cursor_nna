// HTTP-сервис БП ImportNSIBP, шаблон Counterparty → ЗагрузкаКонтрагента.
// Мастер — ДО. Пишем в привилегированном режиме. Журнал: ImportNSIBP.
// Ручное создание в БП режьте ролью бухгалтера — этот сервис не для формы.

Функция ЗагрузкаКонтрагента(Запрос)
	
	ИмяСобытия = "ImportNSIBP";
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Старт ЗагрузкаКонтрагента");
	
	Попытка
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело длина=" + Формат(СтрДлина(ТелоЗапроса), "ЧН=0; ЧГ=")
			+ " пустое=" + (Не ЗначениеЗаполнено(ТелоЗапроса))
			+ " текст=" + Лев(ТелоЗапроса, 2000));
		
		Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Возврат ОтветJSON(Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
			Если ДанныеЗапроса.Количество() = 0 Тогда
				Возврат ОтветJSON(Ложь, "Пустой массив");
			КонецЕсли;
			КонтрагентJSON = ДанныеЗапроса[0];
		Иначе
			КонтрагентJSON = ДанныеЗапроса;
		КонецЕсли;
		
		ИНН = СокрЛП(Строка(ЗначениеСвойства(КонтрагентJSON, "ИНН", "")));
		КПП = СокрЛП(Строка(ЗначениеСвойства(КонтрагентJSON, "КПП", "")));
		Наименование = СокрЛП(Строка(ЗначениеСвойства(КонтрагентJSON, "Наименование", "")));
		ПометкаУдаления = БулевоИзЗначения(ЗначениеСвойства(КонтрагентJSON, "ПометкаУдаления", Ложь));
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"ИНН=[" + ИНН + "] КПП=[" + КПП + "] Наименование=[" + Наименование + "]");
		
		Если Не ЗначениеЗаполнено(ИНН) Тогда
			Возврат ОтветJSON(Ложь, "Не передан ИНН");
		КонецЕсли;
		
		Контрагент = НайтиКонтрагентаПоИННКПП(ИНН, КПП);
		ЭтоНовый = Не ЗначениеЗаполнено(Контрагент);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Поиск: найден=" + (Не ЭтоНовый) + " ссылка=" + Строка(Контрагент));
		
		Если ЭтоНовый Тогда
			КонтрагентОбъект = Справочники.Контрагенты.СоздатьЭлемент();
			КонтрагентОбъект.ИНН = ИНН;
		Иначе
			КонтрагентОбъект = Контрагент.ПолучитьОбъект();
		КонецЕсли;
		
		КонтрагентОбъект.Наименование = ?(ЗначениеЗаполнено(Наименование), Наименование, ИНН);
		Если ЗначениеЗаполнено(КПП) Тогда
			КонтрагентОбъект.КПП = КПП;
		КонецЕсли;
		КонтрагентОбъект.ПометкаУдаления = ПометкаУдаления;
		КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
		КонтрагентОбъект.Записать();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , КонтрагентОбъект.Ссылка,
			?(ЭтоНовый, "Создан", "Обновлён") + " контрагент ИНН=[" + ИНН + "]");
		
		Возврат ОтветJSON(Истина, ?(ЭтоНовый, "Контрагент создан в БП", "Контрагент обновлён в БП"), ИНН);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветJSON(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецФункции

Функция НайтиКонтрагентаПоИННКПП(ИНН, КПП)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И (&КПП = """"
	|		ИЛИ Контрагенты.КПП = &КПП)
	|	И НЕ Контрагенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

Функция ОтветJSON(Успех, Сообщение, ИНН = "")
	
	Данные = Новый Структура;
	Данные.Вставить("success", Успех);
	Данные.Вставить("message", Сообщение);
	Если ЗначениеЗаполнено(ИНН) Тогда
		Данные.Вставить("inn", ИНН);
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации("ImportNSIBP", УровеньЖурналаРегистрации.Информация, , ,
		"HTTP-ответ 200 success=" + (Успех) + " тело=" + СтрокаJSON);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

Функция ЗначениеСвойства(Данные, Имя, ЗначениеПоУмолчанию)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция БулевоИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	
	СтрокаЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "ИСТИНА"
		Или СтрокаЗначения = "TRUE"
		Или СтрокаЗначения = "1"
		Или СтрокаЗначения = "ДА";
	
КонецФункции
