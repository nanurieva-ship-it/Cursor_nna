// Модуль HTTP-сервиса CheckLimitsDO (БП), шаблон Ch → ПроверкаЛимитов.
// Журнал регистрации, событие «CheckLimitsDO»: без отладчика видно тело, разбор и ответ.
// Администрирование → Журнал регистрации → отбор по событию CheckLimitsDO.

Функция ПроверкаЛимитов(Запрос)
	
	ИмяСобытия = "CheckLimitsDO";
	
	Попытка
		
		Метод = "";
		ОтносительныйURL = "";
		Попытка
			Метод = Строка(Запрос.HTTPМетод);
			ОтносительныйURL = Строка(Запрос.ОтносительныйURL);
		Исключение
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("Вход: метод=%1 URL=%2", Метод, ОтносительныйURL));
		
		Сообщение = Запрос.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело запроса (" + Формат(СтрДлина(Сообщение), "ЧН=0; ЧГ=") + " симв.): " + Лев(Сообщение, 2000));
		
		Если Не ЗначениеЗаполнено(Сообщение) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
				"Пустое тело запроса");
			Возврат ОтветЛимитовСЖурналом(ИмяСобытия, Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Сообщение);
		МассивОбъектовJSON = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("ПрочитатьJSON: тип=%1 количество=%2",
				Строка(ТипЗнч(МассивОбъектовJSON)),
				?(ТипЗнч(МассивОбъектовJSON) = Тип("Массив"), МассивОбъектовJSON.Количество(), 0)));
		
		Если ТипЗнч(МассивОбъектовJSON) <> Тип("Массив") Тогда
			Возврат ОтветЛимитовСЖурналом(ИмяСобытия, Ложь,
				"Тело не массив. Тип: " + Строка(ТипЗнч(МассивОбъектовJSON)));
		КонецЕсли;
		
		МассивЛимитов = Новый Массив;
		НомерСтроки = 0;
		
		Для Каждого ТекСчет Из МассивОбъектовJSON Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			Если ТипЗнч(ТекСчет) <> Тип("Структура") Тогда
				Текст = СтрШаблон("Строка %1 не структура, а %2", НомерСтроки, Строка(ТипЗнч(ТекСчет)));
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Текст);
				МассивЛимитов.Добавить(СтрокаОтветаЛимита(Ложь, Текст));
				Продолжить;
			КонецЕсли;
			
			Ключи = "";
			Для Каждого КиЗ Из ТекСчет Цикл
				Ключи = Ключи + КиЗ.Ключ + "=" + Лев(Строка(КиЗ.Значение), 80) + "; ";
			КонецЦикла;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("Строка %1 поля: %2", НомерСтроки, Ключи));
			
			КодСтатьи = "";
			Если ТекСчет.Свойство("СтатьяДДС") Тогда
				КодСтатьи = СокрЛП(Строка(ТекСчет.СтатьяДДС));
			ИначеЕсли ТекСчет.Свойство("статьяДДС") Тогда
				КодСтатьи = СокрЛП(Строка(ТекСчет.статьяДДС));
			КонецЕсли;
			
			ИмяСтатьиЗапроса = "";
			Если ТекСчет.Свойство("СтатьяДДСНаим") Тогда
				ИмяСтатьиЗапроса = СокрЛП(Строка(ТекСчет.СтатьяДДСНаим));
			ИначеЕсли ТекСчет.Свойство("articleName") Тогда
				ИмяСтатьиЗапроса = СокрЛП(Строка(ТекСчет.articleName));
			КонецЕсли;
			
			СтатьяДДС = НайтиСтатьюДДСДляЛимита(КодСтатьи, ИмяСтатьиЗапроса);
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СтатьяДДС,
				СтрШаблон("Строка %1 поиск статьи код=[%2] имя=[%3] найдена=%4",
					НомерСтроки, КодСтатьи, ИмяСтатьиЗапроса, ЗначениеЗаполнено(СтатьяДДС)));
			
			Если Не ЗначениеЗаполнено(СтатьяДДС) Тогда
				Текст = "Не найдена статья ДДС по коду «" + КодСтатьи + "»";
				МассивЛимитов.Добавить(СтрокаОтветаЛимита(Ложь, Текст));
				Продолжить;
			КонецЕсли;
			
			Сумма = 0;
			Если ТекСчет.Свойство("Сумма") Тогда
				Сумма = ?(ТипЗнч(ТекСчет.Сумма) = Тип("Число"), ТекСчет.Сумма,
					Число(СтрЗаменить(СтрЗаменить(Строка(ТекСчет.Сумма), " ", ""), ",", ".")));
			КонецЕсли;
			
			СтрокаДаты = "";
			Если ТекСчет.Свойство("ДатаПлатежа") Тогда
				СтрокаДаты = СокрЛП(Строка(ТекСчет.ДатаПлатежа));
			КонецЕсли;
			
			Если СтрДлина(СтрокаДаты) = 8 Тогда
				ДатаПлатежа = Дата(СтрокаДаты);
			ИначеЕсли СтрДлина(СтрокаДаты) >= 10 Тогда
				ДатаПлатежа = Дата(Число(Сред(СтрокаДаты, 7, 4)), Число(Сред(СтрокаДаты, 4, 2)), Число(Лев(СтрокаДаты, 2)));
			Иначе
				Текст = "Не разобрана ДатаПлатежа: «" + СтрокаДаты + "»";
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Текст);
				МассивЛимитов.Добавить(СтрокаОтветаЛимита(Ложь, Текст));
				Продолжить;
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СтатьяДДС,
				СтрШаблон("Строка %1 вызов ПроверкаЛимитов(%2, %3, %4)",
					НомерСтроки, Строка(СтатьяДДС), Формат(Сумма, "ЧДЦ=2; ЧН=0; ЧГ="), Формат(ДатаПлатежа, "ДФ=dd.MM.yyyy")));
			
			ЕстьЛимит = Ложь;
			ТекстМодуля = "";
			Остаток = Неопределено;
			
			Попытка
				СтруктураОтвета = ФУ_ОбщийМодульСервер.ПроверкаЛимитов(СтатьяДДС, Сумма, ДатаПлатежа);
				Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
					Если СтруктураОтвета.Свойство("ЕстьЛимит") Тогда
						ЕстьЛимит = (СтруктураОтвета.ЕстьЛимит = Истина);
					КонецЕсли;
					Если СтруктураОтвета.Свойство("ТекстСообщения") Тогда
						ТекстМодуля = Строка(СтруктураОтвета.ТекстСообщения);
					ИначеЕсли СтруктураОтвета.Свойство("message") Тогда
						ТекстМодуля = Строка(СтруктураОтвета.message);
					КонецЕсли;
					Остаток = ОстатокИзОтветаПроверкиЛимитов(СтруктураОтвета);
					КлючиОтвета = "";
					Для Каждого КиЗОтвета Из СтруктураОтвета Цикл
						КлючиОтвета = КлючиОтвета + КиЗОтвета.Ключ + "=" + Лев(Строка(КиЗОтвета.Значение), 80) + "; ";
					КонецЦикла;
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СтатьяДДС,
						"Поля ПроверкаЛимитов: " + КлючиОтвета
						+ " разобранныйОстаток=" + ?(Остаток = Неопределено, "нет", Формат(Остаток, "ЧРД=.; ЧН=0; ЧГ=")));
				Иначе
					ТекстМодуля = "ФУ_ОбщийМодульСервер.ПроверкаЛимитов вернула " + Строка(ТипЗнч(СтруктураОтвета));
				КонецЕсли;
			Исключение
				ТекстМодуля = "ПроверкаЛимитов: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СтатьяДДС,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
			Если Остаток = Неопределено Тогда
				РасчетБюджета = ОстатокПоБюджетуДДС(СтатьяДДС, ДатаПлатежа, ИмяСобытия);
				Остаток = РасчетБюджета.Остаток;
				Если ЗначениеЗаполнено(РасчетБюджета.Текст) Тогда
					ТекстМодуля = СокрЛП(ТекстМодуля + " " + РасчетБюджета.Текст);
				КонецЕсли;
			КонецЕсли;
			
			Если Остаток = Неопределено Тогда
				ЕстьЛимит = Ложь;
			ИначеЕсли Остаток <= 0 Или (Сумма > 0 И Остаток < Сумма) Тогда
				ЕстьЛимит = Ложь;
			Иначе
				ЕстьЛимит = Истина;
			КонецЕсли;
			
			СтрокаЛимита = СтрокаОтветаЛимитаПоСтатье(ЕстьЛимит, СтатьяДДС, КодСтатьи, Сумма, Остаток, ТекстМодуля);
			
			ЗаписьЖурналаРегистрации(ИмяСобытия,
				?(ЕстьЛимит, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение),
				, СтатьяДДС,
				СтрШаблон("Строка %1 ЕстьЛимит=%2 message=%3",
					НомерСтроки, ЕстьЛимит, СтрокаЛимита.message));
			
			МассивЛимитов.Добавить(СтрокаЛимита);
			
		КонецЦикла;
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивЛимитов);
		СтрокаОтвета = ЗаписьJSON.Закрыть();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело ответа 200: " + Лев(СтрокаОтвета, 2000));
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(СтрокаОтвета, КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
		
	Исключение
		
		Инфо = ИнформацияОбОшибке();
		Подробно = ПодробноеПредставлениеОшибки(Инфо);
		Кратко = КраткоеПредставлениеОшибки(Инфо);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		
		Возврат ОтветЛимитовСЖурналом(ИмяСобытия, Ложь, Кратко);
		
	КонецПопытки;
	
КонецФункции

Функция СтрокаОтветаЛимита(ЕстьЛимит, ТекстСообщения)
	
	Возврат СтрокаОтветаЛимитаПоСтатье(ЕстьЛимит, Неопределено, "", 0, Неопределено, ТекстСообщения);
	
КонецФункции

Функция СтрокаОтветаЛимитаПоСтатье(ЕстьЛимит, СтатьяДДС, КодСтатьи, СуммаЗаявки, Остаток, ТекстМодуля)
	
	Наименование = "";
	Если ЗначениеЗаполнено(СтатьяДДС) Тогда
		Наименование = СокрЛП(Строка(СтатьяДДС));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = СокрЛП(КодСтатьи);
	КонецЕсли;
	
	Дефицит = Неопределено;
	Если Остаток <> Неопределено Тогда
		Дефицит = СуммаЗаявки - Остаток;
		Если Дефицит < 0 Тогда
			Дефицит = 0;
		КонецЕсли;
	КонецЕсли;
	
	Если Остаток = Неопределено Тогда
		Если ЗначениеЗаполнено(Наименование) Тогда
			ТекстСообщения = "По статье «" + Наименование + "» остаток не получен.";
		ИначеЕсли ЗначениеЗаполнено(ТекстМодуля) Тогда
			ТекстСообщения = ТекстМодуля;
		Иначе
			ТекстСообщения = "Остаток по статье не получен.";
		КонецЕсли;
		Если ЗначениеЗаполнено(Наименование) И ЗначениеЗаполнено(ТекстМодуля)
			И СтрНайти(ТекстСообщения, ТекстМодуля) = 0 Тогда
			ТекстСообщения = ТекстСообщения + " " + ТекстМодуля;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Наименование) Тогда
		ТекстСообщения = "По статье «" + Наименование + "» остаток: "
			+ Формат(Остаток, "ЧДЦ=2; ЧН=0; ЧГ=") + " руб.";
		Если Не ЕстьЛимит Тогда
			Если Дефицит <> Неопределено Тогда
				ТекстСообщения = ТекстСообщения + " Превышение: "
					+ Формат(Дефицит, "ЧДЦ=2; ЧН=0; ЧГ=") + " руб.";
			Иначе
				ТекстСообщения = ТекстСообщения + " Лимит превышен.";
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекстМодуля) Тогда
				ТекстСообщения = ТекстСообщения + " " + ТекстМодуля;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТекстСообщения = ТекстМодуля;
	КонецЕсли;
	
	СтрокаЛимита = Новый Структура;
	СтрокаЛимита.Вставить("success", ЕстьЛимит);
	СтрокаЛимита.Вставить("message", ТекстСообщения);
	СтрокаЛимита.Вставить("articleCode", СокрЛП(КодСтатьи));
	СтрокаЛимита.Вставить("articleName", Наименование);
	СтрокаЛимита.Вставить("requestAmount", СуммаЗаявки);
	СтрокаЛимита.Вставить("remainder", Остаток);
	СтрокаЛимита.Вставить("deficit", Дефицит);
	Возврат СтрокаЛимита;
	
КонецФункции

Функция ЧислоСвойстваСтруктуры(Данные, ИменаЧерезЗапятую)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Имена = СтрРазделить(ИменаЧерезЗапятую, ",", Ложь);
	Для Каждого Имя Из Имена Цикл
		ИмяСвойства = СокрЛП(Имя);
		Значение = Неопределено;
		Если Данные.Свойство(ИмяСвойства, Значение) И Значение <> Неопределено Тогда
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Возврат Значение;
			КонецЕсли;
			Попытка
				Возврат Число(СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), ",", "."));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиСтатьюДДСДляЛимита(КодСтатьи, ИмяСтатьи)
	
	Если ЗначениеЗаполнено(КодСтатьи) Тогда
		Статья = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(КодСтатьи);
		Если ЗначениеЗаполнено(Статья) Тогда
			Возврат Статья;
		КонецЕсли;
		Статья = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(СокрЛП(КодСтатьи), Истина);
		Если ЗначениеЗаполнено(Статья) Тогда
			Возврат Статья;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяСтатьи) Тогда
		Статья = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию(ИмяСтатьи, Истина);
		Если ЗначениеЗаполнено(Статья) Тогда
			Возврат Статья;
		КонецЕсли;
		Попытка
			ЗапросСтатьи = Новый Запрос;
			ЗапросСтатьи.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Статьи.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СтатьиДвиженияДенежныхСредств КАК Статьи
			|ГДЕ
			|	НЕ Статьи.ПометкаУдаления
			|	И Статьи.Наименование ПОДОБНО &Имя";
			ЗапросСтатьи.УстановитьПараметр("Имя", "%" + ИмяСтатьи + "%");
			ВыборкаСтатьи = ЗапросСтатьи.Выполнить().Выбрать();
			Если ВыборкаСтатьи.Следующий() Тогда
				Возврат ВыборкаСтатьи.Ссылка;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	
КонецФункции

Функция ОстатокИзОтветаПроверкиЛимитов(Данные)
	
	Остаток = ЧислоСвойстваСтруктуры(Данные,
		"Остаток,ОстатокЛимита,remainder,СуммаОстатка,ОстатокПоСтатье,СвободныйОстаток,Свободно,Доступно,ДоступныйОстаток,СуммаСвободногоОстатка,ОстатокДенежныхСредств");
	Если Остаток <> Неопределено Тогда
		Возврат Остаток;
	КонецЕсли;
	
	Лимит = ЧислоСвойстваСтруктуры(Данные, "Лимит,СуммаЛимита,limitAmount");
	Расход = ЧислоСвойстваСтруктуры(Данные, "Расход,Израсходовано,Потрачено,spentAmount,Оборот");
	Если Лимит <> Неопределено И Расход <> Неопределено Тогда
		Возврат Лимит - Расход;
	КонецЕсли;
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из Данные Цикл
		ИмяКлюча = ВРег(Строка(КлючИЗначение.Ключ));
		Значение = КлючИЗначение.Значение;
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			Вложенный = ОстатокИзОтветаПроверкиЛимитов(Значение);
			Если Вложенный <> Неопределено Тогда
				Возврат Вложенный;
			КонецЕсли;
		КонецЕсли;
		Если СтрНайти(ИмяКлюча, "ОСТАТ") = 0 И СтрНайти(ИмяКлюча, "REMAIN") = 0
			И СтрНайти(ИмяКлюча, "СВОБОД") = 0 И СтрНайти(ИмяКлюча, "ДОСТУП") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЧислоЗначение = ЧислоИзПроизвольного(Значение);
		Если ЧислоЗначение <> Неопределено Тогда
			Возврат ЧислоЗначение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЧислоИзПроизвольного(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), ",", "."));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ОстатокПоБюджетуДДС(СтатьяДДС, ДатаПлатежа, ИмяСобытия)
	
	Результат = Новый Структура("Остаток, Текст", Неопределено, "");
	
	ИмяРегистра = ИмяРегистраБюджетДДС();
	Если Не ЗначениеЗаполнено(ИмяРегистра) Тогда
		Результат.Текст = "Регистр Бюджет ДДС в метаданных не найден.";
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СтатьяДДС, Результат.Текст);
		Возврат Результат;
	КонецЕсли;
	
	МетаРегистр = Метаданные.РегистрыНакопления.Найти(ИмяРегистра);
	Если МетаРегистр = Неопределено Тогда
		Результат.Текст = "Регистр " + ИмяРегистра + " не найден.";
		Возврат Результат;
	КонецЕсли;
	
	ИмяСтатьи = ИмяРеквизитаПоПодстрокам(МетаРегистр.Измерения, "СТАТЬ");
	ИмяСуммы = ИмяРеквизитаПоПодстрокам(МетаРегистр.Ресурсы, "СУММ");
	Если Не ЗначениеЗаполнено(ИмяСуммы) И МетаРегистр.Ресурсы.Количество() > 0 Тогда
		ИмяСуммы = МетаРегистр.Ресурсы[0].Имя;
	КонецЕсли;
	ИмяПланФакт = ИмяРеквизитаПоПодстрокам(МетаРегистр.Измерения, "ПЛАН,ФАКТ,ПОКАЗАТ,ТИПДВИЖ");
	Если Не ЗначениеЗаполнено(ИмяПланФакт) Тогда
		ИмяПланФакт = ИмяРеквизитаПоПодстрокам(МетаРегистр.Реквизиты, "ПЛАН,ФАКТ,ПОКАЗАТ,ТИПДВИЖ");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяСтатьи) Или Не ЗначениеЗаполнено(ИмяСуммы) Тогда
		Результат.Текст = "В регистре " + ИмяРегистра + " нет измерения статьи или ресурса суммы.";
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СтатьяДДС, Результат.Текст);
		Возврат Результат;
	КонецЕсли;
	
	Поля = "Движения.Регистратор КАК Регистратор, Движения.ВидДвижения КАК ВидДвиженияРегистра, Движения."
		+ ИмяСуммы + " КАК Сумма";
	Если ЗначениеЗаполнено(ИмяПланФакт) Тогда
		Поля = Поля + ", Движения." + ИмяПланФакт + " КАК ПланФакт";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + Поля + "
	|ИЗ
	|	РегистрНакопления." + ИмяРегистра + " КАК Движения
	|ГДЕ
	|	Движения.Активность
	|	И Движения." + ИмяСтатьи + " = &Статья
	|	И Движения.Период МЕЖДУ &НачалоПериода И &КонецПериода";
	Запрос.УстановитьПараметр("Статья", СтатьяДДС);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ДатаПлатежа));
	Запрос.УстановитьПараметр("КонецПериода", КонецГода(ДатаПлатежа));
	
	Попытка
		ТаблицаДвижений = Запрос.Выполнить().Выгрузить();
	Исключение
		Результат.Текст = "Запрос Бюджет ДДС: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , СтатьяДДС,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС + Запрос.Текст);
		Возврат Результат;
	КонецПопытки;
	
	ПланФинплана = 0;
	ПланПлановых = 0;
	ФактЗаявок = 0;
	
	Для Каждого СтрокаДвижения Из ТаблицаДвижений Цикл
		
		СуммаДвижения = ЧислоИзПроизвольного(СтрокаДвижения.Сумма);
		Если СуммаДвижения = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СуммаДвижения < 0 Тогда
			СуммаДвижения = -СуммаДвижения;
		КонецЕсли;
		
		ЭтоПлановая = ЭтоПлановаяЗаявкаРегистратора(СтрокаДвижения.Регистратор);
		ВидПланФакт = "";
		Если ТаблицаДвижений.Колонки.Найти("ПланФакт") <> Неопределено Тогда
			ВидПланФакт = ВРег(СокрЛП(Строка(СтрокаДвижения.ПланФакт)));
		КонецЕсли;
		ЭтоПлан = (СтрНайти(ВидПланФакт, "ПЛАН") > 0);
		ЭтоФакт = (СтрНайти(ВидПланФакт, "ФАКТ") > 0);
		Если Не ЭтоПлан И Не ЭтоФакт Тогда
			Если ЭтоПлановая Тогда
				ЭтоПлан = Истина;
			ИначеЕсли ЭтоДокументЗаявки(СтрокаДвижения.Регистратор) Тогда
				ЭтоФакт = Истина;
			Иначе
				ЭтоПлан = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоПлан И ЭтоПлановая Тогда
			ПланПлановых = ПланПлановых + СуммаДвижения;
		ИначеЕсли ЭтоПлан Тогда
			ПланФинплана = ПланФинплана + СуммаДвижения;
		ИначеЕсли ЭтоФакт Тогда
			ФактЗаявок = ФактЗаявок + СуммаДвижения;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТаблицаДвижений.Количество() = 0 Тогда
		Результат.Текст = "В регистре " + ИмяРегистра + " нет движений по статье за "
			+ Формат(НачалоГода(ДатаПлатежа), "ДФ=dd.MM.yyyy") + "–"
			+ Формат(КонецГода(ДатаПлатежа), "ДФ=dd.MM.yyyy")
			+ ". Проверьте период финплана и измерение статьи.";
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СтатьяДДС, Результат.Текст);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Остаток = ПланФинплана - ПланПлановых - ФактЗаявок;
	Результат.Текст = "Бюджет ДДС (" + ИмяРегистра + "): план финплана "
		+ Формат(ПланФинплана, "ЧДЦ=2; ЧН=0; ЧГ=")
		+ " − плановые " + Формат(ПланПлановых, "ЧДЦ=2; ЧН=0; ЧГ=")
		+ " − факт " + Формат(ФактЗаявок, "ЧДЦ=2; ЧН=0; ЧГ=")
		+ ", движений=" + ТаблицаДвижений.Количество();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СтатьяДДС, Результат.Текст);
	Возврат Результат;
	
КонецФункции

Функция ИмяРегистраБюджетДДС()
	
	Кандидаты = СтрРазделить(
		"ФУ_БюджетДДС,БюджетДДС,ак_БюджетДДС,БюджетДвиженияДенежныхСредств,ФУ_БюджетДвиженияДенежныхСредств",
		",",
		Ложь);
	Для Каждого ИмяРегистра Из Кандидаты Цикл
		Если Метаданные.РегистрыНакопления.Найти(СокрЛП(ИмяРегистра)) <> Неопределено Тогда
			Возврат СокрЛП(ИмяРегистра);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого МетаРегистр Из Метаданные.РегистрыНакопления Цикл
		ИмяВерх = ВРег(МетаРегистр.Имя + " " + МетаРегистр.Синоним);
		Если СтрНайти(ИмяВерх, "БЮДЖЕТ") > 0
			И (СтрНайти(ИмяВерх, "ДДС") > 0 Или СтрНайти(ИмяВерх, "ДЕНЕЖ") > 0) Тогда
			Возврат МетаРегистр.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ИмяРеквизитаПоПодстрокам(Коллекция, ПодстрокиЧерезЗапятую)
	
	Подстроки = СтрРазделить(ПодстрокиЧерезЗапятую, ",", Ложь);
	Для Каждого Элемент Из Коллекция Цикл
		ИмяВерх = ВРег(Элемент.Имя);
		Для Каждого Фрагмент Из Подстроки Цикл
			Если СтрНайти(ИмяВерх, СокрЛП(Фрагмент)) > 0 Тогда
				Возврат Элемент.Имя;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";
	
КонецФункции

Функция ЭтоДокументЗаявки(Регистратор)
	
	ИмяТипа = ВРег(Строка(ТипЗнч(Регистратор)));
	Возврат СтрНайти(ИмяТипа, "ЗАЯВК") > 0;
	
КонецФункции

Функция ЭтоПлановаяЗаявкаРегистратора(Регистратор)
	
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Если Регистратор.ПлановаяЗаявка = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Если Регистратор.Плановая = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

Функция ОтветЛимитовСЖурналом(ИмяСобытия, ЕстьЛимит, ТекстСообщения)
	
	МассивЛимитов = Новый Массив;
	МассивЛимитов.Добавить(СтрокаОтветаЛимита(ЕстьЛимит, ТекстСообщения));
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивЛимитов);
	СтрокаОтвета = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
		"Тело ответа (ошибка разбора): " + СтрокаОтвета);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаОтвета, КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
КонецФункции
