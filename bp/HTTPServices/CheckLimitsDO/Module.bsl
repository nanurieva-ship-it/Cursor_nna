// Модуль HTTP-сервиса CheckLimitsDO (БП), шаблон Ch → ПроверкаЛимитов.
// Журнал регистрации, событие «CheckLimitsDO»: без отладчика видно тело, разбор и ответ.
// Администрирование → Журнал регистрации → отбор по событию CheckLimitsDO.

Функция ПроверкаЛимитов(Запрос)
	
	ИмяСобытия = "CheckLimitsDO";
	
	Попытка
		
		Метод = "";
		ОтносительныйURL = "";
		Попытка
			Метод = Строка(Запрос.HTTPМетод);
			ОтносительныйURL = Строка(Запрос.ОтносительныйURL);
		Исключение
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("Вход: метод=%1 URL=%2", Метод, ОтносительныйURL));
		
		Сообщение = Запрос.ПолучитьТелоКакСтроку();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело запроса (" + Формат(СтрДлина(Сообщение), "ЧН=0; ЧГ=") + " симв.): " + Лев(Сообщение, 2000));
		
		Если Не ЗначениеЗаполнено(Сообщение) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
				"Пустое тело запроса");
			Возврат ОтветЛимитовСЖурналом(ИмяСобытия, Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Сообщение);
		МассивОбъектовJSON = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон("ПрочитатьJSON: тип=%1 количество=%2",
				Строка(ТипЗнч(МассивОбъектовJSON)),
				?(ТипЗнч(МассивОбъектовJSON) = Тип("Массив"), МассивОбъектовJSON.Количество(), 0)));
		
		Если ТипЗнч(МассивОбъектовJSON) <> Тип("Массив") Тогда
			Возврат ОтветЛимитовСЖурналом(ИмяСобытия, Ложь,
				"Тело не массив. Тип: " + Строка(ТипЗнч(МассивОбъектовJSON)));
		КонецЕсли;
		
		МассивЛимитов = Новый Массив;
		НомерСтроки = 0;
		
		Для Каждого ТекСчет Из МассивОбъектовJSON Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			Если ТипЗнч(ТекСчет) <> Тип("Структура") Тогда
				Текст = СтрШаблон("Строка %1 не структура, а %2", НомерСтроки, Строка(ТипЗнч(ТекСчет)));
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Текст);
				МассивЛимитов.Добавить(СтрокаОтветаЛимита(Ложь, Текст));
				Продолжить;
			КонецЕсли;
			
			Ключи = "";
			Для Каждого КиЗ Из ТекСчет Цикл
				Ключи = Ключи + КиЗ.Ключ + "=" + Лев(Строка(КиЗ.Значение), 80) + "; ";
			КонецЦикла;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон("Строка %1 поля: %2", НомерСтроки, Ключи));
			
			КодСтатьи = "";
			Если ТекСчет.Свойство("СтатьяДДС") Тогда
				КодСтатьи = СокрЛП(Строка(ТекСчет.СтатьяДДС));
			ИначеЕсли ТекСчет.Свойство("статьяДДС") Тогда
				КодСтатьи = СокрЛП(Строка(ТекСчет.статьяДДС));
			КонецЕсли;
			
			СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(КодСтатьи);
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СтатьяДДС,
				СтрШаблон("Строка %1 НайтиПоКоду(%2) = %3 пустая=%4",
					НомерСтроки, КодСтатьи, Строка(СтатьяДДС), Не ЗначениеЗаполнено(СтатьяДДС)));
			
			Если Не ЗначениеЗаполнено(СтатьяДДС) Тогда
				Текст = "Не найдена статья ДДС по коду «" + КодСтатьи + "»";
				МассивЛимитов.Добавить(СтрокаОтветаЛимита(Ложь, Текст));
				Продолжить;
			КонецЕсли;
			
			Сумма = 0;
			Если ТекСчет.Свойство("Сумма") Тогда
				Сумма = ?(ТипЗнч(ТекСчет.Сумма) = Тип("Число"), ТекСчет.Сумма,
					Число(СтрЗаменить(СтрЗаменить(Строка(ТекСчет.Сумма), " ", ""), ",", ".")));
			КонецЕсли;
			
			СтрокаДаты = "";
			Если ТекСчет.Свойство("ДатаПлатежа") Тогда
				СтрокаДаты = СокрЛП(Строка(ТекСчет.ДатаПлатежа));
			КонецЕсли;
			
			Если СтрДлина(СтрокаДаты) = 8 Тогда
				ДатаПлатежа = Дата(СтрокаДаты);
			ИначеЕсли СтрДлина(СтрокаДаты) >= 10 Тогда
				ДатаПлатежа = Дата(Число(Сред(СтрокаДаты, 7, 4)), Число(Сред(СтрокаДаты, 4, 2)), Число(Лев(СтрокаДаты, 2)));
			Иначе
				Текст = "Не разобрана ДатаПлатежа: «" + СтрокаДаты + "»";
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Текст);
				МассивЛимитов.Добавить(СтрокаОтветаЛимита(Ложь, Текст));
				Продолжить;
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СтатьяДДС,
				СтрШаблон("Строка %1 вызов ПроверкаЛимитов(%2, %3, %4)",
					НомерСтроки, Строка(СтатьяДДС), Формат(Сумма, "ЧДЦ=2; ЧН=0; ЧГ="), Формат(ДатаПлатежа, "ДФ=dd.MM.yyyy")));
			
			СтруктураОтвета = ФУ_ОбщийМодульСервер.ПроверкаЛимитов(СтатьяДДС, Сумма, ДатаПлатежа);
			
			ЕстьЛимит = Ложь;
			ТекстМодуля = "";
			Остаток = Неопределено;
			Если ТипЗнч(СтруктураОтвета) = Тип("Структура") Тогда
				Если СтруктураОтвета.Свойство("ЕстьЛимит") Тогда
					ЕстьЛимит = (СтруктураОтвета.ЕстьЛимит = Истина);
				КонецЕсли;
				Если СтруктураОтвета.Свойство("ТекстСообщения") Тогда
					ТекстМодуля = Строка(СтруктураОтвета.ТекстСообщения);
				КонецЕсли;
				Остаток = ЧислоСвойстваСтруктуры(СтруктураОтвета,
					"Остаток,ОстатокЛимита,remainder,СуммаОстатка,ОстатокПоСтатье");
				КлючиОтвета = "";
				Для Каждого КиЗОтвета Из СтруктураОтвета Цикл
					КлючиОтвета = КлючиОтвета + КиЗОтвета.Ключ + "=" + Лев(Строка(КиЗОтвета.Значение), 80) + "; ";
				КонецЦикла;
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СтатьяДДС,
					"Поля ПроверкаЛимитов: " + КлючиОтвета);
			Иначе
				ТекстМодуля = "ФУ_ОбщийМодульСервер.ПроверкаЛимитов вернула " + Строка(ТипЗнч(СтруктураОтвета));
			КонецЕсли;
			
			Если Остаток <> Неопределено И Остаток <= 0 Тогда
				ЕстьЛимит = Ложь;
			КонецЕсли;
			
			СтрокаЛимита = СтрокаОтветаЛимитаПоСтатье(ЕстьЛимит, СтатьяДДС, КодСтатьи, Сумма, Остаток, ТекстМодуля);
			
			ЗаписьЖурналаРегистрации(ИмяСобытия,
				?(ЕстьЛимит, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Предупреждение),
				, СтатьяДДС,
				СтрШаблон("Строка %1 ЕстьЛимит=%2 message=%3",
					НомерСтроки, ЕстьЛимит, СтрокаЛимита.message));
			
			МассивЛимитов.Добавить(СтрокаЛимита);
			
		КонецЦикла;
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, МассивЛимитов);
		СтрокаОтвета = ЗаписьJSON.Закрыть();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело ответа 200: " + Лев(СтрокаОтвета, 2000));
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(СтрокаОтвета, КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);
		Возврат Ответ;
		
	Исключение
		
		Инфо = ИнформацияОбОшибке();
		Подробно = ПодробноеПредставлениеОшибки(Инфо);
		Кратко = КраткоеПредставлениеОшибки(Инфо);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		
		Возврат ОтветЛимитовСЖурналом(ИмяСобытия, Ложь, Кратко);
		
	КонецПопытки;
	
КонецФункции

Функция СтрокаОтветаЛимита(ЕстьЛимит, ТекстСообщения)
	
	Возврат СтрокаОтветаЛимитаПоСтатье(ЕстьЛимит, Неопределено, "", 0, Неопределено, ТекстСообщения);
	
КонецФункции

Функция СтрокаОтветаЛимитаПоСтатье(ЕстьЛимит, СтатьяДДС, КодСтатьи, СуммаЗаявки, Остаток, ТекстМодуля)
	
	Наименование = "";
	Если ЗначениеЗаполнено(СтатьяДДС) Тогда
		Наименование = СокрЛП(Строка(СтатьяДДС));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Наименование = СокрЛП(КодСтатьи);
	КонецЕсли;
	
	Дефицит = Неопределено;
	Если Остаток <> Неопределено Тогда
		Дефицит = СуммаЗаявки - Остаток;
		Если Дефицит < 0 Тогда
			Дефицит = 0;
		КонецЕсли;
	КонецЕсли;
	
	Если Остаток = Неопределено Тогда
		Если ЗначениеЗаполнено(Наименование) Тогда
			ТекстСообщения = "По статье «" + Наименование + "» остаток не получен.";
		ИначеЕсли ЗначениеЗаполнено(ТекстМодуля) Тогда
			ТекстСообщения = ТекстМодуля;
		Иначе
			ТекстСообщения = "Остаток по статье не получен.";
		КонецЕсли;
		Если ЗначениеЗаполнено(Наименование) И ЗначениеЗаполнено(ТекстМодуля)
			И СтрНайти(ТекстСообщения, ТекстМодуля) = 0 Тогда
			ТекстСообщения = ТекстСообщения + " " + ТекстМодуля;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Наименование) Тогда
		ТекстСообщения = "По статье «" + Наименование + "» остаток: "
			+ Формат(Остаток, "ЧДЦ=2; ЧН=0; ЧГ=") + " руб.";
		Если Не ЕстьЛимит Тогда
			Если Дефицит <> Неопределено Тогда
				ТекстСообщения = ТекстСообщения + " Превышение: "
					+ Формат(Дефицит, "ЧДЦ=2; ЧН=0; ЧГ=") + " руб.";
			Иначе
				ТекстСообщения = ТекстСообщения + " Лимит превышен.";
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекстМодуля) Тогда
				ТекстСообщения = ТекстСообщения + " " + ТекстМодуля;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ТекстСообщения = ТекстМодуля;
	КонецЕсли;
	
	СтрокаЛимита = Новый Структура;
	СтрокаЛимита.Вставить("success", ЕстьЛимит);
	СтрокаЛимита.Вставить("message", ТекстСообщения);
	СтрокаЛимита.Вставить("articleCode", СокрЛП(КодСтатьи));
	СтрокаЛимита.Вставить("articleName", Наименование);
	СтрокаЛимита.Вставить("requestAmount", СуммаЗаявки);
	СтрокаЛимита.Вставить("remainder", Остаток);
	СтрокаЛимита.Вставить("deficit", Дефицит);
	Возврат СтрокаЛимита;
	
КонецФункции

Функция ЧислоСвойстваСтруктуры(Данные, ИменаЧерезЗапятую)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Имена = СтрРазделить(ИменаЧерезЗапятую, ",", Ложь);
	Для Каждого Имя Из Имена Цикл
		ИмяСвойства = СокрЛП(Имя);
		Значение = Неопределено;
		Если Данные.Свойство(ИмяСвойства, Значение) И Значение <> Неопределено Тогда
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				Возврат Значение;
			КонецЕсли;
			Попытка
				Возврат Число(СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), ",", "."));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция ОтветЛимитовСЖурналом(ИмяСобытия, ЕстьЛимит, ТекстСообщения)
	
	МассивЛимитов = Новый Массив;
	МассивЛимитов.Добавить(СтрокаОтветаЛимита(ЕстьЛимит, ТекстСообщения));
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивЛимитов);
	СтрокаОтвета = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
		"Тело ответа (ошибка разбора): " + СтрокаОтвета);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаОтвета, КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
	
КонецФункции
