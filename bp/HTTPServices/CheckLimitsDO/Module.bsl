// Модуль HTTP-сервиса CheckLimitsDO (БП).
// Шаблон URL: Ch  POST  → функция ПроверкаЛимитов
//
// Тело запроса — массив строк проверки:
// [
//   {"СтатьяДДС":"00-000012","Сумма":15000,"ДатаПлатежа":"20260923"}
// ]
//
// Тело ответа — массив результатов (как читает ДО):
// [
//   {"success":true,"message":""}
// ]

Функция ПроверкаЛимитов(Запрос)
	
	Попытка
		
		Сообщение = Запрос.ПолучитьТелоКакСтроку();
		Если Не ЗначениеЗаполнено(Сообщение) Тогда
			Возврат ОтветЛимитовОшибка(400, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Сообщение);
		МассивОбъектовJSON = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(МассивОбъектовJSON) <> Тип("Массив") Или МассивОбъектовJSON.Количество() = 0 Тогда
			Возврат ОтветЛимитовОшибка(400, "Ожидается непустой JSON-массив строк {СтатьяДДС, Сумма, ДатаПлатежа}");
		КонецЕсли;
		
		МассивЛимитов = Новый Массив;
		
		Для Каждого ТекСчет Из МассивОбъектовJSON Цикл
			
			СтрокиПроверки = СтрокиПроверкиИзЭлемента(ТекСчет);
			
			Если СтрокиПроверки.Количество() = 0 Тогда
				СтрокаЛимита = Новый Структура;
				СтрокаЛимита.Вставить("success", Ложь);
				СтрокаЛимита.Вставить("message", "В элементе запроса нет СтатьяДДС / Сумма / ДатаПлатежа");
				МассивЛимитов.Добавить(СтрокаЛимита);
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрокаПроверки Из СтрокиПроверки Цикл
				
				ДатаПлатежа = ДатаИзЗначенияJSON(СтрокаПроверки.ДатаПлатежа);
				Сумма = ЧислоИзЗначенияJSON(СтрокаПроверки.Сумма);
				КодСтатьи = СокрЛП(Строка(СтрокаПроверки.СтатьяДДС));
				
				СтруктураОтвета = ФУ_ОбщийМодульСервер.ПроверкаЛимитов(КодСтатьи, Сумма, ДатаПлатежа);
				
				СтрокаЛимита = Новый Структура;
				СтрокаЛимита.Вставить("success", СтруктураОтвета.ЕстьЛимит);
				СтрокаЛимита.Вставить("message", Строка(СтруктураОтвета.ТекстСообщения));
				МассивЛимитов.Добавить(СтрокаЛимита);
				
			КонецЦикла;
			
		КонецЦикла;
		
		Возврат HTTPОтветJSON(200, МассивЛимитов);
		
	Исключение
		
		Инфо = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(
			"CheckLimitsDO",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(Инфо));
		
		Возврат ОтветЛимитовОшибка(500, КраткоеПредставлениеОшибки(Инфо));
		
	КонецПопытки;
	
КонецФункции

// Плоская строка {СтатьяДДС, Сумма, ДатаПлатежа}
// или старый формат {Стр1: {ДатаПлатежа, Сумма, СтатьяДДС}, Стр2: ...}
Функция СтрокиПроверкиИзЭлемента(ТекСчет)
	
	Результат = Новый Массив;
	
	Если ТипЗнч(ТекСчет) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТекСчет.Свойство("СтатьяДДС") Или ТекСчет.Свойство("статьяДДС") Тогда
		Результат.Добавить(ПоляПроверки(ТекСчет));
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из ТекСчет Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Структура") Тогда
			Результат.Добавить(ПоляПроверки(КлючИЗначение.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПоляПроверки(Источник)
	
	Поля = Новый Структура("СтатьяДДС, Сумма, ДатаПлатежа", "", 0, "");
	
	Значение = Неопределено;
	Если Источник.Свойство("СтатьяДДС", Значение) Или Источник.Свойство("статьяДДС", Значение) Тогда
		Поля.СтатьяДДС = Значение;
	КонецЕсли;
	Если Источник.Свойство("Сумма", Значение) Тогда
		Поля.Сумма = Значение;
	КонецЕсли;
	Если Источник.Свойство("ДатаПлатежа", Значение) Тогда
		Поля.ДатаПлатежа = Значение;
	КонецЕсли;
	
	Возврат Поля;
	
КонецФункции

Функция ДатаИзЗначенияJSON(Значение)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	
	СтрокаДаты = СокрЛП(Строка(Значение));
	Если Не ЗначениеЗаполнено(СтрокаДаты) Тогда
		ВызватьИсключение "Не передана ДатаПлатежа";
	КонецЕсли;
	
	// "20260923"
	Если СтрДлина(СтрокаДаты) = 8 И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СтрокаДаты) Тогда
		Возврат Дата(СтрокаДаты);
	КонецЕсли;
	
	// "23.09.2026" — ДЛФ=Д
	Если СтрДлина(СтрокаДаты) >= 10 И Сред(СтрокаДаты, 3, 1) = "." Тогда
		День = Число(Лев(СтрокаДаты, 2));
		Месяц = Число(Сред(СтрокаДаты, 4, 2));
		Год = Число(Сред(СтрокаДаты, 7, 4));
		Возврат Дата(Год, Месяц, День);
	КонецЕсли;
	
	Возврат ПрочитатьДатуJSON(СтрокаДаты, ФорматДатыJSON.ISO);
	
КонецФункции

Функция ЧислоИзЗначенияJSON(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	
	СтрокаЧисла = СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), Символы.НПП, "");
	СтрокаЧисла = СтрЗаменить(СтрокаЧисла, ",", ".");
	Возврат Число(СтрокаЧисла);
	
КонецФункции

Функция ОтветЛимитовОшибка(КодСостояния, Текст)
	
	МассивЛимитов = Новый Массив;
	СтрокаЛимита = Новый Структура;
	СтрокаЛимита.Вставить("success", Ложь);
	СтрокаЛимита.Вставить("message", Текст);
	МассивЛимитов.Добавить(СтрокаЛимита);
	
	Возврат HTTPОтветJSON(КодСостояния, МассивЛимитов);
	
КонецФункции

Функция HTTPОтветJSON(КодСостояния, Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции
