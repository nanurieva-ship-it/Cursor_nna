// Подписка / &После("ПередЗаписью") справочника статей ДДС в БП (расширение САХ).
// Мастер — БП. При записи уходим в ДО. Журнал: СтатьиДДС_БП_ДО.

&После("ПередЗаписью")
Процедура ак_СтатьиДДСПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ак_ПользовательМожетМенятьСтатьиДДС() Тогда
		Отказ = Истина;
		Сообщить("Статьи ДДС может создавать и менять только пользователь с ролью «Полный доступ ФУ».");
		ЗаписьЖурналаРегистрации("СтатьиДДС_БП_ДО", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Отказ записи: нет роли ФУ. Пользователь=" + Строка(ПользователиИнформационнойБазы.ТекущийПользователь()));
	КонецЕсли;
	
КонецПроцедуры

&После("ПриЗаписи")
Процедура ак_СтатьиДДСПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ак_ВыгрузитьСтатьюВДО();
	
КонецПроцедуры

Функция ак_ПользовательМожетМенятьСтатьиДДС()
	
	Возврат РольДоступна("ПолныеПрава")
		Или РольДоступна("ак_ФУПолныйДоступ");
	
КонецФункции

Процедура ак_ВыгрузитьСтатьюВДО()
	
	ИмяСобытия = "СтатьиДДС_БП_ДО";
	
	Данные = Новый Структура;
	Данные.Вставить("ИдентификаторБП", Строка(Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("Код", СокрЛП(Код));
	Данные.Вставить("Наименование", СокрЛП(Наименование));
	Данные.Вставить("ПометкаУдаления", ПометкаУдаления);
	Данные.Вставить("ЭтоГруппа", ЭтоГруппа);
	
	РодительКод = "";
	Если ЗначениеЗаполнено(Родитель) Тогда
		РодительКод = СокрЛП(Родитель.Код);
	КонецЕсли;
	Данные.Вставить("РодительКод", РодительКод);
	
	Массив = Новый Массив;
	Массив.Добавить(Данные);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
		"JSON длина=" + Формат(СтрДлина(СтрокаJSON), "ЧН=0; ЧГ=") + " тело=" + СтрокаJSON);
	
	ПараметрыПодключения = ак_ПараметрыПодключенияКДО();
	Путь = "/doc_akea/hs/ImportNSIDO/Article";
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
		"HTTP POST https://" + ПараметрыПодключения.Сервер + ":"
		+ Формат(ПараметрыПодключения.Порт, "ЧГ=") + Путь
		+ " пользователь=[" + ПараметрыПодключения.Пользователь + "]"
		+ " парольЗаполнен=" + (ЗначениеЗаполнено(ПараметрыПодключения.Пароль)));
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Ошибка HTTP: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщить("Статья записана в БП, но в ДО не ушла: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Ответ HTTP код=" + Результат.КодСостояния
		+ " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
	Если Результат.КодСостояния <> 200 Тогда
		Сообщить("ДО не приняла статью. HTTP " + Результат.КодСостояния + " " + ТелоОтвета);
	КонецЕсли;
	
КонецПроцедуры

Функция ак_ПараметрыПодключенияКДО()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
	ПараметрыПодключения.Вставить("Порт", 59795);
	ПараметрыПодключения.Вставить("Пользователь", "Администратор");
	ПараметрыПодключения.Вставить("Пароль", "");
	Возврат ПараметрыПодключения;
	
КонецФункции
