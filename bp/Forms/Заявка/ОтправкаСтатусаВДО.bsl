// Модуль формы Документ.ФУ_ЗаявкаНаОплату.ФормаДокумента (ак_ФинУчет).
// Форма живёт в ЭТОМ расширении — НЕ использовать &Перед / &После / &Вместо:
// платформа ищет типовой метод и падает: «ПриСозданииНаСервере не определена».
// Типовой модуль не заменять. Вставить только вызовы в уже существующие процедуры
// и дописать процедуры ак_* / отправку в ДО ниже.
//
// ПриСозданииНаСервере / ПриЧтенииНаСервере / ПослеЗаписиНаСервере — в конце:
//   ак_ОбновитьОстатокПоДаннымОбъекта();
//   Модифицированность = Ложь;
// ПередЗаписью (клиент) — в начале: ак_ПроставитьОдобрениеНаКлиенте();
// ПередЗаписьюНаСервере — в конце: ак_ПередЗаписьюНаСервереДополнить(ТекущийОбъект);
// СоздатьПлатежноеПоручениеНаСервере — ПЕРВОЙ строкой:
//   ак_СинхронизироватьОбъектФормыСБазой();
// ПослеВводаКомментария — после типового кода: ак_ПослеВводаКомментария(Результат, ДопПараметры);
// Объект не менять при открытии. Журнал: «ОтправкаСтатусаВДО».

&НаКлиенте
Процедура ак_ПроставитьОдобрениеНаКлиенте()
	
	Если Не ак_ЭтоОдобренныйСтатусКлиент(Объект.Статус) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из Объект.ГрафикПлатежей Цикл
		Попытка
			Стр.Статус = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	СуммаПоГрафику = 0;
	Попытка
		СуммаПоГрафику = Объект.ГрафикПлатежей.Итог("СуммаКОплате");
	Исключение
	КонецПопытки;
	Если СуммаПоГрафику = 0 Тогда
		СуммаПоГрафику = Объект.Сумма;
	КонецЕсли;
	Попытка
		Объект.СуммаОдобрено = СуммаПоГрафику;
	Исключение
	КонецПопытки;
	ак_ОбновитьОстатокКСогласованиюНаКлиенте(СуммаПоГрафику);
	
КонецПроцедуры

&НаКлиенте
Процедура ак_ОбновитьОстатокКСогласованиюНаКлиенте(СуммаОдобрено)
	
	Остаток = Объект.Сумма - СуммаОдобрено;
	Если Остаток < 0 Тогда
		Остаток = 0;
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("ОстатокКСогласованию,ОстатокСогласования,СуммаКСогласованию,ОстатокСогласования", ",", Ложь) Цикл
		Попытка
			ЭтотОбъект[ИмяПоля] = Остаток;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ак_ЭтоОдобренныйСтатусКлиент(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Если СтрНайти(Имя, "НАСОГЛАСОВ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Имя, "ОДОБР") > 0 Или Имя = "СОГЛАСОВАНА" Или Имя = "СОГЛАСОВАН";
	
КонецФункции

&НаСервере
Процедура ак_СинхронизироватьОбъектФормыСБазой()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗначениеВРеквизитФормы(Объект.Ссылка.ПолучитьОбъект(), "Объект");
	Исключение
		Прочитать();
	КонецПопытки;
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ак_ОбновитьОстатокПоДаннымОбъекта()
	
	СуммаОдобрено = 0;
	Попытка
		СуммаОдобрено = Объект.СуммаОдобрено;
	Исключение
	КонецПопытки;
	ак_ОбновитьОстатокКСогласованиюНаСервере(СуммаОдобрено);
	
КонецПроцедуры

&НаСервере
Процедура ак_ПередЗаписьюНаСервереДополнить(ТекущийОбъект)
	
	ак_ПроставитьОдобрениеВДанных(Объект);
	ак_ПроставитьОдобрениеВДанных(ТекущийОбъект);
	Попытка
		ТекущийОбъект.СуммаОдобрено = Объект.СуммаОдобрено;
	Исключение
		Попытка
			ТекущийОбъект["СуммаОдобрено"] = Объект.СуммаОдобрено;
		Исключение
		КонецПопытки;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ак_ПроставитьОдобрениеВДанных(ДанныеЗаявки)
	
	Если ДанныеЗаявки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ак_ЭтоОдобренныйСтатус(ДанныеЗаявки.Статус) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаГрафика Из ДанныеЗаявки.ГрафикПлатежей Цикл
		Попытка
			СтрокаГрафика.Статус = Истина;
		Исключение
		КонецПопытки;
		Попытка
			СтрокаГрафика["Статус"] = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	СуммаПоГрафику = ак_СуммаГрафикаИлиДокумента(ДанныеЗаявки);
	ак_ЗаписатьСуммуОдобрено(ДанныеЗаявки, СуммаПоГрафику);
	
	Если ДанныеЗаявки = Объект Тогда
		ак_ОбновитьОстатокКСогласованиюНаСервере(СуммаПоГрафику);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ак_СуммаГрафикаИлиДокумента(ДанныеЗаявки)
	
	СуммаПоГрафику = 0;
	Попытка
		СуммаПоГрафику = ДанныеЗаявки.ГрафикПлатежей.Итог("СуммаКОплате");
	Исключение
	КонецПопытки;
	Если СуммаПоГрафику = 0 Тогда
		Попытка
			СуммаПоГрафику = ДанныеЗаявки.ГрафикПлатежей.Итог("Сумма");
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если СуммаПоГрафику = 0 Тогда
		Попытка
			СуммаПоГрафику = ДанныеЗаявки.Сумма;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Возврат СуммаПоГрафику;
	
КонецФункции

&НаСервере
Процедура ак_ЗаписатьСуммуОдобрено(ДанныеЗаявки, СуммаПоГрафику)
	
	Для Каждого ИмяРеквизита Из СтрРазделить("СуммаОдобрено,СуммаСогласовано,СуммаСогласована", ",", Ложь) Цикл
		Попытка
			ДанныеЗаявки[ИмяРеквизита] = СуммаПоГрафику;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ак_ОбновитьОстатокКСогласованиюНаСервере(СуммаОдобрено)
	
	Остаток = 0;
	Попытка
		Остаток = Объект.Сумма - СуммаОдобрено;
	Исключение
		Остаток = 0;
	КонецПопытки;
	Если Остаток < 0 Тогда
		Остаток = 0;
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("ОстатокКСогласованию,ОстатокСогласования,СуммаКСогласованию", ",", Ложь) Цикл
		Попытка
			ЭтотОбъект[ИмяПоля] = Остаток;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ак_ПроставитьГалочкиЕслиОдобрена(ЗаписыватьВБазу)
	
	Если Не ак_ЗаявкаОдобренаНаФорме() Тогда
		Возврат;
	КонецЕсли;
	
	ак_ПроставитьОдобрениеВДанных(Объект);
	
КонецПроцедуры

&НаСервере
Функция ак_ЗаявкаОдобренаНаФорме()
	
	Возврат ак_ЭтоОдобренныйСтатус(Объект.Статус);
	
КонецФункции

&НаСервере
Функция ак_ЭтоОдобренныйСтатус(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Если СтрНайти(Имя, "НАСОГЛАСОВ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Имя, "ОДОБР") > 0 Или Имя = "СОГЛАСОВАНА" Или Имя = "СОГЛАСОВАН";
	
КонецФункции

&НаСервере
Процедура ОтправкаОплатыВДО(НомерСчета, ИсточникВызова = "Оплата")
	
	ОтправкаСтатусаВдо(Истина, НомерСчета, Дата(1, 1, 1), ИсточникВызова, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ОтправкаСтатусаВдо(Статус, НомерСчета, ДатаПлатежа, ИсточникВызова = "", ЭтоОплата = Ложь)
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Старт. Источник=" + ИсточникВызова
		+ " документ=" + Строка(Объект.Ссылка)
		+ " номер=" + Строка(Объект.Номер)
		+ " НомерСчетаДО=[" + Строка(НомерСчета) + "]"
		+ " типНомера=" + Строка(ТипЗнч(НомерСчета))
		+ " ДатаПлатежа тип=" + Строка(ТипЗнч(ДатаПлатежа)) + " значение=[" + Строка(ДатаПлатежа) + "]"
		+ " форматYYYYMMDD=[" + Формат(ДатаПлатежа, "ДФ=yyyyMMdd") + "]"
		+ " Статус тип=" + Строка(ТипЗнч(Статус)) + " значение=[" + Строка(Статус) + "]"
		+ " какБулево=" + (Статус = Истина Или Статус = 1)
		+ " ЭтоОплата=" + (ЭтоОплата));
	
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Объект.Ссылка,
			"Отказ: пустой НомерСчетаДО, в ДО искать нечего");
		Сообщить("Не указан номер счёта ДО, статус не отправлен");
		Возврат;
	КонецЕсли;
	
	Плановая = Ложь;
	Попытка
		Плановая = (Объект.ПлановаяЗаявка = Истина);
	Исключение
		Попытка
			Плановая = (Объект.Плановая = Истина);
		Исключение
			Плановая = Ложь;
		КонецПопытки;
	КонецПопытки;
	
	ДатаКОтправке = ДатаПлатежа;
	Если Не ЗначениеЗаполнено(ДатаКОтправке) Тогда
		Попытка
			ДатаКОтправке = Объект.ПланируемаяДатаОплаты;
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаКОтправке) И Объект.ГрафикПлатежей.Количество() > 0 Тогда
		ДатаКОтправке = Объект.ГрафикПлатежей[0].ДатаПлатежа;
	КонецЕсли;
	
	Если Не ЭтоОплата И Не Плановая И Не ЗначениеЗаполнено(ДатаКОтправке) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Объект.Ссылка,
			"Отказ: пустая ДатаПлатежа");
		Сообщить("Не заполнена дата платежа, статус не отправлен");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	Если ЭтоОплата Тогда
		СтруктураОтправки.Вставить("Оплачена", Истина);
		СтруктураОтправки.Вставить("Исполнен", Истина);
		СтруктураОтправки.Вставить("Статус", "Оплачена");
	Иначе
		СтруктураОтправки.Вставить("Статус", Статус = Истина Или Статус = 1);
	КонецЕсли;
	СтруктураОтправки.Вставить("КодСчета", СокрЛП(Строка(НомерСчета)));
	Если ЗначениеЗаполнено(ДатаКОтправке) Тогда
		СтруктураОтправки.Вставить("ДатаПлатежа", Формат(ДатаКОтправке, "ДФ=yyyyMMdd"));
	КонецЕсли;
	Если Плановая Тогда
		СтруктураОтправки.Вставить("ПлановаяЗаявка", Истина);
		СтруктураОтправки.Вставить("ВидДокумента", "ПлановаяЗаявка");
	КонецЕсли;
	
	Массив = Новый Массив;
	Массив.Добавить(СтруктураОтправки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"JSON запроса длина=" + Формат(СтрДлина(СтрокаJSON), "ЧН=0; ЧГ=") + " тело=" + СтрокаJSON);
	
	ПараметрыПодключения = ПараметрыПодключенияКДО();
	СтрЗапроса = "/doc_akea/hs/FromBuhStatus/DownloadStatus";
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"HTTP POST https://" + ПараметрыПодключения.Сервер + ":"
		+ Формат(ПараметрыПодключения.Порт, "ЧГ=") + СтрЗапроса
		+ " пользователь=[" + ПараметрыПодключения.Пользователь + "]"
		+ " парольЗаполнен=" + (ЗначениеЗаполнено(ПараметрыПодключения.Пароль)));
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"HTTPСоединение создано");
		
		ЗапросPOST = Новый HTTPЗапрос(СтрЗапроса);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			"Ошибка HTTP: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщить("Ошибка соединения с ДО: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Ответ HTTP код=" + Результат.КодСостояния
		+ " длинаТела=" + Формат(СтрДлина(ТелоОтвета), "ЧН=0; ЧГ=")
		+ " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
	Успех = (Результат.КодСостояния = 200);
	ТекстДО = "";
	Если Результат.КодСостояния = 401 Или Результат.КодСостояния = 403 Тогда
		ТекстДО = "ДО вернула " + Результат.КодСостояния
			+ ". Нет доступа к HTTP-сервису FromBuhStatus. Пользователь=["
			+ ПараметрыПодключения.Пользователь + "], пароль "
			+ ?(ЗначениеЗаполнено(ПараметрыПодключения.Пароль), "задан", "ПУСТОЙ")
			+ ". Поставьте того же пользователя, что ходит в CheckLimits/ImportFromDO (обычно Аналитик), и его пароль.";
	ИначеЕсли ЗначениеЗаполнено(ТелоОтвета) Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			Данные = ПрочитатьJSON(ЧтениеJSON);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
				"Ответ JSON тип=" + Строка(ТипЗнч(Данные)));
			Если ТипЗнч(Данные) = Тип("Структура") Тогда
				Если Данные.Свойство("success") Тогда
					Успех = (Данные.success = Истина);
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
						"Ответ success=" + (Данные.success));
				КонецЕсли;
				Если Данные.Свойство("message") Тогда
					ТекстДО = Строка(Данные.message);
				КонецЕсли;
				Если Данные.Свойство("documentCode") Тогда
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
						"ДО documentCode=[" + Строка(Данные.documentCode)
						+ "] registrationNumber=[" + Строка(ЗначениеСвойстваОтвета(Данные, "registrationNumber")) + "]");
				КонецЕсли;
			КонецЕсли;
		Исключение
			ТекстДО = ТелоОтвета;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Объект.Ссылка,
				"Тело ответа не JSON: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	Иначе
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Объект.Ссылка,
			"ДО вернула пустое тело. Обработчик DownloadStatus мог не вызваться (не тот URL / метод).");
	КонецЕсли;
	
	Если Успех Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"Успех. " + ТекстДО);
		Сообщить("Статус заявки успешно отправлен в ДО");
	Иначе
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			"Отказ. HTTP=" + Результат.КодСостояния + " " + ТекстДО);
		Сообщить("Не удалось отправить статус в ДО. " + ТекстДО);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗначениеСвойстваОтвета(Данные, Имя)
	
	Значение = "";
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя) Тогда
		Значение = Строка(Данные[Имя]);
	КонецЕсли;
	Возврат Значение;
	
КонецФункции

&НаСервере
Функция ПараметрыПодключенияКДО()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
	ПараметрыПодключения.Вставить("Порт", 59795);
	ПараметрыПодключения.Вставить("Пользователь", "Администратор");
	ПараметрыПодключения.Вставить("Пароль", "12345678"); // как в живой форме заявки
	Возврат ПараметрыПодключения;
	
КонецФункции

&НаКлиенте
Процедура ак_ПослеВводаКомментария(Результат, ДопПараметры) Экспорт
	
	НомерСтроки = ДопПараметры.НомерСтроки;
	ЗаписатьВЖурналКлиентскийВызов("ак_ПослеВводаКомментария", НомерСтроки, Результат);
	
	ОтправкаСтатусаВдо(
		Объект.ГрафикПлатежей[НомерСтроки - 1].Статус,
		Объект.НомерСчетаДО,
		Объект.ГрафикПлатежей[НомерСтроки - 1].ДатаПлатежа,
		"ак_ПослеВводаКомментария");
	
КонецПроцедуры

&НаКлиенте
Процедура ак2_ГрафикПлатежейСтатусПриИзмененииПосле(Элемент)
	
	ТекДанные = Элементы.ГрафикПлатежей.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ЗаписатьВЖурналКлиентскийВызов("ак2_ГрафикПлатежейСтатусПриИзмененииПосле", 0, "ТекущиеДанные=Неопределено");
		Возврат;
	КонецЕсли;
	
	ЗаписатьВЖурналКлиентскийВызов("ак2_ГрафикПлатежейСтатусПриИзмененииПосле",
		Элементы.ГрафикПлатежей.ТекущаяСтрока,
		"Статус=" + ТекДанные.Статус);
	
	Если Не ТекДанные.Статус Тогда
		ОтправкаСтатусаВдо(
			ТекДанные.Статус,
			Объект.НомерСчетаДО,
			ТекДанные.ДатаПлатежа,
			"ак2_ГрафикПлатежейСтатусПриИзмененииПосле");
	Иначе
		ЗаписатьВЖурналКлиентскийВызов("ак2_ГрафикПлатежейСтатусПриИзмененииПосле",
			0,
			"Статус=Истина, отправка из этого обработчика пропущена (ждём комментарий)");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВЖурналКлиентскийВызов(Источник, НомерСтроки, ДопТекст)
	
	ЗаписьЖурналаРегистрации("ОтправкаСтатусаВДО", УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Клиентский вызов. Источник=" + Источник
		+ " номерСтроки=" + Строка(НомерСтроки)
		+ " доп=[" + Строка(ДопТекст) + "]"
		+ " НомерСчетаДО=[" + Строка(Объект.НомерСчетаДО) + "]"
		+ " строкГрафика=" + Объект.ГрафикПлатежей.Количество());
	
КонецПроцедуры
