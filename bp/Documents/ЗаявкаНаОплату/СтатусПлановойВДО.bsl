// Вызов из формы / объекта заявки БП, когда финдир ставит статус плановой.
// Савелий: при Одобрен — движение Бюджет ДДС видом План; при Отклонен — сторно.
// Затем этот метод шлёт статус в ДО. Журнал: ОтправкаСтатусаВДО.

Процедура ОтправитьСтатусПлановойВДО(СтатусТекст)
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	
	Если Не ПлановаяЗаявка Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
			"Пропуск: заявка не плановая");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("ВидДокумента", "ПлановаяЗаявка");
	СтруктураОтправки.Вставить("Статус", СокрЛП(СтатусТекст));
	СтруктураОтправки.Вставить("КодСчета", СокрЛП(Строка(НомерСчетаДО)));
	СтруктураОтправки.Вставить("ИдентификаторДО", "");
	
	Массив = Новый Массив;
	Массив.Добавить(СтруктураОтправки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Плановая JSON=" + СтрокаJSON);
	
	ПараметрыПодключения = ПараметрыПодключенияКДО();
	
	Путь = ПутьDownloadStatusДО();
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Ошибка HTTP плановой: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Плановая HTTP=" + Результат.КодСостояния
		+ " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
КонецПроцедуры

Функция ЭтоРабочаяБП()
	
	Возврат СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "sah_buh_akea") > 0;
	
КонецФункции

Функция ЭтоКопияБП()
	
	Возврат СтрНайти(НРег(СтрокаСоединенияИнформационнойБазы()), "buh_sah_copy") > 0;
	
КонецФункции

Функция ПутьDownloadStatusДО()
	
	Если ЭтоРабочаяБП() Тогда
		Возврат "/doc_akea/hs/FromBuhStatus/DownloadStatus";
	КонецЕсли;
	
	Если ЭтоКопияБП() Тогда
		Возврат "/eaa84ff6-eeb3-43f5-b89f-0308be2a7375/hs/FromBuhStatus/DownloadStatus";
	КонецЕсли;
	
	Возврат "/eaa84ff6-eeb3-43f5-b89f-0308be2a7375/hs/FromBuhStatus/DownloadStatus";
	
КонецФункции

Функция ПараметрыПодключенияКДО()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Порт", 59795);
	ПараметрыПодключения.Вставить("Пользователь", "Аналитик");
	ПараметрыПодключения.Вставить("Пароль", "");
	
	Если ЭтоРабочаяБП() Тогда
		ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
		Возврат ПараметрыПодключения;
	КонецЕсли;
	
	Если ЭтоКопияБП() Тогда
		ПараметрыПодключения.Вставить("Сервер", "1c.akea-ds.ru");
		Возврат ПараметрыПодключения;
	КонецЕсли;
	
	ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
	Возврат ПараметрыПодключения;
	
КонецФункции
