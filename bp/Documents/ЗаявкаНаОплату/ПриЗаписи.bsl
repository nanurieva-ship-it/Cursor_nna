// ТОЛЬКО модуль объекта Документ.ФУ_ЗаявкаНаОплату (расширение).
// НЕ вставлять в форму: у формы ПередЗаписью(Отказ, ПараметрыЗаписи),
// здесь ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения). Иначе запись заявки падает.
// Реквизиты основной конфигурации в расширении — ЭтотОбъект["Имя"], иначе «переменная не определена».
// При смене статуса на Оплачена шлём в ДО состояние Исполнен. Журнал: ОтправкаСтатусаВДО.

&Перед("ПередЗаписью")
Процедура ак_ПередЗаписьюПеред(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		СброситьСогласованиеНовогоДокумента();
		Возврат;
	КонецЕсли;
	
	Попытка
		ДополнительныеСвойства.Вставить("ак_СтарыйСтатус", ЭтотОбъект["Ссылка"].Статус);
	Исключение
	КонецПопытки;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ДополнительныеСвойства.Вставить("ак_ОтменаДокумента", Истина);
	КонецЕсли;
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура ак_ПередЗаписьюПосле(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоОтмена = Ложь;
	ДополнительныеСвойства.Свойство("ак_ОтменаДокумента", ЭтоОтмена);
	Если ЭтоОтмена = Истина Или ЭтоСтатусОтклоненияЗаявки(ЭтотОбъект["Статус"]) Тогда
		УстановитьОтклонениеЗаявки();
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоСтатусОдобренияЗаявки(ЭтотОбъект["Статус"]) Тогда
		Возврат;
	КонецЕсли;
	
	ОтметитьГрафикСогласованным();
	
КонецПроцедуры

&После("ОбработкаЗаполнения")
Процедура ак_ОбработкаЗаполненияПосле(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ФУ_ЗаявкаНаОплату") Тогда
		Возврат;
	КонецЕсли;
	
	ОснованиеПлановая = Ложь;
	Попытка
		ОснованиеПлановая = (ДанныеЗаполнения.ПлановаяЗаявка = Истина);
	Исключение
		ОснованиеПлановая = Ложь;
	КонецПопытки;
	Если Не ОснованиеПлановая Тогда
		Имя = ВРег(СтрЗаменить(СокрЛП(Строка(ДанныеЗаполнения)), " ", ""));
		ОснованиеПлановая = СтрНайти(Имя, "ПЛАНОВ") > 0;
	КонецЕсли;
	Если Не ОснованиеПлановая Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЭтотОбъект["СсылкаНаПлановуюЗаявку"] = ДанныеЗаполнения;
	Исключение
	КонецПопытки;
	Попытка
		ЭтотОбъект["ДокументОснование"] = ДанныеЗаполнения;
	Исключение
	КонецПопытки;
	
	Если Не ЭтоСтатусОдобренияЗаявки(ДанныеЗаполнения.Статус) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ак_АвтоодобрениеИзДО", Истина);
	ОтметитьГрафикСогласованным();
	Для Каждого СтрокаСогл Из ЭтотОбъект["Согласующие"] Цикл
		Попытка
			СтрокаСогл.Согласовано = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		ЭтотОбъект["Статус"] = ДанныеЗаполнения.Статус;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&После("ПриЗаписи")
Процедура ак_ПриЗаписиПосле(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗафиксироватьГалочкиГрафикаПослеЗаписи();
	
	СтарыйСтатус = Неопределено;
	ДополнительныеСвойства.Свойство("ак_СтарыйСтатус", СтарыйСтатус);
	
	ЭтоОтмена = Ложь;
	ДополнительныеСвойства.Свойство("ак_ОтменаДокумента", ЭтоОтмена);
	Если ЭтоОтмена = Истина Или (ЭтоСтатусОтклоненияЗаявки(ЭтотОбъект["Статус"])
		И ЭтотОбъект["Статус"] <> СтарыйСтатус) Тогда
		ОтправитьНеСогласованоВДО();
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоСтатусОплатыЗаявки(ЭтотОбъект["Статус"]) Тогда
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект["Статус"] = СтарыйСтатус Тогда
		Возврат;
	КонецЕсли;
	
	ОтправитьОплатуВДО();
	
КонецПроцедуры

Функция ЭтоСтатусОдобренияЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Если СтрНайти(Имя, "НАСОГЛАСОВ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Имя, "ОДОБР") > 0
		Или Имя = "СОГЛАСОВАНА"
		Или Имя = "СОГЛАСОВАН";
	
КонецФункции

Процедура СброситьСогласованиеНовогоДокумента()
	
	Автоодобрение = Ложь;
	ДополнительныеСвойства.Свойство("ак_АвтоодобрениеИзДО", Автоодобрение);
	Если Автоодобрение = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаГрафика Из ЭтотОбъект["ГрафикПлатежей"] Цикл
		Попытка
			СтрокаГрафика["Статус"] = Ложь;
		Исключение
		КонецПопытки;
		Попытка
			СтрокаГрафика["Согласовано"] = Ложь;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Для Каждого СтрокаСогл Из ЭтотОбъект["Согласующие"] Цикл
		Попытка
			СтрокаСогл.Согласовано = Ложь;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		ЭтотОбъект["СуммаОдобрено"] = 0;
	Исключение
	КонецПопытки;
	
	Если ЭтоСтатусОдобренияЗаявки(ЭтотОбъект["Статус"]) Тогда
		Попытка
			ЭтотОбъект["Статус"] = Перечисления.ФУ_СтатусыЗаявок.Создана;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗафиксироватьГалочкиГрафикаПослеЗаписи()
	
	Фиксация = Ложь;
	ДополнительныеСвойства.Свойство("ак_ФиксацияГрафика", Фиксация);
	Если Фиксация = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Автоодобрение = Ложь;
	ДополнительныеСвойства.Свойство("ак_АвтоодобрениеИзДО", Автоодобрение);
	Если Не Автоодобрение И Не ЭтоСтатусОдобренияЗаявки(ЭтотОбъект["Статус"]) Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаЗаявки = ЭтотОбъект["Ссылка"];
	Если Не ЗначениеЗаполнено(СсылкаЗаявки) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ДокЗаявка = СсылкаЗаявки.ПолучитьОбъект();
		НужнаФиксация = Автоодобрение = Истина;
		Для Каждого СтрокаГрафика Из ДокЗаявка.ГрафикПлатежей Цикл
			Признак = Неопределено;
			Попытка
				Признак = СтрокаГрафика["Статус"];
			Исключение
				Признак = Истина;
			КонецПопытки;
			Если Признак <> Истина Тогда
				НужнаФиксация = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не НужнаФиксация Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого СтрокаГрафика Из ДокЗаявка.ГрафикПлатежей Цикл
			Попытка
				СтрокаГрафика["Статус"] = Истина;
			Исключение
			КонецПопытки;
			Попытка
				СтрокаГрафика["Согласовано"] = Истина;
			Исключение
			КонецПопытки;
		КонецЦикла;
		
		СуммаПоГрафику = 0;
		Попытка
			СуммаПоГрафику = ДокЗаявка.ГрафикПлатежей.Итог("СуммаКОплате");
		Исключение
			СуммаПоГрафику = ДокЗаявка.Сумма;
		КонецПопытки;
		Если СуммаПоГрафику = 0 Тогда
			СуммаПоГрафику = ДокЗаявка.Сумма;
		КонецЕсли;
		ДокЗаявка.СуммаОдобрено = СуммаПоГрафику;
		ДокЗаявка.ДополнительныеСвойства.Вставить("ак_ФиксацияГрафика", Истина);
		ДокЗаявка.ДополнительныеСвойства.Вставить("ак_АвтоодобрениеИзДО", Истина);
		ДокЗаявка.ОбменДанными.Загрузка = Истина;
		ДокЗаявка.Записать(РежимЗаписиДокумента.Запись);
		ЗаписьЖурналаРегистрации("ОтправкаСтатусаВДО", УровеньЖурналаРегистрации.Информация, , СсылкаЗаявки,
			"Галочки графика записаны отдельным объектом. СуммаОдобрено=" + Формат(СуммаПоГрафику, "ЧГ="));
	Исключение
		ЗаписьЖурналаРегистрации("ОтправкаСтатусаВДО", УровеньЖурналаРегистрации.Предупреждение, , СсылкаЗаявки,
			"Не удалось зафиксировать галочки графика: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтметитьГрафикСогласованным()
	
	Для Каждого СтрокаГрафика Из ЭтотОбъект["ГрафикПлатежей"] Цикл
		Попытка
			СтрокаГрафика["Статус"] = Истина;
		Исключение
		КонецПопытки;
		Попытка
			СтрокаГрафика["Согласовано"] = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	СуммаПоГрафику = 0;
	Попытка
		СуммаПоГрафику = ЭтотОбъект["ГрафикПлатежей"].Итог("СуммаКОплате");
	Исключение
		Попытка
			СуммаПоГрафику = ЭтотОбъект["ГрафикПлатежей"].Итог("Сумма");
		Исключение
			СуммаПоГрафику = 0;
		КонецПопытки;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(ЭтотОбъект["СуммаОдобрено"]) Или ЭтотОбъект["СуммаОдобрено"] = 0 Тогда
		Если СуммаПоГрафику <> 0 Тогда
			ЭтотОбъект["СуммаОдобрено"] = СуммаПоГрафику;
		Иначе
			ЭтотОбъект["СуммаОдобрено"] = ЭтотОбъект["Сумма"];
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Если Не ЗначениеЗаполнено(ЭтотОбъект["ДатаОдобрения"]) Тогда
			ЭтотОбъект["ДатаОдобрения"] = ТекущаяДата();
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция ЭтоСтатусОтклоненияЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Возврат СтрНайти(Имя, "ОТКЛОН") > 0
		Или СтрНайти(Имя, "НЕСОГЛАСОВ") > 0
		Или СтрНайти(Имя, "ОТМЕН") > 0;
	
КонецФункции

Процедура УстановитьОтклонениеЗаявки()
	
	СтатусОтклонена = Неопределено;
	Для Каждого ИмяСтатуса Из СтрРазделить("Отклонена,Отклонен,НеСогласована,НеСогласован", ",", Ложь) Цикл
		Попытка
			СтатусОтклонена = Перечисления.ФУ_СтатусыЗаявок[ИмяСтатуса];
			Если ЗначениеЗаполнено(СтатусОтклонена) Тогда
				Прервать;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Если ЗначениеЗаполнено(СтатусОтклонена) Тогда
		ЭтотОбъект["Статус"] = СтатусОтклонена;
	КонецЕсли;
	
	Для Каждого СтрокаГрафика Из ЭтотОбъект["ГрафикПлатежей"] Цикл
		Попытка
			СтрокаГрафика["Статус"] = Ложь;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		ЭтотОбъект["СуммаОдобрено"] = 0;
	Исключение
	КонецПопытки;
	
	ДополнительныеСвойства.Вставить("ак_ОтменаДокумента", Истина);
	
КонецПроцедуры

Процедура ОтправитьНеСогласованоВДО()
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	НомерСчета = "";
	Попытка
		НомерСчета = СокрЛП(Строка(ЭтотОбъект["НомерСчетаДО"]));
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ЭтотОбъект["Ссылка"],
			"Отмена: пустой НомерСчетаДО");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("Статус", "НеСогласован");
	СтруктураОтправки.Вставить("НеСогласовано", Истина);
	СтруктураОтправки.Вставить("НеСогласован", Истина);
	СтруктураОтправки.Вставить("Отклонена", Истина);
	СтруктураОтправки.Вставить("Отмена", Истина);
	СтруктураОтправки.Вставить("КодСчета", НомерСчета);
	
	ЭтоПлановая = Ложь;
	Попытка
		ЭтоПлановая = (ЭтотОбъект["ПлановаяЗаявка"] = Истина);
	Исключение
		Попытка
			ЭтоПлановая = (ЭтотОбъект["Плановая"] = Истина);
		Исключение
			ЭтоПлановая = Ложь;
		КонецПопытки;
	КонецПопытки;
	Если ЭтоПлановая Тогда
		СтруктураОтправки.Вставить("ПлановаяЗаявка", Истина);
		СтруктураОтправки.Вставить("ВидДокумента", "ПлановаяЗаявка");
	КонецЕсли;
	
	Массив = Новый Массив;
	Массив.Добавить(СтруктураОтправки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
		"НеСогласовано JSON=" + СтрокаJSON);
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение("1c.sah18.ru", 59795, "Администратор", "12345678", , , Новый ЗащищенноеСоединениеOpenSSL);
		ЗапросPOST = Новый HTTPЗапрос("/doc_akea/hs/FromBuhStatus/DownloadStatus");
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
			"НеСогласовано HTTP=" + Результат.КодСостояния + " тело=" + Лев(Результат.ПолучитьТелоКакСтроку("UTF-8"), 1000));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ЭтотОбъект["Ссылка"],
			"НеСогласовано: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ЭтоСтатусОплатыЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СокрЛП(Строка(СтатусЗаявки)));
	Возврат СтрНайти(Имя, "ОПЛАЧ") > 0 Или СтрНайти(Имя, "ИСПОЛН") > 0;
	
КонецФункции

Процедура ОтправитьОплатуВДО()
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	НомерСчета = "";
	Попытка
		НомерСчета = СокрЛП(Строка(ЭтотОбъект["НомерСчетаДО"]));
	Исключение
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ЭтотОбъект["Ссылка"],
			"Оплата: пустой НомерСчетаДО, в ДО не отправляем");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("Оплачена", Истина);
	СтруктураОтправки.Вставить("Исполнен", Истина);
	СтруктураОтправки.Вставить("Статус", "Оплачена");
	СтруктураОтправки.Вставить("КодСчета", НомерСчета);
	
	ЭтоПлановая = Ложь;
	Попытка
		ЭтоПлановая = (ЭтотОбъект["ПлановаяЗаявка"] = Истина);
	Исключение
		Попытка
			ЭтоПлановая = (ЭтотОбъект["Плановая"] = Истина);
		Исключение
			ЭтоПлановая = Ложь;
		КонецПопытки;
	КонецПопытки;
