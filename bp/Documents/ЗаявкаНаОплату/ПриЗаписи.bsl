// ТОЛЬКО модуль объекта Документ.ФУ_ЗаявкаНаОплату (расширение).
// НЕ вставлять в форму: у формы ПередЗаписью(Отказ, ПараметрыЗаписи),
// здесь ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения). Иначе запись заявки падает.
// При смене статуса на Оплачена шлём в ДО состояние Исполнен. Журнал: ОтправкаСтатусаВДО.

&Перед("ПередЗаписью")
Процедура ак_ПередЗаписьюПеред(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Или ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ДополнительныеСвойства.Вставить("ак_СтарыйСтатус", Ссылка.Статус);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура ак_ПередЗаписьюПосле(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтоСтатусОдобренияЗаявки(Статус) Тогда
		Возврат;
	КонецЕсли;
	
	ОтметитьГрафикСогласованным();
	
КонецПроцедуры

&После("ПриЗаписи")
Процедура ак_ПриЗаписиПосле(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СтарыйСтатус = Неопределено;
	ДополнительныеСвойства.Свойство("ак_СтарыйСтатус", СтарыйСтатус);
	
	Если Не ЭтоСтатусОплатыЗаявки(Статус) Тогда
		Возврат;
	КонецЕсли;
	Если Статус = СтарыйСтатус Тогда
		Возврат;
	КонецЕсли;
	
	ОтправитьОплатуВДО();
	
КонецПроцедуры

Функция ЭтоСтатусОдобренияЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Если СтрНайти(Имя, "НАСОГЛАСОВ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Имя, "ОДОБР") > 0
		Или Имя = "СОГЛАСОВАНА"
		Или Имя = "СОГЛАСОВАН";
	
КонецФункции

Процедура ОтметитьГрафикСогласованным()
	
	Для Каждого СтрокаГрафика Из ГрафикПлатежей Цикл
		Попытка
			СтрокаГрафика.Статус = Истина;
		Исключение
		КонецПопытки;
		Попытка
			СтрокаГрафика.Согласовано = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	СуммаПоГрафику = 0;
	Попытка
		СуммаПоГрафику = ГрафикПлатежей.Итог("СуммаКОплате");
	Исключение
		Попытка
			СуммаПоГрафику = ГрафикПлатежей.Итог("Сумма");
		Исключение
			СуммаПоГрафику = 0;
		КонецПопытки;
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(СуммаОдобрено) Или СуммаОдобрено = 0 Тогда
		Если СуммаПоГрафику <> 0 Тогда
			СуммаОдобрено = СуммаПоГрафику;
		Иначе
			СуммаОдобрено = Сумма;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Если Не ЗначениеЗаполнено(ДатаОдобрения) Тогда
			ДатаОдобрения = ТекущаяДата();
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция ЭтоСтатусОплатыЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СокрЛП(Строка(СтатусЗаявки)));
	Возврат СтрНайти(Имя, "ОПЛАЧ") > 0 Или СтрНайти(Имя, "ИСПОЛН") > 0;
	
КонецФункции

Процедура ОтправитьОплатуВДО()
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	НомерСчета = "";
	Попытка
		НомерСчета = СокрЛП(Строка(НомерСчетаДО));
	Исключение
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
			"Оплата: пустой НомерСчетаДО, в ДО не отправляем");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("Оплачена", Истина);
	СтруктураОтправки.Вставить("Исполнен", Истина);
	СтруктураОтправки.Вставить("Статус", "Оплачена");
	СтруктураОтправки.Вставить("КодСчета", НомерСчета);
	
	ЭтоПлановая = Ложь;
	Попытка
		ЭтоПлановая = (ПлановаяЗаявка = Истина);
	Исключение
		Попытка
			ЭтоПлановая = (Плановая = Истина);
		Исключение
			ЭтоПлановая = Ложь;
		КонецПопытки;
	КонецПопытки;
	Если ЭтоПлановая Тогда
		СтруктураОтправки.Вставить("ПлановаяЗаявка", Истина);
		СтруктураОтправки.Вставить("ВидДокумента", "ПлановаяЗаявка");
	КонецЕсли;
	
	Массив = Новый Массив;
	Массив.Добавить(СтруктураОтправки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
		"Оплата JSON=" + СтрокаJSON);
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение("1c.sah18.ru", 59795, "Администратор", "12345678", , , Новый ЗащищенноеСоединениеOpenSSL);
		ЗапросPOST = Новый HTTPЗапрос("/doc_akea/hs/FromBuhStatus/DownloadStatus");
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
			"Оплата HTTP=" + Результат.КодСостояния + " тело=" + Лев(Результат.ПолучитьТелоКакСтроку("UTF-8"), 1000));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Оплата: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры
