// ТОЛЬКО модуль объекта Документ.ФУ_ЗаявкаНаОплату.
// ГрафикПлатежей.Статус и СуммаОдобрено здесь НЕ ставить — только HTTP ImportFromDO.
// Иначе форма и ПриЗаписи затирают галочки. Журнал: ОтправкаСтатусаВДО.

&Перед("ПередЗаписью")
Процедура ак_ПередЗаписьюПеред(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		СброситьСогласованиеНовогоДокумента();
		Возврат;
	КонецЕсли;
	
	Попытка
		ДополнительныеСвойства.Вставить("ак_СтарыйСтатус", ЭтотОбъект["Ссылка"].Статус);
	Исключение
	КонецПопытки;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ДополнительныеСвойства.Вставить("ак_ОтменаДокумента", Истина);
	КонецЕсли;
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура ак_ПередЗаписьюПосле(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоОтмена = Ложь;
	ДополнительныеСвойства.Свойство("ак_ОтменаДокумента", ЭтоОтмена);
	Если ЭтоОтмена = Истина Или ЭтоСтатусОтклоненияЗаявки(ЭтотОбъект["Статус"]) Тогда
		УстановитьОтклонениеЗаявки();
	КонецЕсли;
	
КонецПроцедуры

&После("ОбработкаЗаполнения")
Процедура ак_ОбработкаЗаполненияПосле(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ФУ_ЗаявкаНаОплату") Тогда
		Возврат;
	КонецЕсли;
	
	ОснованиеПлановая = Ложь;
	Попытка
		ОснованиеПлановая = (ДанныеЗаполнения.ПлановаяЗаявка = Истина);
	Исключение
		ОснованиеПлановая = Ложь;
	КонецПопытки;
	Если Не ОснованиеПлановая Тогда
		Имя = ВРег(СтрЗаменить(СокрЛП(Строка(ДанныеЗаполнения)), " ", ""));
		ОснованиеПлановая = СтрНайти(Имя, "ПЛАНОВ") > 0;
	КонецЕсли;
	Если Не ОснованиеПлановая Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЭтотОбъект["СсылкаНаПлановуюЗаявку"] = ДанныеЗаполнения;
	Исключение
	КонецПопытки;
	Попытка
		ЭтотОбъект["ДокументОснование"] = ДанныеЗаполнения;
	Исключение
	КонецПопытки;
	
	Если ЭтоСтатусОдобренияЗаявки(ДанныеЗаполнения.Статус) Тогда
		Попытка
			ЭтотОбъект["Статус"] = ДанныеЗаполнения.Статус;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&После("ПриЗаписи")
Процедура ак_ПриЗаписиПосле(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	СтарыйСтатус = Неопределено;
	ДополнительныеСвойства.Свойство("ак_СтарыйСтатус", СтарыйСтатус);
	
	ЭтоОтмена = Ложь;
	ДополнительныеСвойства.Свойство("ак_ОтменаДокумента", ЭтоОтмена);
	Если ЭтоОтмена = Истина Или (ЭтоСтатусОтклоненияЗаявки(ЭтотОбъект["Статус"])
		И ЭтотОбъект["Статус"] <> СтарыйСтатус) Тогда
		ОтправитьНеСогласованоВДО();
		Возврат;
	КонецЕсли;
	
	Если ЭтоСтатусОдобренияЗаявки(ЭтотОбъект["Статус"])
		И ЭтотОбъект["Статус"] <> СтарыйСтатус Тогда
		ОтправитьСогласованиеВДО();
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоСтатусОплатыЗаявки(ЭтотОбъект["Статус"]) Тогда
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект["Статус"] = СтарыйСтатус Тогда
		Возврат;
	КонецЕсли;
	
	ОтправитьОплатуВДО();
	
КонецПроцедуры

Функция ЭтоСтатусОдобренияЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Если СтрНайти(Имя, "НАСОГЛАСОВ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Имя, "ОДОБР") > 0 Или Имя = "СОГЛАСОВАНА" Или Имя = "СОГЛАСОВАН";
	
КонецФункции

Процедура СброситьСогласованиеНовогоДокумента()
	
	Автоодобрение = Ложь;
	ДополнительныеСвойства.Свойство("ак_АвтоодобрениеИзДО", Автоодобрение);
	Если Автоодобрение = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаСогл Из ЭтотОбъект["Согласующие"] Цикл
		Попытка
			СтрокаСогл.Согласовано = Ложь;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоСтатусОтклоненияЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Возврат СтрНайти(Имя, "ОТКЛОН") > 0
		Или СтрНайти(Имя, "НЕСОГЛАСОВ") > 0
		Или СтрНайти(Имя, "ОТМЕН") > 0;
	
КонецФункции

Процедура УстановитьОтклонениеЗаявки()
	
	СтатусОтклонена = Неопределено;
	Для Каждого ИмяСтатуса Из СтрРазделить("Отклонена,Отклонен,НеСогласована,НеСогласован", ",", Ложь) Цикл
		Попытка
			СтатусОтклонена = Перечисления.ФУ_СтатусыЗаявок[ИмяСтатуса];
			Если ЗначениеЗаполнено(СтатусОтклонена) Тогда
				Прервать;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Если ЗначениеЗаполнено(СтатусОтклонена) Тогда
		ЭтотОбъект["Статус"] = СтатусОтклонена;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ак_ОтменаДокумента", Истина);
	
КонецПроцедуры

Процедура ОтправитьНеСогласованоВДО()
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	НомерСчета = "";
	Попытка
		НомерСчета = СокрЛП(Строка(ЭтотОбъект["НомерСчетаДО"]));
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ЭтотОбъект["Ссылка"],
			"Отмена: пустой НомерСчетаДО");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("Статус", "НеСогласовано");
	СтруктураОтправки.Вставить("НеСогласовано", Истина);
	СтруктураОтправки.Вставить("Отклонена", Истина);
	СтруктураОтправки.Вставить("КодСчета", НомерСчета);
	
	Попытка
		Если ЭтотОбъект["ПлановаяЗаявка"] = Истина Тогда
			СтруктураОтправки.Вставить("ПлановаяЗаявка", Истина);
			СтруктураОтправки.Вставить("ВидДокумента", "ПлановаяЗаявка");
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Массив = Новый Массив;
	Массив.Добавить(СтруктураОтправки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
		"НеСогласовано JSON=" + СтрокаJSON);
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение("1c.sah18.ru", 59795, "Администратор", "12345678", , , Новый ЗащищенноеСоединениеOpenSSL);
		ЗапросPOST = Новый HTTPЗапрос("/doc_akea/hs/FromBuhStatus/DownloadStatus");
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
			"НеСогласовано HTTP=" + Результат.КодСостояния + " тело=" + Лев(Результат.ПолучитьТелоКакСтроку("UTF-8"), 1000));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ЭтотОбъект["Ссылка"],
			"НеСогласовано: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ЭтоСтатусОплатыЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СокрЛП(Строка(СтатусЗаявки)));
	Возврат СтрНайти(Имя, "ОПЛАЧ") > 0 Или СтрНайти(Имя, "ИСПОЛН") > 0;
	
КонецФункции

Процедура ОтправитьСогласованиеВДО()
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	НомерСчета = "";
	Попытка
		НомерСчета = СокрЛП(Строка(ЭтотОбъект["НомерСчетаДО"]));
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ЭтотОбъект["Ссылка"],
			"Согласование: пустой НомерСчетаДО");
		Возврат;
	КонецЕсли;
	
	ДатаКОтправке = Дата(1, 1, 1);
	Попытка
		Если ЭтотОбъект["ГрафикПлатежей"].Количество() > 0 Тогда
			ДатаКОтправке = ЭтотОбъект["ГрафикПлатежей"][0].ДатаПлатежа;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(ДатаКОтправке) Тогда
		Попытка
			ДатаКОтправке = ЭтотОбъект["ПланируемаяДатаОплаты"];
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаКОтправке) Тогда
		ДатаКОтправке = ТекущаяДата();
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("Статус", Истина);
	СтруктураОтправки.Вставить("Согласовано", Истина);
	СтруктураОтправки.Вставить("Согласован", Истина);
	СтруктураОтправки.Вставить("АвтоСогласование", Истина);
	СтруктураОтправки.Вставить("КодСчета", НомерСчета);
	СтруктураОтправки.Вставить("ДатаПлатежа", Формат(ДатаКОтправке, "ДФ=yyyyMMdd"));
	
	Массив = Новый Массив;
	Массив.Добавить(СтруктураОтправки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
		"Согласование JSON=" + СтрокаJSON);
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение("1c.sah18.ru", 59795, "Администратор", "12345678", , , Новый ЗащищенноеСоединениеOpenSSL);
		ЗапросPOST = Новый HTTPЗапрос("/doc_akea/hs/FromBuhStatus/DownloadStatus");
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
			"Согласование HTTP=" + Результат.КодСостояния + " тело=" + Лев(Результат.ПолучитьТелоКакСтроку("UTF-8"), 1000));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ЭтотОбъект["Ссылка"],
			"Согласование: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтправитьОплатуВДО()
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	НомерСчета = "";
	Попытка
		НомерСчета = СокрЛП(Строка(ЭтотОбъект["НомерСчетаДО"]));
	Исключение
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ЭтотОбъект["Ссылка"],
			"Оплата: пустой НомерСчетаДО, в ДО не отправляем");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("Оплачена", Истина);
	СтруктураОтправки.Вставить("Исполнен", Истина);
	СтруктураОтправки.Вставить("Статус", "Оплачена");
	СтруктураОтправки.Вставить("КодСчета", НомерСчета);
	
	ЭтоПлановая = Ложь;
	Попытка
		ЭтоПлановая = (ЭтотОбъект["ПлановаяЗаявка"] = Истина);
	Исключение
		Попытка
			ЭтоПлановая = (ЭтотОбъект["Плановая"] = Истина);
		Исключение
			ЭтоПлановая = Ложь;
		КонецПопытки;
	КонецПопытки;
	Если ЭтоПлановая Тогда
		СтруктураОтправки.Вставить("ПлановаяЗаявка", Истина);
		СтруктураОтправки.Вставить("ВидДокумента", "ПлановаяЗаявка");
	КонецЕсли;
	
	Массив = Новый Массив;
	Массив.Добавить(СтруктураОтправки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
		"Оплата JSON=" + СтрокаJSON);
	
	Попытка
		HTTPСоединение = Новый HTTPСоединение("1c.sah18.ru", 59795, "Администратор", "12345678", , , Новый ЗащищенноеСоединениеOpenSSL);
		ЗапросPOST = Новый HTTPЗапрос("/doc_akea/hs/FromBuhStatus/DownloadStatus");
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
			"Оплата HTTP=" + Результат.КодСостояния + " тело=" + Лев(Результат.ПолучитьТелоКакСтроку("UTF-8"), 1000));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ЭтотОбъект["Ссылка"],
			"Оплата: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры
