// ТОЛЬКО модуль объекта Документ.ФУ_ЗаявкаНаОплату (ак_ФинУчет).
// Если документ заведён в этом же расширении — аннотации &Перед/&После не ставить:
// вставить тело в уже существующие ПередЗаписью / ПриЗаписи / ОбработкаЗаполнения.
// НЕ переносить ПередЗаписью / ПриЗаписи в форму: у формы другие параметры,
// запись из конфигуратора и ImportFromDO идёт без формы — галочки там некому ставить.
// Реквизиты основной конфигурации — ЭтотОбъект["Имя"] и СтрокаГрафика["Статус"].
// Счёт из плановой: если сумма счёта + предыдущие счета <= 1,05 * сумма плановой,
// то для каждой строки ГрафикПлатежей Статус = Истина и СуммаОдобрено = итог графика.
// Вторую запись из ПриЗаписи не делать: форма остаётся на старой версии,
// РеквизитФормыВЗначение при создании платёжки падает.
// При смене статуса на Оплачена шлём в ДО состояние Исполнен. Журнал: ОтправкаСтатусаВДО.

&Перед("ПередЗаписью")
Процедура ак_ПередЗаписьюПеред(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		СброситьСогласованиеНовогоДокумента();
		Возврат;
	КонецЕсли;
	
	Попытка
		ДополнительныеСвойства.Вставить("ак_СтарыйСтатус", ЭтотОбъект["Ссылка"].Статус);
	Исключение
	КонецПопытки;
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ДополнительныеСвойства.Вставить("ак_ОтменаДокумента", Истина);
	КонецЕсли;
	
КонецПроцедуры

&После("ПередЗаписью")
Процедура ак_ПередЗаписьюПосле(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Отказ Или ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоОтмена = Ложь;
	ДополнительныеСвойства.Свойство("ак_ОтменаДокумента", ЭтоОтмена);
	Если ЭтоОтмена = Истина Или ЭтоСтатусОтклоненияЗаявки(ЭтотОбъект["Статус"]) Тогда
		УстановитьОтклонениеЗаявки();
		Возврат;
	КонецЕсли;
	
	Если ЭтоСчетПоПлановойЗаявке() И СуммаСчетовВПределеПлановой() Тогда
		ПроставитьСтатусГрафикаИСуммуОдобрено();
		ДополнительныеСвойства.Вставить("ак_АвтоодобрениеИзДО", Истина);
	ИначеЕсли ЭтоСтатусОдобренияЗаявки(ЭтотОбъект["Статус"]) Тогда
		ПроставитьСтатусГрафикаИСуммуОдобрено();
	КонецЕсли;
	
КонецПроцедуры

&После("ОбработкаЗаполнения")
Процедура ак_ОбработкаЗаполненияПосле(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ФУ_ЗаявкаНаОплату") Тогда
		Возврат;
	КонецЕсли;
	
	ОснованиеПлановая = Ложь;
	Попытка
		ОснованиеПлановая = (ДанныеЗаполнения.ПлановаяЗаявка = Истина);
	Исключение
		ОснованиеПлановая = Ложь;
	КонецПопытки;
	Если Не ОснованиеПлановая Тогда
		Имя = ВРег(СтрЗаменить(СокрЛП(Строка(ДанныеЗаполнения)), " ", ""));
		ОснованиеПлановая = СтрНайти(Имя, "ПЛАНОВ") > 0;
	КонецЕсли;
	Если Не ОснованиеПлановая Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЭтотОбъект["СсылкаНаПлановуюЗаявку"] = ДанныеЗаполнения;
	Исключение
	КонецПопытки;
	Попытка
		ЭтотОбъект["ДокументОснование"] = ДанныеЗаполнения;
	Исключение
	КонецПопытки;
	
	Если Не ЭтоСтатусОдобренияЗаявки(ДанныеЗаполнения.Статус) Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ак_АвтоодобрениеИзДО", Истина);
	ОтметитьГрафикСогласованным();
	Для Каждого СтрокаСогл Из ЭтотОбъект["Согласующие"] Цикл
		Попытка
			СтрокаСогл.Согласовано = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		ЭтотОбъект["Статус"] = ДанныеЗаполнения.Статус;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&После("ПриЗаписи")
Процедура ак_ПриЗаписиПосле(Отказ)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СтарыйСтатус = Неопределено;
	ДополнительныеСвойства.Свойство("ак_СтарыйСтатус", СтарыйСтатус);
	
	ЭтоОтмена = Ложь;
	ДополнительныеСвойства.Свойство("ак_ОтменаДокумента", ЭтоОтмена);
	Если ЭтоОтмена = Истина Или (ЭтоСтатусОтклоненияЗаявки(ЭтотОбъект["Статус"])
		И ЭтотОбъект["Статус"] <> СтарыйСтатус) Тогда
		ОтправитьНеСогласованоВДО();
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоСтатусОплатыЗаявки(ЭтотОбъект["Статус"]) Тогда
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект["Статус"] = СтарыйСтатус Тогда
		Возврат;
	КонецЕсли;
	
	ОтправитьОплатуВДО();
	
КонецПроцедуры

Функция ЭтоСтатусОдобренияЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Если СтрНайти(Имя, "НАСОГЛАСОВ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Имя, "ОДОБР") > 0
		Или Имя = "СОГЛАСОВАНА"
		Или Имя = "СОГЛАСОВАН";
	
КонецФункции

Процедура СброситьСогласованиеНовогоДокумента()
	
	Автоодобрение = Ложь;
	ДополнительныеСвойства.Свойство("ак_АвтоодобрениеИзДО", Автоодобрение);
	Если Автоодобрение = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаГрафика Из ЭтотОбъект["ГрафикПлатежей"] Цикл
		Попытка
			СтрокаГрафика["Статус"] = Ложь;
		Исключение
		КонецПопытки;
		Попытка
			СтрокаГрафика["Согласовано"] = Ложь;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Для Каждого СтрокаСогл Из ЭтотОбъект["Согласующие"] Цикл
		Попытка
			СтрокаСогл.Согласовано = Ложь;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		ЭтотОбъект["СуммаОдобрено"] = 0;
	Исключение
	КонецПопытки;
	
	Если ЭтоСтатусОдобренияЗаявки(ЭтотОбъект["Статус"]) Тогда
		Попытка
			ЭтотОбъект["Статус"] = Перечисления.ФУ_СтатусыЗаявок.Создана;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроставитьСтатусГрафикаИСуммуОдобрено()
	
	Для Каждого Стр Из ЭтотОбъект["ГрафикПлатежей"] Цикл
		Попытка
			Стр.Статус = Истина;
		Исключение
		КонецПопытки;
		Попытка
			Стр["Статус"] = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	СуммаПоГрафику = СуммаСтрокГрафикаПлатежей(ЭтотОбъект);
	Попытка
		ЭтотОбъект["СуммаОдобрено"] = СуммаПоГрафику;
	Исключение
	КонецПопытки;
	Попытка
		ЭтотОбъект["СуммаСогласовано"] = СуммаПоГрафику;
	Исключение
	КонецПопытки;
	
	Попытка
		Если Не ЭтоСтатусОдобренияЗаявки(ЭтотОбъект["Статус"]) Тогда
			ЭтотОбъект["Статус"] = Перечисления.ФУ_СтатусыЗаявок.Одобрена;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Попытка
		Если Не ЗначениеЗаполнено(ЭтотОбъект["ДатаОдобрения"]) Тогда
			ЭтотОбъект["ДатаОдобрения"] = ТекущаяДата();
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

Функция ЭтоСчетПоПлановойЗаявке()
	
	Попытка
		Если ЭтотОбъект["ПлановаяЗаявка"] = Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат ЗначениеЗаполнено(СсылкаПлановойОснованияСчета());
	
КонецФункции

Функция СсылкаПлановойОснованияСчета()
	
	Кандидаты = Новый Массив;
	Попытка
		Кандидаты.Добавить(ЭтотОбъект["СсылкаНаПлановуюЗаявку"]);
	Исключение
	КонецПопытки;
	Попытка
		Кандидаты.Добавить(ЭтотОбъект["ДокументОснование"]);
	Исключение
	КонецПопытки;
	
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Не ЗначениеЗаполнено(Кандидат) Тогда
			Продолжить;
		КонецЕсли;
		ЭтоПлановая = Ложь;
		Попытка
			ЭтоПлановая = (Кандидат.ПлановаяЗаявка = Истина);
		Исключение
			ЭтоПлановая = Ложь;
		КонецПопытки;
		Если ЭтоПлановая Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Документы.ФУ_ЗаявкаНаОплату.ПустаяСсылка();
	
КонецФункции

Функция СуммаСчетовВПределеПлановой()
	
	ПлановаяСсылка = СсылкаПлановойОснованияСчета();
	Если Не ЗначениеЗаполнено(ПлановаяСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СуммаПлановой = 0;
	Попытка
		СуммаПлановой = ПлановаяСсылка.Сумма;
	Исключение
		СуммаПлановой = 0;
	КонецПопытки;
	Если СуммаПлановой <= 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СуммаЭтогоСчета = СуммаСтрокГрафикаПлатежей(ЭтотОбъект);
	Если СуммаЭтогоСчета = 0 Тогда
		Попытка
			СуммаЭтогоСчета = ЭтотОбъект["Сумма"];
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	СуммаПредыдущих = СуммаПредыдущихСчетовПоПлановой(ПлановаяСсылка);
	Потолок = Окр(СуммаПлановой * 1.05, 2);
	Итого = Окр(СуммаПредыдущих + СуммаЭтогоСчета, 2);
	
	ЗаписьЖурналаРегистрации("ОтправкаСтатусаВДО", УровеньЖурналаРегистрации.Информация, , ЭтотОбъект["Ссылка"],
		"Правило 5% при записи: плановая=" + Формат(СуммаПлановой, "ЧГ=")
		+ " потолок=" + Формат(Потолок, "ЧГ=")
		+ " предыдущие=" + Формат(СуммаПредыдущих, "ЧГ=")
		+ " этот=" + Формат(СуммаЭтогоСчета, "ЧГ=")
		+ " итого=" + Формат(Итого, "ЧГ=")
		+ " ок=" + (Итого <= Потолок));
	
	Возврат Итого <= Потолок;
	
КонецФункции

Функция СуммаПредыдущихСчетовПоПлановой(ПлановаяСсылка)
	
	Сумма = 0;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ФУ_ЗаявкаНаОплату.Сумма), 0) КАК Сумма
		|ИЗ
		|	Документ.ФУ_ЗаявкаНаОплату КАК ФУ_ЗаявкаНаОплату
		|ГДЕ
		|	НЕ ФУ_ЗаявкаНаОплату.ПометкаУдаления
		|	И ФУ_ЗаявкаНаОплату.Ссылка <> &Этот
		|	И ФУ_ЗаявкаНаОплату.Ссылка <> &Плановая
		|	И ФУ_ЗаявкаНаОплату.ПлановаяЗаявка = ЛОЖЬ
		|	И (ФУ_ЗаявкаНаОплату.СсылкаНаПлановуюЗаявку = &Плановая
		|		ИЛИ ФУ_ЗаявкаНаОплату.ДокументОснование = &Плановая)";
		Запрос.УстановитьПараметр("Плановая", ПлановаяСсылка);
		ЭтотСчет = Документы.ФУ_ЗаявкаНаОплату.ПустаяСсылка();
		Попытка
			ЭтотСчет = ЭтотОбъект["Ссылка"];
		Исключение
		КонецПопытки;
		Запрос.УстановитьПараметр("Этот", ЭтотСчет);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Сумма = Выборка.Сумма;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("ОтправкаСтатусаВДО", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Не удалось сложить предыдущие счета: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Сумма;
	
КонецФункции

Функция СуммаСтрокГрафикаПлатежей(ДанныеЗаявки)
	
	СуммаПоГрафику = 0;
	Попытка
		СуммаПоГрафику = ДанныеЗаявки["ГрафикПлатежей"].Итог("СуммаКОплате");
	Исключение
		Попытка
			СуммаПоГрафику = ДанныеЗаявки.ГрафикПлатежей.Итог("СуммаКОплате");
		Исключение
			СуммаПоГрафику = 0;
		КонецПопытки;
	КонецПопытки;
	Если СуммаПоГрафику = 0 Тогда
		Попытка
			СуммаПоГрафику = ДанныеЗаявки["Сумма"];
		Исключение
			Попытка
				СуммаПоГрафику = ДанныеЗаявки.Сумма;
			Исключение
			КонецПопытки;
		КонецПопытки;
	КонецЕсли;
	Возврат СуммаПоГрафику;
	
КонецФункции

Процедура ОтметитьГрафикСогласованным()
	
	ПроставитьСтатусГрафикаИСуммуОдобрено();
	
	Для Каждого СтрокаГрафика Из ЭтотОбъект["ГрафикПлатежей"] Цикл
		Попытка
			СтрокаГрафика["Согласовано"] = Истина;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоСтатусОтклоненияЗаявки(СтатусЗаявки)
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(СтатусЗаявки)), " ", ""));
	Возврат СтрНайти(Имя, "ОТКЛОН") > 0
		Или СтрНайти(Имя, "НЕСОГЛАСОВ") > 0
		Или СтрНайти(Имя, "ОТМЕН") > 0;
	
КонецФункции

Процедура УстановитьОтклонениеЗаявки()
	
	СтатусОтклонена = Неопределено;
	Для Каждого ИмяСтатуса Из СтрРазделить("Отклонена,Отклонен,НеСогласована,НеСогласован", ",", Ложь) Цикл
		Попытка
			СтатусОтклонена = Перечисления.ФУ_СтатусыЗаявок[ИмяСтатуса];
			Если ЗначениеЗаполнено(СтатусОтклонена) Тогда
				Прервать;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Если ЗначениеЗаполнено(СтатусОтклонена) Тогда
		ЭтотОбъект["Статус"] = СтатусОтклонена;
	КонецЕсли;
	
	Для Каждого СтрокаГрафика Из ЭтотОбъект["ГрафикПлатежей"] Цикл
		Попытка
			СтрокаГрафика["Статус"] = Ложь;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		ЭтотОбъект["СуммаОдобрено"] = 0;
	Исключение
	КонецПопытки;
	
	ДополнительныеСвойства.Вставить("ак_ОтменаДокумента", Истина);
	
КонецПроцедуры

Процедура ОтправитьНеСогласованоВДО()
	
	ИмяСобытия = "ОтправкаСтатусаВДО";
	НомерСчета = "";
	Попытка
		НомерСчета = СокрЛП(Строка(ЭтотОбъект["НомерСчетаДО"]));
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(НомерСчета) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ЭтотОбъект["Ссылка"],
			"Отмена: пустой НомерСчетаДО");
		Возврат;
	КонецЕсли;
	
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("Статус", "НеСогласован");
	СтруктураОтправки.Вставить("НеСогласовано", Истина);
	СтруктураОтправки.Вставить("НеСогласован", Истина);
	СтруктураОтправки.Вставить("Отклонена", Истина);
	СтруктураОтправки.Вставить("Отмена", Истина);
