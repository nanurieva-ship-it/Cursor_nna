// Объектный модуль / расширение справочника контрагентов ДО.
// Не публиковать, пока Максим не подтвердит контур. Журнал: Контрагенты_ДО_БП.

&После("ПриЗаписи")
Процедура ак_КонтрагентыПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ак_ВыгрузитьКонтрагентаВБП();
	
КонецПроцедуры

Процедура ак_ВыгрузитьКонтрагентаВБП()
	
	ИмяСобытия = "Контрагенты_ДО_БП";
	
	ЗначениеИНН = "";
	ЗначениеКПП = "";
	Попытка
		ЗначениеИНН = СокрЛП(ИНН);
	Исключение
	КонецПопытки;
	Попытка
		ЗначениеКПП = СокрЛП(КПП);
	Исключение
	КонецПопытки;
	
	Данные = Новый Структура;
	Данные.Вставить("ИдентификаторДО", Строка(Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("Наименование", СокрЛП(Наименование));
	Данные.Вставить("ИНН", ЗначениеИНН);
	Данные.Вставить("КПП", ЗначениеКПП);
	Данные.Вставить("ПометкаУдаления", ПометкаУдаления);
	
	Если Не ЗначениеЗаполнено(ЗначениеИНН) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Ссылка,
			"Пропуск выгрузки: пустой ИНН");
		Возврат;
	КонецЕсли;
	
	Массив = Новый Массив;
	Массив.Добавить(Данные);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
		"JSON=" + СтрокаJSON);
	
	ПараметрыПодключения = ак_ПараметрыПодключенияКБП();
	Путь = "/sah_buh_akea/hs/ImportNSIBP/Counterparty";
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Ссылка,
			"Ошибка HTTP: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Ссылка,
		"HTTP код=" + Результат.КодСостояния
		+ " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
КонецПроцедуры

Функция ак_ПараметрыПодключенияКБП()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
	ПараметрыПодключения.Вставить("Порт", 59795);
	ПараметрыПодключения.Вставить("Пользователь", "Аналитик");
	ПараметрыПодключения.Вставить("Пароль", "");
	Возврат ПараметрыПодключения;
	
КонецФункции
