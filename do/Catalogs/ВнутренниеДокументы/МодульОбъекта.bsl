// Модуль объекта Справочник.ВнутренниеДокументы (расширение).
// Плановая заявка может уходить на согласование без получателя.
// Счёт на оплату: график платежей обязателен (хотя бы одна строка с датой и суммой).
// В форму не вставлять.

&Перед("ОбработкаПроверкиЗаполнения")
Процедура ак_ОбработкаПроверкиЗаполненияПеред(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ак_ЭтоПлановаяЗаявкаОбъекта() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПроверяемыеРеквизиты) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = ПроверяемыеРеквизиты.Количество();
	Пока Индекс > 0 Цикл
		Индекс = Индекс - 1;
		Если ак_ЭтоИмяПолучателяОбъекта(ПроверяемыеРеквизиты[Индекс]) Тогда
			ПроверяемыеРеквизиты.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&После("ОбработкаПроверкиЗаполнения")
Процедура ак_ОбработкаПроверкиЗаполненияПосле(Отказ, ПроверяемыеРеквизиты)
	
	Если ак_ЭтоСчетНаОплатуОбъекта() И Не ак_ГрафикПлатежейЗаполнен() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Заполните график платежей: нужна хотя бы одна строка с датой и суммой.";
		Сообщение.Поле = "ГрафикПлатежей";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	Если Не ак_ЭтоПлановаяЗаявкаОбъекта() Тогда
		Возврат;
	КонецЕсли;
	
	Сообщения = ПолучитьСообщенияПользователю(Истина);
	ОсталсяОтказ = Ложь;
	Для Каждого Сообщение Из Сообщения Цикл
		Текст = ВРег(Строка(Сообщение.Текст));
		Поле = ВРег(Строка(Сообщение.Поле));
		Если ак_ЭтоИмяПолучателяОбъекта(Текст) Или ак_ЭтоИмяПолучателяОбъекта(Поле) Тогда
			Продолжить;
		КонецЕсли;
		Сообщение.Сообщить();
		ОсталсяОтказ = Истина;
	КонецЦикла;
	
	Если Не ОсталсяОтказ Тогда
		Отказ = Ложь;
	КонецЕсли;
	
КонецПроцедуры

Функция ак_ЭтоПлановаяЗаявкаОбъекта()
	
	ВидДокумента = Неопределено;
	Попытка
		ВидДокумента = ЭтотОбъект["ВидДокумента"];
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Если Строка(ВидДокумента.УникальныйИдентификатор()) = "0f8f6296-ba4a-11f1-a615-9c69b465b0dd" Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Наименования = Новый Массив;
	Наименования.Добавить(Строка(ВидДокумента));
	Попытка
		Наименования.Добавить(ВидДокумента.Наименование);
	Исключение
	КонецПопытки;
	
	Для Каждого ИмяВида Из Наименования Цикл
		Имя = ВРег(СтрЗаменить(СокрЛП(Строка(ИмяВида)), " ", ""));
		Если СтрНайти(Имя, "ПЛАНОВ") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ак_ЭтоСчетНаОплатуОбъекта()
	
	ВидДокумента = Неопределено;
	Попытка
		ВидДокумента = ЭтотОбъект["ВидДокумента"];
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Если Строка(ВидДокумента.УникальныйИдентификатор()) = "a963c455-a1c9-11eb-b511-a7abe965c408" Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Имя = ВРег(СтрЗаменить(СокрЛП(Строка(ВидДокумента)), " ", ""));
	Возврат (СтрНайти(Имя, "СЧЕТ") > 0 Или СтрНайти(Имя, "СЧЁТ") > 0) И СтрНайти(Имя, "ОПЛАТ") > 0;
	
КонецФункции

Функция ак_ГрафикПлатежейЗаполнен()
	
	ТаблицаГрафика = Неопределено;
	Попытка
		ТаблицаГрафика = ЭтотОбъект["ГрафикПлатежей"];
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Если ТаблицаГрафика.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Для Каждого СтрокаГрафика Из ТаблицаГрафика Цикл
		СуммаСтроки = 0;
		Попытка
			СуммаСтроки = СтрокаГрафика.Сумма;
		Исключение
		КонецПопытки;
		Если СуммаСтроки = 0 Тогда
			Попытка
				СуммаСтроки = СтрокаГрафика.СуммаКОплате;
			Исключение
			КонецПопытки;
		КонецЕсли;
		ДатаСтроки = Дата(1, 1, 1);
		Попытка
			ДатаСтроки = СтрокаГрафика.ДатаПлатежа;
		Исключение
		КонецПопытки;
		Если СуммаСтроки > 0 И ЗначениеЗаполнено(ДатаСтроки) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ак_ЭтоИмяПолучателяОбъекта(ИмяРеквизита)
	
	Имя = ВРег(СтрЗаменить(СтрЗаменить(СокрЛП(Строка(ИмяРеквизита)), " ", ""), ".", ""));
	Возврат СтрНайти(Имя, "ПОЛУЧАТЕЛ") > 0
		Или СтрНайти(Имя, "КОНТРАГЕНТ") > 0
		Или СтрНайти(Имя, "КОРРЕСПОНДЕНТ") > 0
		Или СтрНайти(Имя, "АДРЕСАТ") > 0;
	
КонецФункции
