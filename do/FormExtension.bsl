#КонецОбласти

#Область ЛимитИСогласование

// Шаг 1. Перед записью: и счёт, и плановая — один запрос в CheckLimitsDO.
// Остаток 0 или минус = нет лимита.
// Плановая пишется всегда (уведомление). Счёт — только при лимите или СверхЛимит.
//
// Шаг 2. Кнопка «Отправить на согласование»: одна процедура для обоих видов.

&НаСервере
Функция ПроверитьЛимитДокументаВДО()
	
	ИмяСобытия = "ПроверитьЛимитВДО";
	РезультатПроверки = Новый Структура("ЕстьЛимит, СверхЛимит, ОшибкаОбмена, Сообщение",
		Ложь, Ложь, Ложь, "");
	РезультатПроверки.СверхЛимит = СверхЛимитДокумента();
	УстановитьПривилегированныйРежим(Истина);
	
	КодСтатьи = КодСтатьиДДС();
	Если Не ЗначениеЗаполнено(КодСтатьи) Тогда
		РезультатПроверки.Сообщение = "Не заполнена статья ДДС";
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Массив = СтрокиПроверкиЛимита();
	Если Массив.Количество() = 0 Тогда
		Если ЭтоПлановаяЗаявка() Тогда
			РезультатПроверки.Сообщение = "Не заполнена сумма";
		Иначе
			РезультатПроверки.Сообщение = "Не заполнен график платежей и сумма документа";
		КонецЕсли;
		Возврат РезультатПроверки;
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Лимит JSON=" + СтрокаJSON);
	
	Попытка
		Результат = ак_HTTPПостБП("/sah_buh_akea/hs/CheckLimitsDO/Ch", СтрокаJSON);
		ТелоОтвета = Результат.Тело;
	Исключение
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = "БП недоступна: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат РезультатПроверки;
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Лимит HTTP=" + Результат.Код + " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
	Если Результат.Код = 401 Или Результат.Код = 403 Тогда
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = "БП вернула " + Результат.Код
			+ " (нет доступа). Это не превышение лимита.";
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТелоОтвета) Тогда
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = "БП не вернула тело ответа (HTTP " + Результат.Код + ").";
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Если Результат.Код <> 200 Тогда
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = СообщениеИзТелаОтветаБП(ТелоОтвета,
			"Ошибка БП (HTTP " + Результат.Код + ")");
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON);
	Исключение
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = "БП вернула не JSON: " + Лев(ТелоОтвета, 400);
		Возврат РезультатПроверки;
	КонецПопытки;
	
	СтрокиЛимита = СтрокиЛимитаИзОтвета(Данные);
	Если СтрокиЛимита.Количество() = 0 Тогда
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = "БП вернула пустой ответ по лимиту.";
		Возврат РезультатПроверки;
	КонецЕсли;
	
	РезультатПроверки.ЕстьЛимит = Истина;
	Тексты = Новый Массив;
	
	Для Каждого СтрокаЛимита Из СтрокиЛимита Цикл
		
		Остаток = Неопределено;
		Если СтрокаЛимита.Свойство("remainder") И СтрокаЛимита.remainder <> Неопределено Тогда
			Остаток = ЧислоИзЗначенияЛимита(СтрокаЛимита.remainder);
		КонецЕсли;
		
		СтрокаОк = (СтрокаЛимита.Свойство("success") И СтрокаЛимита.success = Истина);
		Если Остаток <> Неопределено И Остаток <= 0 Тогда
			СтрокаОк = Ложь;
		КонецЕсли;
		Если Не СтрокаОк Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
		КонецЕсли;
		
		ТекстСтроки = ТекстЛимитаПоСтроке(СтрокаЛимита, СтрокаОк, Остаток);
		Если ЗначениеЗаполнено(ТекстСтроки) Тогда
			Тексты.Добавить(ТекстСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	РезультатПроверки.Сообщение = СтрСоединить(Тексты, Символы.ПС);
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция СтрокиПроверкиЛимита()
	
	Массив = Новый Массив;
	КодСтатьи = КодСтатьиДДС();
	
	Если Не ЭтоПлановаяЗаявка() Тогда
		Попытка
			Для Каждого ТекСтр Из Объект.ГрафикПлатежей Цикл
				Если ТекСтр.Сумма <= 0 Тогда
					Продолжить;
				КонецЕсли;
				СтрокаЗапроса = Новый Структура;
				СтрокаЗапроса.Вставить("СтатьяДДС", КодСтатьи);
				СтрокаЗапроса.Вставить("Сумма", ТекСтр.Сумма);
				ДатаСтроки = ТекСтр.ДатаПлатежа;
				Если Не ЗначениеЗаполнено(ДатаСтроки) Тогда
					ДатаСтроки = ДатаДокументаДляЛимита();
				КонецЕсли;
				СтрокаЗапроса.Вставить("ДатаПлатежа", Формат(ДатаСтроки, "ДФ=yyyyMMdd"));
				Массив.Добавить(СтрокаЗапроса);
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если Массив.Количество() = 0 Тогда
		Сумма = СуммаДокумента();
		Если Сумма > 0 Тогда
			СтрокаЗапроса = Новый Структура;
			СтрокаЗапроса.Вставить("СтатьяДДС", КодСтатьи);
			СтрокаЗапроса.Вставить("Сумма", Сумма);
			СтрокаЗапроса.Вставить("ДатаПлатежа", Формат(ДатаДокументаДляЛимита(), "ДФ=yyyyMMdd"));
			Массив.Добавить(СтрокаЗапроса);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Массив;
	
КонецФункции

&НаСервере
Функция ОтправитьНаСогласованиеВБП()
	
	ИмяСобытия = "ОтправитьНаСогласованиеВБП";
	РезультатВыгрузки = Новый Структура("Успех, Сообщение", Ложь, "");
	УстановитьПривилегированныйРежим(Истина);
	
	Плановая = ЭтоПлановаяЗаявка();
	СверхЛимит = СверхЛимитДокумента();
	
	ДокументJSON = Новый Структура;
	ДокументJSON.Вставить("ВидДокумента", ?(Плановая, "ПлановаяЗаявка", "СчетНаОплату"));
	ДокументJSON.Вставить("ПлановаяЗаявка", Плановая);
	ДокументJSON.Вставить("ИдентификаторДО", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	ДокументJSON.Вставить("Счет", Строка(Объект.Ссылка));
	ДокументJSON.Вставить("КодСчета", СокрЛП(Объект.Код));
	ДокументJSON.Вставить("РегистрационныйНомер", СокрЛП(Объект.РегистрационныйНомер));
	ДокументJSON.Вставить("ДатаРегистрации", Формат(ДатаДокументаДляЛимита(), "ДФ=yyyyMMdd"));
	ДокументJSON.Вставить("ДатаСозданияСчета", Формат(Объект.ДатаСоздания, "ДФ=yyyyMMdd"));
	ДокументJSON.Вставить("Заголовок", СокрЛП(Объект.Заголовок));
	ДокументJSON.Вставить("Тема", СокрЛП(Объект.Заголовок));
	ДокументJSON.Вставить("Сумма", СуммаДокумента());
	ДокументJSON.Вставить("СтатьяДДС", КодСтатьиДДС());
	ДокументJSON.Вставить("СтатьяДДСНаим", НаименованиеСтатьиДДС());
	ДокументJSON.Вставить("СверхЛимит", СверхЛимит);
	ДокументJSON.Вставить("Сверхлимит", СверхЛимит);
	ДокументJSON.Вставить("НазначениеПлатежа", НазначениеПлатежаДокумента());
	ДокументJSON.Вставить("Назначение", НазначениеПлатежаДокумента());
	ДокументJSON.Вставить("ОрганизацияИНН", ИННОрганизации());
	ДокументJSON.Вставить("КонтрагентНаим", Строка(Объект.Контрагент));
	Попытка
		ДокументJSON.Вставить("КонтрагентИНН", СокрЛП(Объект.Контрагент.ИНН));
	Исключение
		ДокументJSON.Вставить("КонтрагентИНН", "");
	КонецПопытки;
	Попытка
		ДокументJSON.Вставить("СуммаНДС", Объект.СуммаНДС);
	Исключение
		ДокументJSON.Вставить("СуммаНДС", 0);
	КонецПопытки;
	ДокументJSON.Вставить("Срок", Строка(Объект.СрокИсполнения));
	ДокументJSON.Вставить("ДатаОплаты", Формат(Объект.СрокИсполнения, "ДФ=yyyyMMdd"));
	ДокументJSON.Вставить("РегНомДоговор", "");
	ДокументJSON.Вставить("РегДатаДоговор", "");
	
	График = Новый Массив;
	Попытка
		Для Каждого ТекСтр Из Объект.ГрафикПлатежей Цикл
			СтрокаГрафика = Новый Структура;
			СтрокаГрафика.Вставить("ДатаПлатежа", Формат(ТекСтр.ДатаПлатежа, "ДФ=yyyyMMdd"));
			СтрокаГрафика.Вставить("Сумма", ТекСтр.Сумма);
			СтрокаГрафика.Вставить("Согласовано", ТекСтр.Согласовано);
			График.Добавить(СтрокаГрафика);
		КонецЦикла;
	Исключение
	КонецПопытки;
	ДокументJSON.Вставить("ГрафикПлатежей", График);
	
	Массив = Новый Массив;
	Массив.Добавить(ДокументJSON);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"JSON=" + Лев(СтрокаJSON, 2000));
	
	Попытка
		Результат = ак_HTTPПостБП("/sah_buh_akea/hs/ImportFromDO/Download", СтрокаJSON);
	Исключение
		РезультатВыгрузки.Сообщение = "Не удалось отправить в БП: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат РезультатВыгрузки;
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"HTTP=" + Результат.Код + " тело=" + Лев(Результат.Тело, 2000));
	
	Разбор = РазобратьОтветВыгрузкиБП(Результат);
	РезультатВыгрузки.Успех = Разбор.Успех;
	РезультатВыгрузки.Сообщение = Разбор.Сообщение;
	
	Если РезультатВыгрузки.Успех И Не ЗначениеЗаполнено(РезультатВыгрузки.Сообщение) Тогда
		Если Плановая Тогда
			РезультатВыгрузки.Сообщение = "Плановая заявка отправлена в БП на согласование.";
		Иначе
			РезультатВыгрузки.Сообщение = "Счёт отправлен в БП на согласование.";
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатВыгрузки;
	
КонецФункции

&НаСервере
Функция РазобратьОтветВыгрузкиБП(Результат)
	
	Разбор = Новый Структура("Успех, Сообщение", Ложь, "");
	
	Если Результат.Код = 401 Или Результат.Код = 403 Тогда
		Разбор.Сообщение = "БП вернула " + Результат.Код + " (нет доступа). Документ в БП не создан.";
		Возврат Разбор;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.Тело) Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Результат.Тело);
			Данные = ПрочитатьJSON(ЧтениеJSON);
			Если ТипЗнч(Данные) = Тип("Структура") Тогда
				Если Данные.Свойство("success") Тогда
					Разбор.Успех = (Данные.success = Истина);
				КонецЕсли;
				Если Данные.Свойство("message") И ЗначениеЗаполнено(Данные.message) Тогда
					Разбор.Сообщение = Строка(Данные.message);
				КонецЕсли;
			ИначеЕсли ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0
				И ТипЗнч(Данные[0]) = Тип("Структура") Тогда
				Если Данные[0].Свойство("success") Тогда
					Разбор.Успех = (Данные[0].success = Истина);
				КонецЕсли;
				Если Данные[0].Свойство("message") И ЗначениеЗаполнено(Данные[0].message) Тогда
					Разбор.Сообщение = Строка(Данные[0].message);
				КонецЕсли;
			КонецЕсли;
		Исключение
			Разбор.Сообщение = Лев(Результат.Тело, 400);
		КонецПопытки;
	КонецЕсли;
	
	Если Результат.Код <> 200 Тогда
		Разбор.Успех = Ложь;
		Если Не ЗначениеЗаполнено(Разбор.Сообщение) Тогда
			Разбор.Сообщение = "БП вернула HTTP " + Результат.Код;
		ИначеЕсли СтрНайти(Разбор.Сообщение, "HTTP") = 0 Тогда
			Разбор.Сообщение = "БП вернула HTTP " + Результат.Код + ": " + Разбор.Сообщение;
		КонецЕсли;
	ИначеЕсли Не ЗначениеЗаполнено(Результат.Тело) Тогда
		Разбор.Успех = Истина;
	КонецЕсли;
	
	Возврат Разбор;
	
КонецФункции

&НаСервере
Функция СтрокиЛимитаИзОтвета(Данные)
	
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Возврат Данные;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство("limits") И ТипЗнч(Данные.limits) = Тип("Массив") Тогда
			Возврат Данные.limits;
		КонецЕсли;
		Массив = Новый Массив;
		Массив.Добавить(Данные);
		Возврат Массив;
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

&НаСервере
Функция ТекстЛимитаПоСтроке(СтрокаЛимита, ЕстьЛимит, Остаток)
	
	ИмяСтатьи = НаименованиеСтатьиДДС();
	Если СтрокаЛимита.Свойство("articleName") И ЗначениеЗаполнено(СтрокаЛимита.articleName) Тогда
		ИмяСтатьи = Строка(СтрокаЛимита.articleName);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИмяСтатьи) И СтрокаЛимита.Свойство("articleCode") Тогда
		ИмяСтатьи = Строка(СтрокаЛимита.articleCode);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ИмяСтатьи) Тогда
		ИмяСтатьи = КодСтатьиДДС();
	КонецЕсли;
	
	Дефицит = Неопределено;
	Если СтрокаЛимита.Свойство("deficit") И СтрокаЛимита.deficit <> Неопределено Тогда
		Дефицит = ЧислоИзЗначенияЛимита(СтрокаЛимита.deficit);
	ИначеЕсли Остаток <> Неопределено И СтрокаЛимита.Свойство("requestAmount") Тогда
		Дефицит = Макс(0, ЧислоИзЗначенияЛимита(СтрокаЛимита.requestAmount) - Остаток);
	КонецЕсли;
	
	ТекстОстатка = ?(Остаток = Неопределено, "не получен", Формат(Остаток, "ЧДЦ=2; ЧН=0; ЧГ="));
	Текст = "По статье «" + ИмяСтатьи + "» остаток: " + ТекстОстатка + " руб.";
	Если Не ЕстьЛимит Тогда
		Если Дефицит <> Неопределено Тогда
			Текст = Текст + " Превышение: " + Формат(Дефицит, "ЧДЦ=2; ЧН=0; ЧГ=") + " руб.";
		Иначе
			Текст = Текст + " Лимит превышен.";
		КонецЕсли;
	КонецЕсли;
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция СообщениеИзТелаОтветаБП(ТелоОтвета, ТекстПоУмолчанию)
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("message") Тогда
			Возврат ТекстПоУмолчанию + ": " + Строка(Данные.message);
		КонецЕсли;
		Если ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0 Тогда
			Если ТипЗнч(Данные[0]) = Тип("Структура") И Данные[0].Свойство("message") Тогда
				Возврат ТекстПоУмолчанию + ": " + Строка(Данные[0].message);
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ТелоОтвета) Тогда
		Возврат ТекстПоУмолчанию + ": " + Лев(ТелоОтвета, 400);
	КонецЕсли;
	
	Возврат ТекстПоУмолчанию;
	
КонецФункции

