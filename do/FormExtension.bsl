			Объект.ДоговорОснование = РеквизитыОснования.ДоговорОснование;
			Постоплата = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию("Постоплата");
			ЭтаФорма.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_3FBE16C8x73E2x11EExBE26x3CECEF19F70B = Постоплата;
			ЭтаФорма.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_07731ADCx7715x11EExBE26x3CECEF19F70B = Основание;
		КонецЕсли;
	ИначеЕсли ДокОплатыИмя = "Постановление ГИБДД" Тогда
		Если ИдОснования = "e59c06a8-d5d4-11e8-ba8b-1831bfcd76a2" Тогда
			ЭтаФорма.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_327E52FAx73E2x11EExBE26x3CECEF19F70B = РеквизитыОснования.ИсходящаяДата;
			ЭтаФорма.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_035FCAAEx73E2x11EExBE26x3CECEF19F70B = РеквизитыОснования.ИсходящийНомер;
			СтатьяОплатаШтрафа = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоНаименованию("Оплата штрафа");
			НовСтрока = ЭтаФорма.СтатьиДвиженияДенежныхСредств.Добавить();
			НовСтрока.СтатьяДвиженияДенежныхСредств = СтатьяОплатаШтрафа;
			ЭтаФорма.ПредставлениеСтатейДДС = "Оплата штрафа";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ак_ЗаписатьСвязиДоговора(ТекущийОбъект)
	
	ИдВида = Строка(ТекущийОбъект.ВидДокумента.УникальныйИдентификатор());
	
	Если ЗначениеЗаполнено(ТекущийОбъект.ДоговорОснование) Тогда
		Если ЭтоПлановаяПоВиду(ТекущийОбъект.ДоговорОснование.ВидДокумента) Тогда
			Возврат;
		КонецЕсли;
		Если ИдВида = ИдЗаявкиНаОплату() Тогда
			СвязиДокументов.СоздатьСвязь(ТекущийОбъект.Ссылка, ТекущийОбъект.ДоговорОснование,
				Справочники.ТипыСвязей.НайтиПоНаименованию("Предмет оплаты"));
		Иначе
			СвязиДокументов.СоздатьСвязь(ТекущийОбъект.Ссылка, ТекущийОбъект.ДоговорОснование,
				Справочники.ТипыСвязей.НайтиПоНаименованию("Относится к договору"));
		КонецЕсли;
	КонецЕсли;
	
	Если ИдВида = ИдЗаявкиНаОплату() Тогда
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя",
			"ПодтверждающиеДокументы_2c5a8492d962457cb2fc21538f6800be");
		Если ЗначениеЗаполнено(Свойство) Тогда
			НайденныеСтроки = ТекущийОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", Свойство));
			Если НайденныеСтроки.Количество() > 0 Тогда
				СвязиДокументов.СоздатьСвязь(ТекущийОбъект.Ссылка, НайденныеСтроки[0].Значение,
					Справочники.ТипыСвязей.НайтиПоНаименованию("Имеет подтверждающие документы"));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

