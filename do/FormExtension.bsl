КонецФункции

&НаСервере
Функция ИдентификаторВидаДокументаСервер()
	Возврат Строка(Объект.ВидДокумента.УникальныйИдентификатор());
КонецФункции

&НаКлиенте
Функция ЭтоПлановаяЗаявкаКлиент()
	Возврат ИдентификаторВидаДокумента() = ИдПлановойЗаявки();
КонецФункции

&НаСервере
Функция ЭтоПлановаяЗаявка()
	Возврат ИдентификаторВидаДокументаСервер() = ИдПлановойЗаявки();
КонецФункции

&НаКлиенте
Функция ЭтоДокументДляВыгрузкиВБП()
	
	ИдВида = ИдентификаторВидаДокумента();
	Возврат ИдВида = ИдСчетаНаОплату() Или ИдВида = ИдПлановойЗаявки();
	
КонецФункции

#КонецОбласти

#Область ПередЗаписью

&НаКлиенте
Процедура ак_ПроверкиПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ИдВида = ИдентификаторВидаДокумента();
	
	Если ИдВида = ИдДоговораПокупки() Тогда
		Если Не ПроверитьЗаполнениеРеквизита(Объект.НомерДоговора, "НомерДоговора", "НомерДоговора", "Не заполнен номер договора") Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Если Не ПроверитьЗаполнениеРеквизита(Объект.ДатаНачалаДействия, "Дата начала действия", "СрокДействияСтрока",
			НСтр("ru = 'Не заполнена дата начала действия'")) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИдВида = ИдЗаявкиНаОплату() Тогда
		Если СтрНайти(ЭтаФорма.ПредставлениеСтатейДДС, "Оплата товара") > 0 Тогда
			Если ЭтаФорма.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_5723C084x76EBx11EExBE26x3CECEF19F70B = "" Тогда
				Сообщить("Не заполнена статья ДДС - оплата товара");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		Иначе
			Элементы.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_5723C084x76EBx11EExBE26x3CECEF19F70B.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ИдВида <> ИдСчетаНаОплату() И ИдВида <> ИдПлановойЗаявки() Тогда
		Возврат;
	КонецЕсли;
	
	Проверка = ПроверитьЛимитДокументаВДО();
	Если ЗначениеЗаполнено(Проверка.Сообщение) Тогда
		Сообщить(Проверка.Сообщение);
		ПоказатьОповещениеПользователя("Лимит по статье", , Проверка.Сообщение);
	КонецЕсли;
	
	// Плановая: пишем всегда, даже при 0 / минусе. Только уведомление.
	Если ИдВида = ИдПлановойЗаявки() Тогда
		Возврат;
	КонецЕсли;
	
	// Счёт: без лимита не пишем, пока не сменят статью или не поставят сверхлимит.
	Если Не Проверка.ЕстьЛимит И Не Проверка.СверхЛимит Тогда
		Отказ = Истина;
		ак_ОставитьКнопкуСогласованияДоступной();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ак_ОставитьКнопкуСогласованияДоступной()
	
	Если Элементы.Найти("Зарегистрировать") <> Неопределено Тогда
		Элементы.Зарегистрировать.Доступность = Истина;
	КонецЕсли;
	Если Элементы.Найти("ОтправитьОбъекты") <> Неопределено Тогда
		Элементы.ОтправитьОбъекты.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОформлениеФормы

&НаСервере
Процедура ак_НастроитьВидДокументаНаСервере()
	
	ИдВида = ИдентификаторВидаДокументаСервер();
	
	ЭтоСчет = (ИдВида = ИдСчетаНаОплату())
		Или ВРег(СокрЛП(Строка(Объект.ВидДокумента))) = ВРег("Счёт на оплату")
		Или ВРег(СокрЛП(Строка(Объект.ВидДокумента))) = ВРег("Счет на оплату");
	
	Если Элементы.Найти("ГруппаГрафик") <> Неопределено Тогда
		Элементы.ГруппаГрафик.Видимость = ЭтоСчет;
	КонецЕсли;
	Если Элементы.Найти("ГрафикПлатежей") <> Неопределено Тогда
		Элементы.ГрафикПлатежей.Видимость = ЭтоСчет;
	КонецЕсли;
	
	Если ИдВида = ИдДоговораПокупки() Тогда
		Если Элементы.Найти("НомерДоговора") <> Неопределено Тогда
			Элементы.НомерДоговора.Видимость = Истина;
			Элементы.НомерДоговора.АвтоОтметкаНезаполненного = Истина;
		КонецЕсли;
		Если Элементы.Найти("СрокДействияСтрока") <> Неопределено Тогда
			Элементы.СрокДействияСтрока.АвтоОтметкаНезаполненного = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.Найти("Группа1") <> Неопределено Тогда
		Элементы.Группа1.Видимость = (ИдВида = "75e95c00-4bae-11ed-be17-3cecef19f70b" Или ИдВида = ИдЗаявкиНаОплату());
	КонецЕсли;
	
	Если Элементы.Найти("дор_Основание") <> Неопределено Тогда
		ЯвляетсяЗаявкой = Ложь;
		Попытка
			ЯвляетсяЗаявкой = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВидДокумента, "ЯвляетсяЗаявкойНаОплату");
		Исключение
		КонецПопытки;
		Элементы.дор_Основание.Видимость = (ЯвляетсяЗаявкой = Истина);
	КонецЕсли;
	
	Если Элементы.Найти("Тематика") <> Неопределено
		И ВРег(СокрЛП(Строка(Объект.ВидДокумента))) <> ВРег("Служебная записка") Тогда
		Элементы.Тематика.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ак_НастроитьОснованиеЗаявки()
	
	Попытка
		дор_СписокОснований.Добавить("Счет-договор");
		дор_СписокОснований.Добавить("Счет на договор");
	Исключение
	КонецПопытки;
	
	Если ИдентификаторВидаДокументаСервер() <> ИдЗаявкиНаОплату() Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.Найти("Содержание") <> Неопределено Тогда
		Элементы.Содержание.ПодсказкаВвода = "Обоснование оплаты";
	КонецЕсли;
	
	ОснованиеДокумента = Неопределено;
	Если ТипЗнч(Параметры.Основание) = Тип("Структура") Тогда
		ОснованиеДокумента = Параметры.Основание.Основание;
	Иначе
		ОснованиеДокумента = Параметры.Основание;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОснованиеДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ИдОснования = Строка(ОснованиеДокумента.ВидДокумента.УникальныйИдентификатор());
	Если ИдОснования = "75e95c00-4bae-11ed-be17-3cecef19f70b"
		Или ИдОснования = "42ccd785-1deb-11ed-be16-3cecef19f70b" Тогда
		Объект.ДоговорОснование = ОснованиеДокумента.ДоговорОснование;
		Если Не ЗначениеЗаполнено(Объект.ДоговорОснование) Тогда
			Объект.БезДоговора = Истина;
		КонецЕсли;
	ИначеЕсли ИдОснования = "e59c06a8-d5d4-11e8-ba8b-1831bfcd76a2" Тогда
		Получатель = ОснованиеДокумента.Отправитель;
		Объект.БезДоговора = Истина;
	ИначеЕсли ИдОснования = ИдДоговораПокупки()
		Или ИдОснования = "e59c063f-d5d4-11e8-ba8b-1831bfcd76a2"
		Или ИдОснования = "57f42d41-03b1-11e9-8dab-ac1f6bb07cf7" Тогда
		Объект.ДоговорОснование = ОснованиеДокумента;
		Если Не ЗначениеЗаполнено(Объект.ДоговорОснование) Тогда
			Объект.БезДоговора = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ак_ДобавитьКомандыФормы()
	
	ак_ДобавитьКомандуЕслиНет("СкопироватьСвязанныеФайлы", "СкопироватьСвязанныеФайлы", "ГруппаКоманды", "КнопкаВКонце2");
	ак_ДобавитьКомандуЕслиНет("ОтправитьРаспознать", "ОтправитьРаспознать", "ГруппаОсновнаяКомПанель", "КнопкаВКонце4");
	ак_ДобавитьКомандуЕслиНет("ПроверитьРеквизитыРаспознанного", "ПроверитьРеквизитыРаспознанного", "ГруппаОсновнаяКомПанель", "КнопкаВКонце5");
	
	КБК = "";
	НазначениеПлатежа = "";
	Попытка
		КБК = СокрЛП(УправлениеСвойствами.ЗначениеСвойства(Объект.Ссылка,
			ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("КБК")));
		НазначениеПлатежа = СокрЛП(УправлениеСвойствами.ЗначениеСвойства(Объект.Ссылка,
			ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Назначение платежа")));
	Исключение
	КонецПопытки;
	Если ЗначениеЗаполнено(КБК) Или ЗначениеЗаполнено(НазначениеПлатежа) Тогда
		ак_ДобавитьКомандуЕслиНет("СоздатьПлатежку", "СоздатьПлатежку", "ГруппаОсновнаяКомПанель", "КнопкаВКонце3");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ак_ДобавитьКомандуЕслиНет(ИмяКоманды, ЗаголовокКоманды, ИмяГруппы, ИмяКнопки)
	
	Если Команды.Найти(ИмяКоманды) = Неопределено Тогда
		НоваяКоманда = Команды.Добавить(ИмяКоманды);
		НоваяКоманда.Действие = ИмяКоманды;
		НоваяКоманда.Заголовок = ЗаголовокКоманды;
	КонецЕсли;
	Если Элементы.Найти(ИмяКнопки) = Неопределено И Элементы.Найти(ИмяГруппы) <> Неопределено Тогда
		НоваяКнопка = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), Элементы[ИмяГруппы]);
		НоваяКнопка.ИмяКоманды = ИмяКоманды;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДопРеквизитыИСвязи

&НаКлиенте
Процедура ПриИзмененииДокОплаты(ДокОплатыИмя)
	
	ПриИзмененииДокОплатыНаСервере(ДокОплатыИмя);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииДокОплатыНаСервере(ДокОплатыИмя)
	
	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат;
	КонецЕсли;
	
	ВидОснования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Основание, "ВидДокумента");
	ИдОснования = Строка(ВидОснования.УникальныйИдентификатор());
	РеквизитыОснования = Новый Структура("БезДоговора, ДоговорОснование, ИсходящаяДата, ИсходящийНомер");
	Попытка
		РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание,
			"БезДоговора, ДоговорОснование, ИсходящаяДата, ИсходящийНомер");
	Исключение
		Попытка
			РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "БезДоговора, ДоговорОснование");
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Если ДокОплатыИмя = "Счет на оплату" Тогда
		Если ИдОснования = "75e95c00-4bae-11ed-be17-3cecef19f70b"
			Или ИдОснования = "42ccd785-1deb-11ed-be16-3cecef19f70b" Тогда
			Постоплата = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию("Постоплата");
			ЭтаФорма.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_3FBE16C8x73E2x11EExBE26x3CECEF19F70B = Постоплата;
			ЭтаФорма.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_07731ADCx7715x11EExBE26x3CECEF19F70B = Основание;
		КонецЕсли;
	ИначеЕсли ДокОплатыИмя = "Договор" Тогда
		Если ИдОснования = ИдДоговораПокупки()
			Или ИдОснования = "e59c063f-d5d4-11e8-ba8b-1831bfcd76a2"
			Или ИдОснования = "57f42d41-03b1-11e9-8dab-ac1f6bb07cf7" Тогда
			Объект.ДоговорОснование = Основание;
		КонецЕсли;
	ИначеЕсли ДокОплатыИмя = "Счет-договор" Тогда
		Если ИдОснования = "75e95c00-4bae-11ed-be17-3cecef19f70b"
			Или ИдОснования = "42ccd785-1deb-11ed-be16-3cecef19f70b" Тогда
