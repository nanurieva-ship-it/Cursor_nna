// =============================================================================
// Расширение формы Справочник.ВнутренниеДокументы.ФормаЭлемента (САХ)
//
// Только аннотации &Перед / &После / &Вместо + свои процедуры.
// Типовой код формы сюда не копировать. После своих проверок — ПродолжитьВызов.
//
// Не вставлять сюда модуль HTTP-сервиса CheckLimitsDO — он живёт в БП.
//
// Виды:
//   Счёт на оплату     a963c455-a1c9-11eb-b511-a7abe965c408
//   Плановая заявка    0f8f6296-ba4a-11f1-a615-9c69b465b0dd
//   Заявка на оплату   361540bf-73d5-11ee-be26-3cecef19f70b
//   Договор покупки    9c1af875-01c4-11e9-8dab-ac1f6bb07cf7
// =============================================================================

#Область Аннотации

&НаКлиенте
&Вместо("Подключаемый_ПриИзмененииДополнительногоРеквизита")
Процедура ак_Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	
	ПродолжитьВызов(Элемент);
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
	
	Если Элемент.Имя = "ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_30A02316x73E1x11EExBE26x3CECEF19F70B" Тогда
		ПриИзмененииДокОплаты(Элемент.ВыделенныйТекст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
&Перед("ПриСозданииНаСервере")
Процедура ак_ПриСозданииНаСервереПеред(Отказ, СтандартнаяОбработка)
	
	Элементы.ОтправитьОбъекты.Доступность = Ложь;
	Элементы.Зарегистрировать.Заголовок = "Отправить на согласование";
	
КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура ак_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ак_НастроитьОснованиеЗаявки();
	ак_ДобавитьКомандыФормы();
	ак_НастроитьВидДокументаНаСервере();
	
КонецПроцедуры

&НаСервере
&После("ПриИзмененииВидаДокумента")
Процедура ак_ПриИзмененииВидаДокументаПосле()
	
	ак_НастроитьВидДокументаНаСервере();
	
КонецПроцедуры

&НаКлиенте
&Вместо("ПередЗаписью")
Процедура ак_ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ак_ПроверкиПередЗаписью(Отказ, ПараметрыЗаписи);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВызов(Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
&После("ПриЗаписиНаСервере")
Процедура ак_ПриЗаписиНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ак_ЗаписатьСвязиДоговора(ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
&После("Зарегистрировать")
Процедура ак_ЗарегистрироватьПосле(Команда)
	
	Если Не ЭтоДокументДляВыгрузкиВБП() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ОтправитьНаСогласованиеВБП();
	Если Результат.Успех Тогда
		УстановитьСостояниеНаСогласовании();
	Иначе
		ак_ОставитьКнопкуСогласованияДоступной();
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат.Сообщение) Тогда
		ПоказатьПредупреждение(, Результат.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВидыДокументов

&НаКлиентеНаСервереБезКонтекста
Функция ИдСчетаНаОплату()
	Возврат "a963c455-a1c9-11eb-b511-a7abe965c408";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИдПлановойЗаявки()
	Возврат "0f8f6296-ba4a-11f1-a615-9c69b465b0dd";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИдЗаявкиНаОплату()
	Возврат "361540bf-73d5-11ee-be26-3cecef19f70b";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИдДоговораПокупки()
	Возврат "9c1af875-01c4-11e9-8dab-ac1f6bb07cf7";
КонецФункции

&НаКлиенте
Функция ИдентификаторВидаДокумента()
