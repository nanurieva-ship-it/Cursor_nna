&НаКлиентеНаСервереБезКонтекста
Функция ИдВидаДокументаИзСсылки(ВидДокумента)
	
	Попытка
		Если ЗначениеЗаполнено(ВидДокумента) Тогда
			Возврат Строка(ВидДокумента.УникальныйИдентификатор());
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПлановаяПоВиду(ВидДокумента)
	
	ИдВида = ИдВидаДокументаИзСсылки(ВидДокумента);
	Если ИдВида = ИдПлановойЗаявки() Тогда
		Возврат Истина;
	КонецЕсли;
	Имя = ВРег(СокрЛП(Строка(ВидДокумента)));
	Возврат СтрНайти(Имя, "ПЛАНОВ") > 0;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоСчетПоВиду(ВидДокумента)
	
	ИдВида = ИдВидаДокументаИзСсылки(ВидДокумента);
	Если ИдВида = ИдСчетаНаОплату() Тогда
		Возврат Истина;
	КонецЕсли;
	Имя = ВРег(СокрЛП(Строка(ВидДокумента)));
	Возврат СтрНайти(Имя, "СЧЕТ НА ОПЛАТ") > 0 Или СтрНайти(Имя, "СЧЁТ НА ОПЛАТ") > 0;
	
КонецФункции

