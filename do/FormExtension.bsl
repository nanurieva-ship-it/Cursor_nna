&НаСервере
Процедура ак_НастроитьПолеНазначения()
	
	Если Не ЭтоПлановаяПоВиду(Объект.ВидДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ак_ДобавитьСлужебныеРеквизитыФормы();
	ак_ПрочитатьНазначениеВРеквизитФормы();
	ак_ДобавитьПолеНазначенияНаФорму();
	
КонецПроцедуры

&НаСервере
Процедура ак_ПрочитатьНазначениеВРеквизитФормы()
	
	Попытка
		Если ЗначениеЗаполнено(ЭтотОбъект.ак_НазначениеПлатежа) Тогда
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	
	ЭтотОбъект.ак_НазначениеПлатежа = НазначениеИзДокументаДО(Объект);
	
КонецПроцедуры

&НаСервере
Процедура ак_ДобавитьПолеНазначенияНаФорму()
	
	ЭлементКомментарий = Элементы.Найти("Комментарий");
	Родитель = Неопределено;
	ЭлементПослеКомментария = Неопределено;
	Если ЭлементКомментарий <> Неопределено Тогда
		Попытка
			Родитель = ЭлементКомментарий.Родитель;
		Исключение
		КонецПопытки;
		Если Родитель <> Неопределено Тогда
			ЭлементПослеКомментария = СледующийЭлементПосле(Родитель, ЭлементКомментарий);
		КонецЕсли;
	КонецЕсли;
	Если Родитель = Неопределено Или ЭтоКореньИлиСтраницаФормы(Родитель) Тогда
		Родитель = ГруппаЛевойКолонкиРеквизитов();
		ЭлементПослеКомментария = Неопределено;
	КонецЕсли;
	Если Родитель = Неопределено Тогда
		Родитель = ЭлементКомментарий;
	КонецЕсли;
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Поле = Элементы.Найти("ак_Назначение");
	Если Поле = Неопределено Тогда
		Поле = Элементы.Добавить("ак_Назначение", Тип("ПолеФормы"), Родитель);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = "ак_НазначениеПлатежа";
	КонецЕсли;
	
	Поле.Видимость = Истина;
	Поле.Доступность = Истина;
	Поле.Заголовок = "Назначение";
	Поле.АвтоМаксимальнаяШирина = Ложь;
	Попытка
		Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
		Поле.МногострочныйРежим = Истина;
		Поле.ПодсказкаВвода = "Назначение платежа";
		Поле.РастягиватьПоГоризонтали = Истина;
		Поле.РастягиватьПоВертикали = Ложь;
		Поле.Высота = 2;
	Исключение
	КонецПопытки;
	
	Попытка
		Элементы.Переместить(Поле, Родитель, ЭлементПослеКомментария);
	Исключение
		Попытка
			Элементы.Переместить(Поле, Родитель);
		Исключение
		КонецПопытки;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ЭтоКореньИлиСтраницаФормы(Группа)
	
	Если Группа = Неопределено Или Группа = ЭтаФорма Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Если Группа.Вид = ВидГруппыФормы.Страницы Или Группа.Вид = ВидГруппыФормы.Страница Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Имя = ВРег(Строка(Группа.Имя));
	Возврат СтрНайти(Имя, "СТРАНИЦ") > 0 Или Имя = "РЕКВИЗИТЫ";
	
КонецФункции

&НаСервере
Функция СледующийЭлементПосле(Родитель, ЭлементОриентир)
	
	Нашли = Ложь;
	Попытка
		Для Каждого Подчиненный Из Родитель.ПодчиненныеЭлементы Цикл
			Если Нашли И Подчиненный.Имя <> "ак_Назначение" Тогда
				Возврат Подчиненный;
			КонецЕсли;
			Если Подчиненный = ЭлементОриентир Или Подчиненный.Имя = ЭлементОриентир.Имя Тогда
				Нашли = Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ГруппаЛевойКолонкиРеквизитов()
	
	Для Каждого ИмяГруппы Из СтрРазделить("ГруппаРеквизитыЛево,ГруппаЛеваяКолонка,ЛеваяКолонка,ГруппаОсновныеРеквизиты,ГруппаШапкаЛево", ",", Ложь) Цикл
		Группа = Элементы.Найти(ИмяГруппы);
		Если Группа <> Неопределено Тогда
			Возврат Группа;
		КонецЕсли;
	КонецЦикла;
	
	ЭлементКомментарий = Элементы.Найти("Комментарий");
	Если ЭлементКомментарий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат ЭлементКомментарий.Родитель;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура ак_ЗаписатьНазначениеВОбъект(ТекущийОбъект)
	
	Текст = "";
	Попытка
		Текст = СокрЛП(Строка(ЭтотОбъект.ак_НазначениеПлатежа));
	Исключение
		Возврат;
	КонецПопытки;
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("НазначениеПлатежа,Назначение,Назаначение", ",", Ложь) Цикл
		Попытка
			ТекущийОбъект[ИмяРеквизита] = Текст;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Назначение платежа");
		Если ЗначениеЗаполнено(Свойство) Тогда
			Записано = Ложь;
			Для Каждого СтрокаСвойства Из ТекущийОбъект.ДополнительныеРеквизиты Цикл
				Если СтрокаСвойства.Свойство = Свойство Тогда
					СтрокаСвойства.Значение = Текст;
					Записано = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Записано Тогда
				НоваяСтрока = ТекущийОбъект.ДополнительныеРеквизиты.Добавить();
				НоваяСтрока.Свойство = Свойство;
				НоваяСтрока.Значение = Текст;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ак_ЗаполнитьНазначениеСчетаИзПлановой()
	
	Если Не ЭтоСчетПоВиду(Объект.ВидДокумента) Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(НазначениеИзДокументаДО(Объект)) Тогда
		Возврат;
	КонецЕсли;
	
	ОснованиеДокумента = ОснованиеИзПараметровФормы();
	Если Не ЗначениеЗаполнено(ОснованиеДокумента) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЭтоПлановаяПоВиду(ОснованиеДокумента.ВидДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстНазначения = НазначениеИзДокументаДО(ОснованиеДокумента);
	Если Не ЗначениеЗаполнено(ТекстНазначения) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Объект.НазначениеПлатежа = ТекстНазначения;
	Исключение
	КонецПопытки;
	Попытка
		Если Не ЗначениеЗаполнено(Объект.Содержание) Тогда
			Объект.Содержание = ТекстНазначения;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция НазначениеИзДокументаДО(ДокументДанные)
	
	Если ДокументДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из СтрРазделить("НазначениеПлатежа,Назначение,Назаначение", ",", Ложь) Цикл
		Попытка
			Текст = СокрЛП(Строка(ДокументДанные[ИмяРеквизита]));
			Если ЗначениеЗаполнено(Текст) Тогда
				Возврат Текст;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		СсылкаДокумента = ДокументДанные.Ссылка;
		Если ЗначениеЗаполнено(СсылкаДокумента) Тогда
			Текст = СокрЛП(Строка(УправлениеСвойствами.ЗначениеСвойства(СсылкаДокумента,
				ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Назначение платежа"))));
			Если ЗначениеЗаполнено(Текст) Тогда
				Возврат Текст;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ИННОрганизации()
	
	Попытка
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			Возврат СокрЛП(Объект.Организация.ИНН);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция ЭтоЗаписьБезПроверкиЛимита(ПараметрыЗаписи)
	
	Если ак_ФлагРегистрацииУстановлен() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыЗаписи) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИменаФлагов = СтрРазделить("ак_БезПроверкиЛимита,Регистрация,ЭтоРегистрация,РежимРегистрации", ",", Ложь);
	Для Каждого ИмяФлага Из ИменаФлагов Цикл
		ЗначениеФлага = Неопределено;
		Если ПараметрыЗаписи.Свойство(ИмяФлага, ЗначениеФлага) И ЗначениеФлага = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
