#Область ПередЗаписью

&НаКлиенте
Процедура ак_ПроверкиПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ИдВида = ИдентификаторВидаДокумента();
	
	Если ИдВида = ИдДоговораПокупки() Тогда
		Если Не ПроверитьЗаполнениеРеквизита(Объект.НомерДоговора, "НомерДоговора", "НомерДоговора", "Не заполнен номер договора") Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		Если Не ПроверитьЗаполнениеРеквизита(Объект.ДатаНачалаДействия, "Дата начала действия", "СрокДействияСтрока",
			НСтр("ru = 'Не заполнена дата начала действия'")) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИдВида = ИдЗаявкиНаОплату() Тогда
		Если СтрНайти(ЭтаФорма.ПредставлениеСтатейДДС, "Оплата товара") > 0 Тогда
			Если ЭтаФорма.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_5723C084x76EBx11EExBE26x3CECEF19F70B = "" Тогда
				Сообщить("Не заполнена статья ДДС - оплата товара");
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		Иначе
			Элементы.ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_5723C084x76EBx11EExBE26x3CECEF19F70B.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоПлановая = ЭтоПлановаяПоВиду(Объект.ВидДокумента);
	ЭтоСчет = ЭтоСчетПоВиду(Объект.ВидДокумента);
	Если Не ЭтоПлановая И Не ЭтоСчет Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоПлановая И Не ЗначениеЗаполнено(СрокИсполненияДокумента()) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для плановой заявки заполните срок. В БП это будет запланированная дата в графике платежей.";
		Сообщение.Поле = "Объект.СрокИсполнения";
		Сообщение.Сообщить();
		ПоказатьПредупреждение(, Сообщение.Текст);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЭтоСчет Тогда
		ПроверкаОснования = ПроверитьПлановуюОснованиеСчета();
		Если Не ПроверкаОснования.Можно Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ПроверкаОснования.Сообщение;
			Сообщение.Сообщить();
			ПоказатьПредупреждение(, ПроверкаОснования.Сообщение);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоЗаписьБезПроверкиЛимита(ПараметрыЗаписи) Тогда
		Возврат;
	КонецЕсли;
	
	ЛимитУжеПоказан = Ложь;
	Если ТипЗнч(ПараметрыЗаписи) = Тип("Структура") Тогда
		Если ПараметрыЗаписи.Свойство("ак_ЛимитПоказан") Тогда
			ЛимитУжеПоказан = (ПараметрыЗаписи.ак_ЛимитПоказан = Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если ЛимитУжеПоказан Тогда
		Возврат;
	КонецЕсли;
	
	Проверка = Неопределено;
	Попытка
		Проверка = ПроверитьЛимитДокументаВДО();
	Исключение
		Проверка = Новый Структура("ЕстьЛимит, СверхЛимит, ОшибкаОбмена, Сообщение",
			Ложь, Ложь, Истина, "Не удалось проверить лимит: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ТекстЛимита = Проверка.Сообщение;
	Если Не ЗначениеЗаполнено(ТекстЛимита) Тогда
		ТекстЛимита = "Не удалось получить остаток по статье.";
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыЗаписи) = Тип("Структура") Тогда
		ПараметрыЗаписи.Вставить("ак_ТекстЛимита", ТекстЛимита);
	КонецЕсли;
	
	СообщениеЛимита = Новый СообщениеПользователю;
	СообщениеЛимита.Текст = ТекстЛимита;
	СообщениеЛимита.Сообщить();
	
	// Счёт без лимита и без «сверхлимит» — не пишем.
	Если ЭтоСчет И Не Проверка.ЕстьЛимит И Не Проверка.СверхЛимит Тогда
		Отказ = Истина;
		ак_ОставитьКнопкуСогласованияДоступной();
		ПоказатьПредупреждение(, ТекстЛимита);
		Возврат;
	КонецЕсли;
	
	// Плановая пишется всегда. Счёт с лимитом — тоже. Сначала показываем остаток.
	Отказ = Истина;
	ПараметрыПродолжения = ПараметрыЗаписи;
	Если ТипЗнч(ПараметрыПродолжения) <> Тип("Структура") Тогда
		ПараметрыПродолжения = Новый Структура;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ак_ПродолжитьЗаписьПослеЛимита", ЭтотОбъект, ПараметрыПродолжения);
	ПоказатьПредупреждение(Оповещение, ТекстЛимита);
	
КонецПроцедуры

&НаКлиенте
Процедура ак_ПродолжитьЗаписьПослеЛимита(ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	ДополнительныеПараметры.Вставить("ак_ЛимитПоказан", Истина);
	Записать(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Функция СрокИсполненияДокумента()
	
	Попытка
		Если ЗначениеЗаполнено(Объект.СрокИсполнения) Тогда
			Возврат Объект.СрокИсполнения;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Дата(1, 1, 1);
	
КонецФункции

&НаКлиенте
Процедура ак_ОставитьКнопкуСогласованияДоступной()
	
	Если Элементы.Найти("Зарегистрировать") <> Неопределено Тогда
		Элементы.Зарегистрировать.Доступность = Истина;
	КонецЕсли;
	Если Элементы.Найти("ОтправитьОбъекты") <> Неопределено Тогда
		Элементы.ОтправитьОбъекты.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ак_ОтправитьНаСогласованиеПослеРегистрации()
	
	Если Не ЭтоДокументДляВыгрузкиВБП() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "Сначала запишите документ.");
		Возврат;
	КонецЕсли;
	
	Результат = ОтправитьНаСогласованиеВБП();
	Если Результат.Успех Тогда
		УстановитьСостояниеНаСогласовании();
		ПоказатьПредупреждение(, "Ваша заявка отправлена на согласование");
	Иначе
		ак_ОставитьКнопкуСогласованияДоступной();
		Текст = Результат.Сообщение;
		Если Не ЗначениеЗаполнено(Текст) Тогда
			Текст = "Не удалось отправить заявку на согласование в БП.";
		КонецЕсли;
		ПоказатьПредупреждение(, Текст);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОформлениеФормы

&НаСервере
Процедура ак_НастроитьВидДокументаНаСервере()
	
	ИдВида = ИдентификаторВидаДокументаСервер();
	
	ЭтоСчет = ЭтоСчетПоВиду(Объект.ВидДокумента);
	
	Если Элементы.Найти("ГруппаГрафик") <> Неопределено Тогда
		Элементы.ГруппаГрафик.Видимость = ЭтоСчет;
	КонецЕсли;
	Если Элементы.Найти("ГрафикПлатежей") <> Неопределено Тогда
		Элементы.ГрафикПлатежей.Видимость = ЭтоСчет;
	КонецЕсли;
	
	ЭтоПлановая = ЭтоПлановаяПоВиду(Объект.ВидДокумента);
	Если Элементы.Найти("СрокИсполнения") <> Неопределено Тогда
		Элементы.СрокИсполнения.Видимость = ЭтоПлановая Или ЭтоСчет;
		Элементы.СрокИсполнения.Доступность = Истина;
		Элементы.СрокИсполнения.АвтоОтметкаНезаполненного = ЭтоПлановая;
		Элементы.СрокИсполнения.ОтметкаНезаполненного = ЭтоПлановая И Не ЗначениеЗаполнено(Объект.СрокИсполнения);
	КонецЕсли;
	
	Если ИдВида = ИдДоговораПокупки() Тогда
		Если Элементы.Найти("НомерДоговора") <> Неопределено Тогда
			Элементы.НомерДоговора.Видимость = Истина;
			Элементы.НомерДоговора.АвтоОтметкаНезаполненного = Истина;
		КонецЕсли;
		Если Элементы.Найти("СрокДействияСтрока") <> Неопределено Тогда
			Элементы.СрокДействияСтрока.АвтоОтметкаНезаполненного = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.Найти("Группа1") <> Неопределено Тогда
