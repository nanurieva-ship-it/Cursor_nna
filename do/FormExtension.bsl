&НаСервере
Функция ПлановаяДокументСогласован(ДокументСсылка)
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Найденные = Новый Массив;
	
	Попытка
		СобратьСостоянияВМассив(Делопроизводство.ПолучитьСостоянияДокумента(ДокументСсылка), Найденные);
	Исключение
	КонецПопытки;
	
	Попытка
		СобратьСостоянияВМассив(Делопроизводство.ПолучитьСводкуПоСостояниюДокумента(ДокументСсылка), Найденные);
	Исключение
	КонецПопытки;
	
	ДобавитьСостоянияИзРегистров(ДокументСсылка, Найденные);
	
	Для Каждого Состояние Из Найденные Цикл
		Если ЭтоСостояниеСогласован(Состояние) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации("ПлановаяЗаявкаДО", УровеньЖурналаРегистрации.Предупреждение, , ДокументСсылка,
		"Плановая не распознана как согласованная. Состояния=[" + СтрСоединить(НайденныеСтроками(Найденные), "; ") + "]");
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура СобратьСостоянияВМассив(Значение, Найденные)
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			СобратьСостоянияВМассив(Элемент, Найденные);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Значение Цикл
			СобратьСостоянияВМассив(КлючИЗначение.Значение, Найденные);
			Если ТипЗначения = Тип("Структура") И ВРег(Строка(КлючИЗначение.Ключ)) = "СОСТОЯНИЕ" Тогда
				Найденные.Добавить(КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	Найденные.Добавить(Значение);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСостоянияИзРегистров(ДокументСсылка, Найденные)
	
	Тексты = Новый Массив;
	Тексты.Добавить(
	"ВЫБРАТЬ
	|	ТекущиеСостоянияДокументов.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ТекущиеСостоянияДокументов КАК ТекущиеСостоянияДокументов
	|ГДЕ
	|	ТекущиеСостоянияДокументов.Документ = &Документ");
	Тексты.Добавить(
	"ВЫБРАТЬ
	|	СостоянияДокументов.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.СостоянияДокументов КАК СостоянияДокументов
	|ГДЕ
	|	СостоянияДокументов.Документ = &Документ");
	Тексты.Добавить(
	"ВЫБРАТЬ
	|	ИсторияСостоянийДокументов.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ИсторияСостоянийДокументов КАК ИсторияСостоянийДокументов
	|ГДЕ
	|	ИсторияСостоянийДокументов.Документ = &Документ");
	
	Для Каждого ТекстЗапроса Из Тексты Цикл
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("Документ", ДокументСсылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Найденные.Добавить(Выборка.Состояние);
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайденныеСтроками(Найденные)
	
	Строки = Новый Массив;
	Для Каждого Элемент Из Найденные Цикл
		Строки.Добавить(Строка(ТипЗнч(Элемент)) + ":" + Строка(Элемент));
	КонецЦикла;
	Возврат Строки;
	
КонецФункции

&НаСервере
Функция ЭтоСостояниеСогласован(Состояние)
	
	Если Состояние = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Если Состояние = Перечисления.СостоянияДокументов.Согласован Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Если Состояние = Перечисления.СостоянияДокументов.Утвержден Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Если ТипЗнч(Состояние) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Состояние.Свойство("Состояние", Значение) Тогда
			Возврат ЭтоСостояниеСогласован(Значение);
		КонецЕсли;
	КонецЕсли;
	
	Имя = ВРег(СокрЛП(Строка(Состояние)));
	Имя = СтрЗаменить(Имя, "Ё", "Е");
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(Имя, "НА СОГЛАСОВАНИ") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Имя = "СОГЛАСОВАН"
		Или Имя = "СОГЛАСОВАНА"
		Или СтрНачинаетсяС(Имя, "СОГЛАСОВАН")
		Или СтрНайти(Имя, "УТВЕРЖДЕН") > 0;
	
КонецФункции

&НаСервере
Функция ТипСвязиИлиНаименование(ИмяТипа)
	
	ТипСвязи = Справочники.ТипыСвязей.НайтиПоНаименованию(ИмяТипа);
	Если ЗначениеЗаполнено(ТипСвязи) Тогда
		Возврат ТипСвязи;
	КонецЕсли;
	Возврат Справочники.ТипыСвязей.НайтиПоНаименованию("Предмет оплаты");
	
КонецФункции

&НаСервере
Процедура ак_ДобавитьСлужебныеРеквизитыФормы()
	
	Реквизиты = Новый Массив;
	
	ЕстьРегистрация = Ложь;
	Попытка
		ЕстьРегистрация = (ЭтотОбъект.ак_ИдётРегистрация = Истина) Или (ЭтотОбъект.ак_ИдётРегистрация = Ложь);
	Исключение
		ЕстьРегистрация = Ложь;
	КонецПопытки;
	Если Не ЕстьРегистрация Тогда
		Реквизиты.Добавить(Новый РеквизитФормы("ак_ИдётРегистрация", Новый ОписаниеТипов("Булево")));
	КонецЕсли;
	
	ЕстьНазначение = Ложь;
	Попытка
		ЗначениеНазначения = ЭтотОбъект.ак_НазначениеПлатежа;
		ЕстьНазначение = Истина;
	Исключение
		ЕстьНазначение = Ложь;
	КонецПопытки;
	Если Не ЕстьНазначение Тогда
		Реквизиты.Добавить(Новый РеквизитФормы("ак_НазначениеПлатежа", Новый ОписаниеТипов("Строка")));
	КонецЕсли;
	
	Если Реквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(Реквизиты);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЧислоИзЗначенияЛимита(Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Попытка
		Возврат Число(СтрЗаменить(СтрЗаменить(Строка(Значение), " ", ""), ",", "."));
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ак_HTTPПостБП(Путь, СтрокаJSON)
	
	ПараметрыПодключения = ПараметрыПодключенияКБП();
	HTTPСоединение = Новый HTTPСоединение(
		ПараметрыПодключения.Сервер,
		ПараметрыПодключения.Порт,
		ПараметрыПодключения.Пользователь,
		ПараметрыПодключения.Пароль,
		,
		,
		Новый ЗащищенноеСоединениеOpenSSL);
	
	ЗапросPOST = Новый HTTPЗапрос(Путь);
	ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	ОтветHTTP = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
	
	Результат = Новый Структура;
	Результат.Вставить("Код", ОтветHTTP.КодСостояния);
	Результат.Вставить("Тело", ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8"));
	Возврат Результат;
	
КонецФункции

