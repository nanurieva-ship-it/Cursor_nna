&НаСервере
Процедура УстановитьСостояниеНаСогласовании()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСостояния = Новый Структура("Состояние, Установил, Период, НачальноеСостояние",
		Перечисления.СостоянияДокументов.НаСогласовании,
		ПользователиКлиентСервер.ТекущийПользователь(),
		ТекущаяДатаСеанса(),
		Перечисления.СостоянияДокументов.ПустаяСсылка());
	
	МассивСостояний = Новый Массив;
	МассивСостояний.Добавить(СтруктураСостояния);
	ИзменитьСостояние(Объект.Ссылка, МассивСостояний);
	
КонецПроцедуры

&НаСервере
Функция ДатаДокументаДляЛимита()
	
	Попытка
		Если ЗначениеЗаполнено(Объект.СрокИсполнения) Тогда
			Возврат Объект.СрокИсполнения;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если ЗначениеЗаполнено(Объект.ДатаРегистрации) Тогда
		Возврат Объект.ДатаРегистрации;
	КонецЕсли;
	Попытка
		Если ЗначениеЗаполнено(Объект.ДатаСоздания) Тогда
			Возврат Объект.ДатаСоздания;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

&НаСервере
Функция ДатаПлановойЗаявки()
	
	Возврат ДатаДокументаДляЛимита();
	
КонецФункции

&НаСервере
Функция КодСтатьиДДС()
	
	Если СтатьиДвиженияДенежныхСредств.Количество() > 0 Тогда
		Возврат СокрЛП(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств.Код);
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		НаборЗаписей = РегистрыСведений.СтатьиДвиженияДенежныхСредствДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			Возврат СокрЛП(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств.Код);
		КонецЕсли;
	КонецЕсли;
	Возврат "";
	
КонецФункции

