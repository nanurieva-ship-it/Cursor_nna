&НаСервере
Процедура ак_ЗаписатьСвязиДоговора(ТекущийОбъект)
	
	ИдВида = Строка(ТекущийОбъект.ВидДокумента.УникальныйИдентификатор());
	
	Если ЗначениеЗаполнено(ТекущийОбъект.ДоговорОснование) Тогда
		Если ИдВида = ИдЗаявкиНаОплату() Тогда
			СвязиДокументов.СоздатьСвязь(ТекущийОбъект.Ссылка, ТекущийОбъект.ДоговорОснование,
				Справочники.ТипыСвязей.НайтиПоНаименованию("Предмет оплаты"));
		Иначе
			СвязиДокументов.СоздатьСвязь(ТекущийОбъект.Ссылка, ТекущийОбъект.ДоговорОснование,
				Справочники.ТипыСвязей.НайтиПоНаименованию("Относится к договору"));
		КонецЕсли;
	КонецЕсли;
	
	Если ИдВида = ИдЗаявкиНаОплату() Тогда
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("Имя",
			"ПодтверждающиеДокументы_2c5a8492d962457cb2fc21538f6800be");
		Если ЗначениеЗаполнено(Свойство) Тогда
			НайденныеСтроки = ТекущийОбъект.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", Свойство));
			Если НайденныеСтроки.Количество() > 0 Тогда
				СвязиДокументов.СоздатьСвязь(ТекущийОбъект.Ссылка, НайденныеСтроки[0].Значение,
					Справочники.ТипыСвязей.НайтиПоНаименованию("Имеет подтверждающие документы"));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура САХГрафикПлатежейСуммаПриИзмененииПосле(Элемент)
	
	Объект.Сумма = Объект.ГрафикПлатежей.Итог("Сумма");
	Если СтатьиДвиженияДенежныхСредств.Количество() > 0 Тогда
		СтатьиДвиженияДенежныхСредств.Получить(0).Сумма = Объект.Сумма;
	КонецЕсли;
	
