// =============================================================================
// ТОЛЬКО расширение формы: Справочник.ВнутренниеДокументы.ФормаЭлемента (САХ)
// Конфигуратор: расширение → форма элемента внутренних документов → модуль
//
// НЕ вставлять сюда ЗагрузкаСтатусаStatus / FromBuhStatus / HTTPСервисОтвет.
// HTTP-сервис статусов: do/FromBuhStatus.bsl → модуль ФУ_ЗагрузкаСтатусовИзБух
//
// Только аннотации &Перед / &После / &Вместо + свои процедуры. После проверок — ПродолжитьВызов.
// Виды: счёт a963c455-a1c9-11eb-b511-a7abe965c408, плановая 0f8f6296-ba4a-11f1-a615-9c69b465b0dd
// =============================================================================

#Область Аннотации

&НаКлиенте
&Вместо("Подключаемый_ПриИзмененииДополнительногоРеквизита")
Процедура ак_Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	
	ПродолжитьВызов(Элемент);
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
	
	Если Элемент.Имя = "ДополнительныйРеквизитЗначение_361540BEx73D5x11EExBE26x3CECEF19F70B_30A02316x73E1x11EExBE26x3CECEF19F70B" Тогда
		ПриИзмененииДокОплаты(Элемент.ВыделенныйТекст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
&Перед("ПриСозданииНаСервере")
Процедура ак_ПриСозданииНаСервереПеред(Отказ, СтандартнаяОбработка)
	
	Элементы.ОтправитьОбъекты.Доступность = Ложь;
	Элементы.Зарегистрировать.Заголовок = "Отправить на согласование";
	ак_ДобавитьСлужебныеРеквизитыФормы();
	
	ПроверкаСчета = ПроверитьСозданиеСчетаИзПлановой();
	Если Не ПроверкаСчета.Можно Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ПроверкаСчета.Сообщение;
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
&После("ПриСозданииНаСервере")
Процедура ак_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ак_ДобавитьСлужебныеРеквизитыФормы();
	ак_НастроитьОснованиеЗаявки();
	ак_ДобавитьКомандыФормы();
	ак_НастроитьВидДокументаНаСервере();
	ак_ЗаполнитьНазначениеСчетаИзПлановой();
	
КонецПроцедуры

&НаСервере
&После("ПриИзмененииВидаДокумента")
Процедура ак_ПриИзмененииВидаДокументаПосле()
	
	ак_НастроитьВидДокументаНаСервере();
	
КонецПроцедуры

&НаКлиенте
&Вместо("ПередЗаписью")
Процедура ак_ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ак_ПроверкиПередЗаписью(Отказ, ПараметрыЗаписи);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВызов(Отказ, ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
&Перед("ПриЗаписиНаСервере")
Процедура ак_ПриЗаписиНаСервереПеред(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не ЭтоПлановаяЗаявкаОбъекта(ТекущийОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Срок = Дата(1, 1, 1);
	Попытка
		Срок = ТекущийОбъект.СрокИсполнения;
	Исключение
	КонецПопытки;
	Если Не ЗначениеЗаполнено(Срок) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для плановой заявки заполните срок. В БП это будет запланированная дата в графике платежей.";
		Сообщение.Поле = "Объект.СрокИсполнения";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;
	
	ак_ЗаписатьНазначениеВОбъект(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
&После("ПриЗаписиНаСервере")
Процедура ак_ПриЗаписиНаСервереПосле(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ак_ЗаписатьСвязиДоговора(ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
&Вместо("Зарегистрировать")
Процедура ак_Зарегистрировать(Команда)
	
	ак_УстановитьФлагРегистрации(Истина);
	ПродолжитьВызов(Команда);
	ак_УстановитьФлагРегистрации(Ложь);
	Если ЭтоДокументДляВыгрузкиВБП() И Не Объект.Ссылка.Пустая() И Не Модифицированность Тогда
		ак_ОтправитьНаСогласованиеПослеРегистрации();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ак_ОтправитьНаСогласование(Команда)
	
	ак_ОтправитьНаСогласованиеПослеРегистрации();
	
КонецПроцедуры

