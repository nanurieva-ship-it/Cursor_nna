&НаСервере
Функция ДанныеПлановойОснованияНаСервере()
	
	Данные = Новый Структура("ЕстьОснование, Согласована, Код, Сумма", Ложь, Ложь, "", 0);
	СсылкаПлановой = СсылкаПлановойОснования();
	Если Не ЗначениеЗаполнено(СсылкаПлановой) Тогда
		Возврат Данные;
	КонецЕсли;
	
	Данные.ЕстьОснование = Истина;
	Данные.Согласована = ПлановаяДокументСогласован(СсылкаПлановой);
	Попытка
		Данные.Код = СокрЛП(СсылкаПлановой.Код);
		Если Не ЗначениеЗаполнено(Данные.Код) Тогда
			Данные.Код = СокрЛП(СсылкаПлановой.РегистрационныйНомер);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Данные.Сумма = СсылкаПлановой.Сумма;
	Исключение
		Данные.Сумма = 0;
	КонецПопытки;
	Возврат Данные;
	
КонецФункции

&НаСервере
Функция СсылкаПлановойОснования()
	
	Кандидаты = Новый Массив;
	
	Попытка
		Если ЗначениеЗаполнено(Объект.ДоговорОснование) Тогда
			Кандидаты.Добавить(Объект.ДоговорОснование);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	ОснованиеПараметра = ОснованиеИзПараметровФормы();
	Если ЗначениеЗаполнено(ОснованиеПараметра) Тогда
		Кандидаты.Добавить(ОснованиеПараметра);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Для Каждого Связанный Из СвязанныеДокументыПлановой(Объект.Ссылка) Цикл
			Кандидаты.Добавить(Связанный);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Кандидат Из Кандидаты Цикл
		Попытка
			Если ЗначениеЗаполнено(Кандидат) И ЭтоПлановаяПоВиду(Кандидат.ВидДокумента) Тогда
				Возврат Кандидат;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Справочники.ВнутренниеДокументы.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция СвязанныеДокументыПлановой(ДокументСсылка)
	
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СвязиДокументов.СвязанныйДокумент КАК СвязанныйДокумент
		|ИЗ
		|	РегистрСведений.СвязиДокументов КАК СвязиДокументов
		|ГДЕ
		|	СвязиДокументов.Документ = &Документ
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	СвязиДокументов.Документ
		|ИЗ
		|	РегистрСведений.СвязиДокументов КАК СвязиДокументов
		|ГДЕ
		|	СвязиДокументов.СвязанныйДокумент = &Документ";
		Запрос.УстановитьПараметр("Документ", ДокументСсылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Добавить(Выборка.СвязанныйДокумент);
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

