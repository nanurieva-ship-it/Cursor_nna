Функция ПроверитьСозданиеСчетаИзПлановой()
	
	Результат = Новый Структура("Можно, Сообщение", Истина, "");
	Если Не ЭтоСчетПоВиду(Объект.ВидДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОснованиеДокумента = ОснованиеИзПараметровФормы();
	Если Не ЗначениеЗаполнено(ОснованиеДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Не ЭтоПлановаяПоВиду(ОснованиеДокумента.ВидДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	Если ПлановаяДокументСогласован(ОснованиеДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Можно = Ложь;
	Результат.Сообщение = "Счёт на оплату нельзя создать по плановой заявке, пока она не согласована.";
	Возврат Результат;
	
