// Вставить в расширение формы внутренних документов (ДО) вместо текущей ПроверитьЛимитВДО.
// Вызов из ПередЗаписью: РезультатПроверки = ПроверитьЛимитВДО(); Если Не РезультатПроверки.ЕстьЛимит Тогда Отказ = Истина;
//
// Тело на БП: массив {СтатьяДДС, Сумма, ДатаПлатежа}.
// Ответ БП:   массив {success, message}.

&НаСервере
Функция ПроверитьЛимитВДО()
	
	РезультатПроверки = Новый Структура("ЕстьЛимит, Сообщение", Истина, "");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		КодСтатьи = КодСтатьиДДСДокумента();
		Если Не ЗначениеЗаполнено(КодСтатьи) Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = "Не заполнена статья ДДС. Проверка лимитов в БП не выполнена.";
			Возврат РезультатПроверки;
		КонецЕсли;
		
		Если Объект.ГрафикПлатежей.Количество() = 0 Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = "Не заполнен график платежей. Проверка лимитов в БП не выполнена.";
			Возврат РезультатПроверки;
		КонецЕсли;
		
		Массив = Новый Массив;
		Для Каждого ТекСтр Из Объект.ГрафикПлатежей Цикл
			
			Если Не ЗначениеЗаполнено(ТекСтр.ДатаПлатежа) Тогда
				РезультатПроверки.ЕстьЛимит = Ложь;
				РезультатПроверки.Сообщение = "В графике платежей есть строка без даты.";
				Возврат РезультатПроверки;
			КонецЕсли;
			
			Структура = Новый Структура;
			Структура.Вставить("СтатьяДДС", КодСтатьи);
			Структура.Вставить("Сумма", ТекСтр.Сумма);
			Структура.Вставить("ДатаПлатежа", Формат(ТекСтр.ДатаПлатежа, "ДФ=yyyyMMdd"));
			Массив.Добавить(Структура);
			
		КонецЦикла;
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Массив);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		ПараметрыПодключения = ПараметрыПодключенияКБП();
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗапросPOST = Новый HTTPЗапрос("/sah_buh_akea/hs/CheckLimitsDO/Ch");
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
		Если Результат.КодСостояния <> 200 Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = СтрШаблон("БП вернула %1: %2", Результат.КодСостояния, ТелоОтвета);
			Возврат РезультатПроверки;
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(Данные) <> Тип("Массив") Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = "БП вернула не массив: " + ТелоОтвета;
			Возврат РезультатПроверки;
		КонецЕсли;
		
		Тексты = Новый Массив;
		Для Каждого СтрокаЛимита Из Данные Цикл
			
			ЕстьЛимитСтроки = Ложь;
			Если ТипЗнч(СтрокаЛимита) = Тип("Структура") И СтрокаЛимита.Свойство("success") Тогда
				ЕстьЛимитСтроки = (СтрокаЛимита.success = Истина);
			КонецЕсли;
			
			ТекстСтроки = "";
			Если ТипЗнч(СтрокаЛимита) = Тип("Структура") И СтрокаЛимита.Свойство("message") Тогда
				ТекстСтроки = Строка(СтрокаЛимита.message);
			КонецЕсли;
			
			Если Не ЕстьЛимитСтроки Тогда
				РезультатПроверки.ЕстьЛимит = Ложь;
				Если ЗначениеЗаполнено(ТекстСтроки) Тогда
					Тексты.Добавить(ТекстСтроки);
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(ТекстСтроки) Тогда
				Тексты.Добавить(ТекстСтроки);
			КонецЕсли;
			
		КонецЦикла;
		
		РезультатПроверки.Сообщение = СтрСоединить(Тексты, Символы.ПС);
		
	Исключение
		
		РезультатПроверки.ЕстьЛимит = Ложь;
		РезультатПроверки.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция КодСтатьиДДСДокумента()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		НаборЗаписей = РегистрыСведений.СтатьиДвиженияДенежныхСредствДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0
			И ЗначениеЗаполнено(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств) Тогда
			Возврат СокрЛП(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств.Код);
		КонецЕсли;
	КонецЕсли;
	
	Если СтатьиДвиженияДенежныхСредств.Количество() > 0
		И ЗначениеЗаполнено(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств) Тогда
		Возврат СокрЛП(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств.Код);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ПараметрыПодключенияКБП()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
	ПараметрыПодключения.Вставить("Порт", 59795);
	ПараметрыПодключения.Вставить("Пользователь", "");
	ПараметрыПодключения.Вставить("Пароль", "");
	Возврат ПараметрыПодключения;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатПроверкиЛимитов(Отказ)
	
	РезультатПроверки = ПроверитьЛимитВДО();
	Если ЗначениеЗаполнено(РезультатПроверки.Сообщение) Тогда
		Сообщить(РезультатПроверки.Сообщение);
	КонецЕсли;
	Если Не РезультатПроверки.ЕстьЛимит Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры
