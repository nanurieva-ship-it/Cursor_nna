// Журнал регистрации ДО, событие «ПроверитьЛимитВДО».
// Сопоставить с событием CheckLimitsDO в журнале БП по одной и той же минуте.

&НаСервере
Функция ПроверитьЛимитВДО()
	
	ИмяСобытия = "ПроверитьЛимитВДО";
	РезультатПроверки = Новый Структура("ЕстьЛимит, Сообщение", Истина, "");
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"Старт. СсылкаЗаполнена=" + (ЗначениеЗаполнено(Объект.Ссылка))
			+ " строкГрафика=" + Объект.ГрафикПлатежей.Количество()
			+ " строкСтатейФормы=" + СтатьиДвиженияДенежныхСредств.Количество());
		
		КодСтатьи = "";
		Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
			НаборЗаписей = РегистрыСведений.СтатьиДвиженияДенежныхСредствДокументов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Документ.Установить(Объект.Ссылка);
			НаборЗаписей.Прочитать();
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
				"Регистр статей: записей=" + НаборЗаписей.Количество());
			Если НаборЗаписей.Количество() > 0 Тогда
				КодСтатьи = СокрЛП(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств.Код);
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(КодСтатьи) И СтатьиДвиженияДенежныхСредств.Количество() > 0 Тогда
			КодСтатьи = СокрЛП(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств.Код);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
				"Код статьи взят из реквизита формы");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(КодСтатьи) Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = "Не заполнена статья ДДС";
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Объект.Ссылка,
				РезультатПроверки.Сообщение);
			Возврат РезультатПроверки;
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"КодСтатьи=" + КодСтатьи);
		
		Массив = Новый Массив;
		Для Каждого ТекСтр Из Объект.ГрафикПлатежей Цикл
			Структура = Новый Структура;
			Структура.Вставить("СтатьяДДС", КодСтатьи);
			Структура.Вставить("Сумма", ТекСтр.Сумма);
			Структура.Вставить("ДатаПлатежа", Формат(ТекСтр.ДатаПлатежа, "ДФ=yyyyMMdd"));
			Массив.Добавить(Структура);
		КонецЦикла;
		
		Если Массив.Количество() = 0 Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = "Не заполнен график платежей";
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Объект.Ссылка,
				РезультатПроверки.Сообщение);
			Возврат РезультатПроверки;
		КонецЕсли;
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Массив);
		СтрокаJSON = ЗаписьJSON.Закрыть();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"JSON запроса (" + Формат(СтрДлина(СтрокаJSON), "ЧН=0; ЧГ=") + "): " + Лев(СтрокаJSON, 2000));
		
		ПараметрыПодключения = ПараметрыПодключенияКБП();
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		Путь = "/sah_buh_akea/hs/CheckLimitsDO/Ch";
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"HTTP POST " + ПараметрыПодключения.Сервер + ":" + Формат(ПараметрыПодключения.Порт, "ЧГ=") + Путь);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"КодСостояния=" + Результат.КодСостояния
			+ " длинаТела=" + Формат(СтрДлина(ТелоОтвета), "ЧН=0; ЧГ=")
			+ " тело=" + Лев(ТелоОтвета, 2000));
		
		Если Результат.КодСостояния <> 200 Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = СтрШаблон("БП вернула %1: %2", Результат.КодСостояния, ТелоОтвета);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
				РезультатПроверки.Сообщение);
			Возврат РезультатПроверки;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТелоОтвета) Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = "БП вернула 200 и пустое тело. Смотрите журнал CheckLimitsDO в БП: функция могла не вызваться.";
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
				РезультатПроверки.Сообщение);
			Возврат РезультатПроверки;
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"Тип ответа=" + Строка(ТипЗнч(Данные))
			+ " элементов=" + ?(ТипЗнч(Данные) = Тип("Массив"), Данные.Количество(), 0));
		
		Если ТипЗнч(Данные) <> Тип("Массив") Тогда
			РезультатПроверки.ЕстьЛимит = Ложь;
			РезультатПроверки.Сообщение = "БП вернула не массив: " + Лев(ТелоОтвета, 500);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
				РезультатПроверки.Сообщение);
			Возврат РезультатПроверки;
		КонецЕсли;
		
		Тексты = Новый Массив;
		НомерСтроки = 0;
		Для Каждого СтрокаЛимита Из Данные Цикл
			НомерСтроки = НомерСтроки + 1;
			Если ТипЗнч(СтрокаЛимита) <> Тип("Структура") Тогда
				РезультатПроверки.ЕстьЛимит = Ложь;
				Тексты.Добавить("Элемент " + НомерСтроки + " не структура");
				Продолжить;
			КонецЕсли;
			Если СтрокаЛимита.success <> Истина Тогда
				РезультатПроверки.ЕстьЛимит = Ложь;
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаЛимита.message) Тогда
				Тексты.Добавить(СтрокаЛимита.message);
			КонецЕсли;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
				"Ответ строки " + НомерСтроки + " success=" + СтрокаЛимита.success
				+ " message=" + Строка(СтрокаЛимита.message));
		КонецЦикла;
		РезультатПроверки.Сообщение = СтрСоединить(Тексты, Символы.ПС);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"Итог ЕстьЛимит=" + (РезультатПроверки.ЕстьЛимит) + " сообщение=" + РезультатПроверки.Сообщение);
		
	Исключение
		
		РезультатПроверки.ЕстьЛимит = Ложь;
		РезультатПроверки.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ПараметрыПодключенияКБП()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
	ПараметрыПодключения.Вставить("Порт", 59795);
	ПараметрыПодключения.Вставить("Пользователь", "Аналитик");
	ПараметрыПодключения.Вставить("Пароль", ""); // взять из константы / РС, не хранить в модуле формы
	Возврат ПараметрыПодключения;
	
КонецФункции
