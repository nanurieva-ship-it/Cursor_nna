	Возврат ИмяВида = "Счёт на оплату" Или ИмяВида = "Счет на оплату";
	
КонецФункции

&НаСервере
Функция дор_ИННСсылки(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ИНН"));
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

