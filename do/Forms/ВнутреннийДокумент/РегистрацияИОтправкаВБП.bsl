// Расширение формы Справочник.ВнутренниеДокументы.ФормаЭлемента (ДО).
//
// Схема для вида «Счёт на оплату»:
//   ПередЗаписью        — проверка лимитов (уже есть, см. ПроверитьЛимитВДО.bsl)
//   Зарегистрировать    — штатная регистрация (ПараметрыЗаписи.Регистрация = Истина)
//   ПослеЗаписиНаСервере — выгрузка в БП (HTTP ImportFromDO/Download) + состояние «На согласовании»
//   ПослеЗаписи         — кнопка отправки недоступна
//
// В расширении формы:
// 1. Добавить реквизит формы дор_СчетОтправленВБП (Булево).
// 2. Создать команду ОтправитьВБП (действие «ОтправитьВБП») — повторная отправка, если регистрация прошла, а БП не приняла.
// 3. В обработчики формы вставить вызовы с префиксом дор_ (ниже).
// 4. Не копировать этот файл целиком вместо модуля формы — только помеченные процедуры.

#Область ПрограммныйИнтерфейсРасширения

// Вызвать в конце ПриСозданииНаСервере расширения (после типового).
&НаСервере
Процедура дор_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не дор_ЭтоСчетНаОплату() Тогда
		Возврат;
	КонецЕсли;
	
	дор_ОбеспечитьКомандуОтправки();
	дор_СчетОтправленВБП = дор_ДокументУжеНаСогласовании();
	дор_ОбновитьДоступностьОтправкиНаСервере();
	
КонецПроцедуры

// Вызвать в конце ПриЧтенииНаСервере расширения.
&НаСервере
Процедура дор_ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если Не дор_ЭтоСчетНаОплату() Тогда
		Возврат;
	КонецЕсли;
	
	дор_СчетОтправленВБП = дор_ДокументУжеНаСогласовании();
	дор_ОбновитьДоступностьОтправкиНаСервере();
	
КонецПроцедуры

// Вызвать в конце ПередЗаписью расширения, после типовых проверок.
// Лимиты — только для счёта, и только при регистрации (кнопка «Зарегистрировать»).
&НаКлиенте
Процедура дор_ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Не дор_ЭтоСчетНаОплатуКлиент() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоРегистрация = ПараметрыЗаписи.Свойство("Регистрация") И ПараметрыЗаписи.Регистрация = Истина;
	Если Не ЭтоРегистрация Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = ПроверитьЛимитВДО();
	Если Не РезультатПроверки.ЕстьЛимит Тогда
		ПоказатьПредупреждение(,
			?(ЗначениеЗаполнено(РезультатПроверки.Сообщение),
				РезультатПроверки.Сообщение,
				НСтр("ru = 'Превышен лимит по статье. Счёт не зарегистрирован.'")));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Вызвать в конце ПослеЗаписиНаСервере расширения.
&НаСервере
Процедура дор_ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если Не дор_ЭтоСчетНаОплату() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоРегистрация = ПараметрыЗаписи.Свойство("Регистрация") И ПараметрыЗаписи.Регистрация = Истина;
	Если Не ЭтоРегистрация Тогда
		дор_ОбновитьДоступностьОтправкиНаСервере();
		Возврат;
	КонецЕсли;
	
	Если дор_СчетОтправленВБП Тогда
		ПараметрыЗаписи.Вставить("дор_РезультатВыгрузкиВБП",
			Новый Структура("Успех, Сообщение", Истина, НСтр("ru = 'Счёт уже отправлен в БП.'")));
		дор_ОбновитьДоступностьОтправкиНаСервере();
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = ВыгрузитьСчетВБП();
	ПараметрыЗаписи.Вставить("дор_РезультатВыгрузкиВБП", РезультатВыгрузки);
	
	Если РезультатВыгрузки.Успех Тогда
		дор_УстановитьСостояниеНаСогласовании(ТекущийОбъект.Ссылка);
		дор_СчетОтправленВБП = Истина;
		СостояниеТекст = Делопроизводство.ПолучитьСтроковоеПредставлениеСостояний(ТекущийОбъект.Ссылка);
	КонецЕсли;
	
	дор_ОбновитьДоступностьОтправкиНаСервере();
	
КонецПроцедуры

// Вызвать в конце ПослеЗаписи расширения.
&НаКлиенте
Процедура дор_ПослеЗаписи(ПараметрыЗаписи)
	
	Если Не дор_ЭтоСчетНаОплатуКлиент() Тогда
		Возврат;
	КонецЕсли;
	
	дор_ОбновитьДоступностьОтправкиНаКлиенте();
	
	Если Не ПараметрыЗаписи.Свойство("дор_РезультатВыгрузкиВБП") Тогда
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = ПараметрыЗаписи.дор_РезультатВыгрузкиВБП;
	Если РезультатВыгрузки.Успех Тогда
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Счёт отправлен на согласование'"),
			ПолучитьНавигационнуюСсылку(Объект.Ссылка),
			?(ЗначениеЗаполнено(РезультатВыгрузки.Сообщение),
				РезультатВыгрузки.Сообщение,
				НСтр("ru = 'Заявка создана в БП. Кнопка отправки недоступна.'")),
			БиблиотекаКартинок.Информация32);
	Иначе
		ПоказатьПредупреждение(,
			НСтр("ru = 'Счёт зарегистрирован, но не выгружен в БП:'")
			+ Символы.ПС + РезультатВыгрузки.Сообщение
			+ Символы.ПС + НСтр("ru = 'Нажмите «Отправить в БП» после исправления.'"));
	КонецЕсли;
	
КонецПроцедуры

// Команда формы расширения: повторная выгрузка, если регистрация уже была.
&НаКлиенте
Процедура ОтправитьВБП(Команда)
	
	Если Не дор_ЭтоСчетНаОплатуКлиент() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала запишите и зарегистрируйте счёт.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.РегистрационныйНомер) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отправка в БП выполняется после регистрации счёта.'"));
		Возврат;
	КонецЕсли;
	
	Если дор_СчетОтправленВБП Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Счёт уже отправлен в БП. Повторная отправка запрещена.'"));
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Если Не Записать() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	РезультатПроверки = ПроверитьЛимитВДО();
	Если Не РезультатПроверки.ЕстьЛимит Тогда
		ПоказатьПредупреждение(, РезультатПроверки.Сообщение);
		Возврат;
	КонецЕсли;
	
	РезультатВыгрузки = дор_ОтправитьСчетВБППослеРегистрации();
	Если РезультатВыгрузки.Успех Тогда
		дор_СчетОтправленВБП = Истина;
		дор_ОбновитьДоступностьОтправкиНаКлиенте();
		ПоказатьОповещениеПользователя(
			НСтр("ru = 'Счёт отправлен на согласование'"),
			ПолучитьНавигационнуюСсылку(Объект.Ссылка),
			РезультатВыгрузки.Сообщение,
			БиблиотекаКартинок.Информация32);
	Иначе
		ПоказатьПредупреждение(, РезультатВыгрузки.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаВБП

&НаСервере
Функция ВыгрузитьСчетВБП()
	
	ИмяСобытия = "ВыгрузитьСчетВБП";
	РезультатВыгрузки = Новый Структура("Успех, Сообщение", Ложь, "");
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"Старт выгрузки. РегНомер=" + СокрЛП(Объект.РегистрационныйНомер)
			+ " сумма=" + Формат(Объект.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=")
			+ " строкГрафика=" + Объект.ГрафикПлатежей.Количество());
		
		СтрокаJSON = дор_СобратьJSONСчетаДляБП();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"JSON запроса (" + Формат(СтрДлина(СтрокаJSON), "ЧН=0; ЧГ=") + "): " + Лев(СтрокаJSON, 2000));
		
		ПараметрыПодключения = ПараметрыПодключенияКБП();
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		Путь = "/sah_buh_akea/hs/ImportFromDO/Download";
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"HTTP POST " + ПараметрыПодключения.Сервер + ":" + Формат(ПараметрыПодключения.Порт, "ЧГ=") + Путь);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"КодСостояния=" + Результат.КодСостояния
			+ " тело=" + Лев(ТелоОтвета, 2000));
		
		Если Результат.КодСостояния <> 200 Тогда
			РезультатВыгрузки.Сообщение = СтрШаблон(НСтр("ru = 'БП вернула %1: %2'"),
				Результат.КодСостояния, ТелоОтвета);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
				РезультатВыгрузки.Сообщение);
			УстановитьПривилегированныйРежим(Ложь);
			Возврат РезультатВыгрузки;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТелоОтвета) Тогда
			РезультатВыгрузки.Успех = Истина;
			РезультатВыгрузки.Сообщение = НСтр("ru = 'БП приняла заявку (200, пустое тело).'");
			УстановитьПривилегированныйРежим(Ложь);
			Возврат РезультатВыгрузки;
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		
		Если ТипЗнч(Данные) = Тип("Структура") Тогда
			Если Данные.Свойство("success") И Данные.success = Ложь Тогда
				РезультатВыгрузки.Сообщение = ?(Данные.Свойство("message"),
					Строка(Данные.message), НСтр("ru = 'БП не создала заявку.'"));
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
					РезультатВыгрузки.Сообщение);
				УстановитьПривилегированныйРежим(Ложь);
				Возврат РезультатВыгрузки;
			КонецЕсли;
			РезультатВыгрузки.Успех = Истина;
			Если Данные.Свойство("message") И ЗначениеЗаполнено(Данные.message) Тогда
				РезультатВыгрузки.Сообщение = Строка(Данные.message);
			Иначе
				РезультатВыгрузки.Сообщение = НСтр("ru = 'Заявка создана в БП.'");
			КонецЕсли;
			Если Данные.Свойство("documentNumber") И ЗначениеЗаполнено(Данные.documentNumber) Тогда
				РезультатВыгрузки.Сообщение = РезультатВыгрузки.Сообщение
					+ " № " + Строка(Данные.documentNumber);
			КонецЕсли;
		Иначе
			РезультатВыгрузки.Успех = Истина;
			РезультатВыгрузки.Сообщение = НСтр("ru = 'Заявка создана в БП.'");
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
			"Успех. " + РезультатВыгрузки.Сообщение);
		
	Исключение
		
		РезультатВыгрузки.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат РезультатВыгрузки;
	
КонецФункции

&НаСервере
Функция дор_ОтправитьСчетВБППослеРегистрации()
	
	РезультатВыгрузки = ВыгрузитьСчетВБП();
	Если РезультатВыгрузки.Успех Тогда
		дор_УстановитьСостояниеНаСогласовании(Объект.Ссылка);
		СостояниеТекст = Делопроизводство.ПолучитьСтроковоеПредставлениеСостояний(Объект.Ссылка);
		дор_ОбновитьДоступностьОтправкиНаСервере();
	КонецЕсли;
	Возврат РезультатВыгрузки;
	
КонецФункции

&НаСервере
Функция дор_СобратьJSONСчетаДляБП()
	
	Структура = Новый Структура;
	Структура.Вставить("ИдентификаторДО", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Структура.Вставить("КодСчета", Строка(Объект.Код));
	Структура.Вставить("РегистрационныйНомер", СокрЛП(Объект.РегистрационныйНомер));
	Структура.Вставить("ДатаРегистрации", Формат(Объект.ДатаРегистрации, "ДФ=yyyyMMdd"));
	Структура.Вставить("Заголовок", Строка(Объект.Заголовок));
	Структура.Вставить("Содержание", Строка(Объект.Содержание));
	Структура.Вставить("Сумма", Объект.Сумма);
	Структура.Вставить("СуммаНДС", Объект.СуммаНДС);
	Структура.Вставить("Валюта", Строка(Объект.Валюта));
	Структура.Вставить("ОрганизацияИНН", дор_ИННСсылки(Объект.Организация));
	Структура.Вставить("Организация", Строка(Объект.Организация));
	Структура.Вставить("КонтрагентИНН", дор_ИННСсылки(Объект.Контрагент));
	Структура.Вставить("КонтрагентКПП", дор_КППСсылки(Объект.Контрагент));
	Структура.Вставить("Контрагент", Строка(Объект.Контрагент));
	
	КодСтатьи = "";
	СтатьяНаим = "";
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		НаборЗаписей = РегистрыСведений.СтатьиДвиженияДенежныхСредствДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			КодСтатьи = СокрЛП(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств.Код);
			СтатьяНаим = Строка(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КодСтатьи) И СтатьиДвиженияДенежныхСредств.Количество() > 0 Тогда
		КодСтатьи = СокрЛП(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств.Код);
		СтатьяНаим = Строка(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств);
	КонецЕсли;
	Структура.Вставить("СтатьяДДС", КодСтатьи);
	Структура.Вставить("СтатьяДДСНаим", СтатьяНаим);
	
	МассивГрафика = Новый Массив;
	Для Каждого ТекСтр Из Объект.ГрафикПлатежей Цикл
		СтрокаГрафика = Новый Структура;
		СтрокаГрафика.Вставить("СтатьяДДС", КодСтатьи);
		СтрокаГрафика.Вставить("Сумма", ТекСтр.Сумма);
		СтрокаГрафика.Вставить("ДатаПлатежа", Формат(ТекСтр.ДатаПлатежа, "ДФ=yyyyMMdd"));
		СтрокаГрафика.Вставить("Согласовано", ТекСтр.Согласовано);
		МассивГрафика.Добавить(СтрокаГрафика);
	КонецЦикла;
	Структура.Вставить("ГрафикПлатежей", МассивГрафика);
	
	Массив = Новый Массив;
	Массив.Добавить(Структура);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

#КонецОбласти

#Область СостояниеИКнопки

&НаСервере
Процедура дор_УстановитьСостояниеНаСогласовании(ДокументСсылка)
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСостояния = Новый Структура("Состояние, Установил, Период, НачальноеСостояние",
		Перечисления.СостоянияДокументов.НаСогласовании,
		ПользователиКлиентСервер.ТекущийПользователь(),
		ТекущаяДатаСеанса(),
		Перечисления.СостоянияДокументов.ПустаяСсылка());
	
	МассивСостояний = Новый Массив;
	МассивСостояний.Добавить(СтруктураСостояния);
	ИзменитьСостояние(ДокументСсылка, МассивСостояний);
	
	ЗаписьЖурналаРегистрации("ВыгрузитьСчетВБП", УровеньЖурналаРегистрации.Информация, , ДокументСсылка,
		НСтр("ru = 'Установлено состояние «На согласовании».'"));
	
КонецПроцедуры

&НаСервере
Функция дор_ДокументУжеНаСогласовании()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстСостояния = Делопроизводство.ПолучитьСтроковоеПредставлениеСостояний(Объект.Ссылка);
	ТекстНижний = НРег(ТекстСостояния);
	Если Найти(ТекстНижний, "на согласован") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		СостояниеСогласования = Делопроизводство.ПолучитьСостояниеДокумента(
			Объект.Ссылка, "Согласование");
		Если СостояниеСогласования = Перечисления.СостоянияДокументов.НаСогласовании
			Или СостояниеСогласования = Перечисления.СостоянияДокументов.Согласован Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура дор_ОбеспечитьКомандуОтправки()
	
	Если Команды.Найти("ОтправитьВБП") = Неопределено Тогда
		НоваяКоманда = Команды.Добавить("ОтправитьВБП");
		НоваяКоманда.Действие = "ОтправитьВБП";
		НоваяКоманда.Заголовок = НСтр("ru = 'Отправить в БП'");
	КонецЕсли;
	
	Если Элементы.Найти("дор_ОтправитьВБП") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Родитель = Неопределено;
	Если Элементы.Найти("ГруппаОсновнаяКомПанель") <> Неопределено Тогда
		Родитель = Элементы.ГруппаОсновнаяКомПанель;
	ИначеЕсли Элементы.Найти("ГруппаКоманды") <> Неопределено Тогда
		Родитель = Элементы.ГруппаКоманды;
	КонецЕсли;
	
	НоваяКнопка = Элементы.Добавить("дор_ОтправитьВБП", Тип("КнопкаФормы"), Родитель);
	НоваяКнопка.ИмяКоманды = "ОтправитьВБП";
	НоваяКнопка.Заголовок = НСтр("ru = 'Отправить в БП'");
	
КонецПроцедуры

&НаСервере
Процедура дор_ОбновитьДоступностьОтправкиНаСервере()
	
	КнопкаДоступна = дор_ЭтоСчетНаОплату() И Не дор_СчетОтправленВБП;
	
	Кнопка = Элементы.Найти("дор_ОтправитьВБП");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Доступность = КнопкаДоступна;
		Кнопка.Видимость = дор_ЭтоСчетНаОплату();
	КонецЕсли;
	
	КнопкаТиповая = Элементы.Найти("ФормаОтправить");
	Если КнопкаТиповая <> Неопределено И дор_ЭтоСчетНаОплату() И дор_СчетОтправленВБП Тогда
		КнопкаТиповая.Доступность = Ложь;
	КонецЕсли;
	
	КнопкаОтправить = Элементы.Найти("Отправить");
	Если КнопкаОтправить <> Неопределено И дор_ЭтоСчетНаОплату() И дор_СчетОтправленВБП Тогда
		КнопкаОтправить.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура дор_ОбновитьДоступностьОтправкиНаКлиенте()
	
	КнопкаДоступна = дор_ЭтоСчетНаОплатуКлиент() И Не дор_СчетОтправленВБП;
	
	Кнопка = Элементы.Найти("дор_ОтправитьВБП");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Доступность = КнопкаДоступна;
		Кнопка.Видимость = дор_ЭтоСчетНаОплатуКлиент();
	КонецЕсли;
	
	КнопкаТиповая = Элементы.Найти("ФормаОтправить");
	Если КнопкаТиповая <> Неопределено И дор_ЭтоСчетНаОплатуКлиент() И дор_СчетОтправленВБП Тогда
		КнопкаТиповая.Доступность = Ложь;
	КонецЕсли;
	
	КнопкаОтправить = Элементы.Найти("Отправить");
	Если КнопкаОтправить <> Неопределено И дор_ЭтоСчетНаОплатуКлиент() И дор_СчетОтправленВБП Тогда
		КнопкаОтправить.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаСервере
Функция дор_ЭтоСчетНаОплату()
	
	Если Не ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяВида = СокрЛП(Строка(Объект.ВидДокумента));
	Возврат ИмяВида = "Счёт на оплату" Или ИмяВида = "Счет на оплату";
	
КонецФункции

