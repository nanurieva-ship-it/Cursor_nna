// Расширение формы внутреннего документа.
// Счёт на оплату: a963c455-a1c9-11eb-b511-a7abe965c408
// Плановая заявка:  0f8f6296-ba4a-11f1-a615-9c69b465b0dd
//
// Плановая: ПередЗаписью (регистрация) — лимит в БП.
// Зарегистрировать — выгрузка в БП (ПлановаяЗаявка = Истина), «На согласовании»,
// кнопка Отправить недоступна. Подзадачу на счёт не создаём — это ваш БП при «Согласован».

#Область ОбработчикиФормы

&НаКлиенте
&После("ПередЗаписью")
Процедура ПередЗаписьюПосле(Отказ, ПараметрыЗаписи)
	
	Если Не ЭтоПлановаяЗаявкаКлиент() Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоРегистрация = Ложь;
	Если ТипЗнч(ПараметрыЗаписи) = Тип("Структура") И ПараметрыЗаписи.Свойство("Регистрация") Тогда
		ЭтоРегистрация = (ПараметрыЗаписи.Регистрация = Истина);
	КонецЕсли;
	Если Не ЭтоРегистрация Тогда
		Возврат;
	КонецЕсли;
	
	Проверка = ПроверитьЛимитПлановойЗаявкиНаСервере();
	Если ЗначениеЗаполнено(Проверка.Сообщение) Тогда
		Сообщить(Проверка.Сообщение);
	КонецЕсли;
	
	Если (Не Проверка.ЕстьЛимит И Не Проверка.СверхЛимит) Или Проверка.ОшибкаОбмена Тогда
		Отказ = Истина;
		ОставитьКнопкуСогласованияДоступной();
		ЗаписьЖурналаРегистрацииНаСервере("ПлановаяЗаявкаДО",
			"Отправка отклонена. " + Проверка.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
&После("Зарегистрировать")
Процедура ЗарегистрироватьПосле(Команда)
	
	ИдВида = Строка(Объект.ВидДокумента.УникальныйИдентификатор());
	
	//+++ нна счёт на оплату
	Если ИдВида = "a963c455-a1c9-11eb-b511-a7abe965c408" Тогда
		ВыгрузитьСчетВБП();
		Элементы.ОтправитьОбъекты.Доступность = Ложь;
		УстановитьСостояниеНаСогласовании();
		Возврат;
	КонецЕсли;
	//---
	
	//+++ плановая заявка
	Если ИдВида = "0f8f6296-ba4a-11f1-a615-9c69b465b0dd" Тогда
		Если Не ЗначениеЗаполнено(Объект.РегистрационныйНомер) Тогда
			ОставитьКнопкуСогласованияДоступной();
			Возврат;
		КонецЕсли;
		Результат = ВыгрузитьПлановуюЗаявкуПослеРегистрации();
		Если Результат.Успех Тогда
			УстановитьСостояниеНаСогласовании();
		Иначе
			ОставитьКнопкуСогласованияДоступной();
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.Сообщение) Тогда
			ПоказатьПредупреждение(, Результат.Сообщение);
		КонецЕсли;
	КонецЕсли;
	//---
	
КонецПроцедуры

&НаКлиенте
&Вместо("Отправить")
Процедура ак_ОтправитьВместо(Команда)
	
	Если Не ЭтоПлановаяЗаявкаКлиент() Тогда
		ПродолжитьВызов(Команда);
		Возврат;
	КонецЕсли;
	
	Если Не ак_МожноОтправитьПлановуюНаСогласование() Тогда
		Возврат;
	КонецЕсли;
	
	ПродолжитьВызов(Команда);
	
КонецПроцедуры

&НаКлиенте
Процедура ак_ОтправитьНаСогласование(Команда)
	
	ак_МожноОтправитьПлановуюНаСогласование();
	
КонецПроцедуры

&НаКлиенте
Функция ак_МожноОтправитьПлановуюНаСогласование()
	
	Проверка = ПроверитьЛимитПлановойЗаявкиНаСервере();
	Если ЗначениеЗаполнено(Проверка.Сообщение) Тогда
		ПоказатьПредупреждение(, Проверка.Сообщение);
	КонецЕсли;
	
	Если Проверка.ОшибкаОбмена Или (Не Проверка.ЕстьЛимит И Не Проверка.СверхЛимит) Тогда
		ОставитьКнопкуСогласованияДоступной();
		Возврат Ложь;
	КонецЕсли;
	
	Результат = ВыгрузитьПлановуюЗаявкуПослеРегистрации();
	Если Не Результат.Успех Тогда
		ОставитьКнопкуСогласованияДоступной();
		Если ЗначениеЗаполнено(Результат.Сообщение) И Результат.Сообщение <> Проверка.Сообщение Тогда
			ПоказатьПредупреждение(, Результат.Сообщение);
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьСостояниеНаСогласовании();
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОставитьКнопкуСогласованияДоступной()
	
	Имена = СтрРазделить(
		"ОтправитьОбъекты,Отправить,ФормаОтправить,ОтправитьНаСогласование,СоздатьБизнесПроцесс,ФормаСоздатьБизнесПроцесс",
		",",
		Ложь);
	Для Каждого ИмяКнопки Из Имена Цикл
		ЭлементКнопки = Элементы.Найти(СокрЛП(ИмяКнопки));
		Если ЭлементКнопки <> Неопределено Тогда
			ЭлементКнопки.Доступность = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПлановаяЗаявка

&НаКлиенте
Функция ЭтоПлановаяЗаявкаКлиент()
	
	Возврат Строка(Объект.ВидДокумента.УникальныйИдентификатор()) = "0f8f6296-ba4a-11f1-a615-9c69b465b0dd";
	
КонецФункции

&НаСервере
Функция ЭтоПлановаяЗаявка()
	
	Возврат Строка(Объект.ВидДокумента.УникальныйИдентификатор()) = "0f8f6296-ba4a-11f1-a615-9c69b465b0dd";
	
КонецФункции

&НаСервере
Функция ПроверитьЛимитПлановойЗаявкиНаСервере()
	
	РезультатПроверки = Новый Структура("ЕстьЛимит, СверхЛимит, ОшибкаОбмена, Сообщение", Ложь, Ложь, Ложь, "");
	РезультатПроверки.СверхЛимит = СверхЛимитДокумента();
	
	Если Не ЭтоПлановаяЗаявка() Тогда
		РезультатПроверки.ЕстьЛимит = Истина;
		Возврат РезультатПроверки;
	КонецЕсли;
	
	КодСтатьи = КодСтатьиДДС();
	Сумма = СуммаДокумента();
	ДатаДокумента = ДатаПлановойЗаявки();
	
	ЗаписьЖурналаРегистрации("ПлановаяЗаявкаДО", УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Проверка лимита. Статья=[" + КодСтатьи + "] Сумма=" + Формат(Сумма, "ЧРД=.; ЧГ=")
		+ " Дата=" + Формат(ДатаДокумента, "ДФ=yyyyMMdd")
		+ " СверхЛимит=" + (РезультатПроверки.СверхЛимит));
	
	Если Не ЗначениеЗаполнено(КодСтатьи) Тогда
		РезультатПроверки.Сообщение = "Не заполнена статья ДДС";
		Возврат РезультатПроверки;
	КонецЕсли;
	Если Сумма <= 0 Тогда
		РезультатПроверки.Сообщение = "Не заполнена сумма";
		Возврат РезультатПроверки;
	КонецЕсли;
	
	ПроверкаБП = ПроверитьЛимитПлановойЗаявки(КодСтатьи, Сумма, ДатаДокумента);
	РезультатПроверки.ЕстьЛимит = ПроверкаБП.ЕстьЛимит;
	РезультатПроверки.ОшибкаОбмена = ПроверкаБП.ОшибкаОбмена;
	РезультатПроверки.Сообщение = ПроверкаБП.Сообщение;
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ВыгрузитьПлановуюЗаявкуПослеРегистрации()
	
	ИмяСобытия = "ПлановаяЗаявкаДО";
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"После регистрации. рег.номер=[" + СокрЛП(Объект.РегистрационныйНомер) + "]");
	
	КодСтатьи = КодСтатьиДДС();
	Сумма = СуммаДокумента();
	СверхЛимит = СверхЛимитДокумента();
	ДатаДокумента = ДатаПлановойЗаявки();
	
	Проверка = ПроверитьЛимитПлановойЗаявки(КодСтатьи, Сумма, ДатаДокумента);
	Результат.Сообщение = Проверка.Сообщение;
	
	Если Проверка.ОшибкаОбмена Тогда
		Возврат Результат;
	КонецЕсли;
	Если Не Проверка.ЕстьЛимит И Не СверхЛимит Тогда
		Возврат Результат;
	КонецЕсли;
	
	Выгрузка = ВыгрузитьПлановуюЗаявкуВБП(КодСтатьи, Сумма, ДатаДокумента, СверхЛимит);
	Если Не Выгрузка.Успех Тогда
		Результат.Сообщение = СокрЛП(Результат.Сообщение + Символы.ПС + Выгрузка.Сообщение);
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Сообщение = СокрЛП(Проверка.Сообщение + Символы.ПС
		+ "Плановая заявка отправлена в БП и поставлена на согласование.");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверитьЛимитПлановойЗаявки(КодСтатьи, Сумма, ДатаДокумента)
	
	ИмяСобытия = "ПлановаяЗаявкаДО";
	РезультатПроверки = Новый Структура("ЕстьЛимит, ОшибкаОбмена, Сообщение", Ложь, Ложь, "");
	
	СтрокаЗапроса = Новый Структура;
	СтрокаЗапроса.Вставить("СтатьяДДС", КодСтатьи);
	СтрокаЗапроса.Вставить("Сумма", Сумма);
	СтрокаЗапроса.Вставить("ДатаПлатежа", Формат(ДатаДокумента, "ДФ=yyyyMMdd"));
	
	Массив = Новый Массив;
	Массив.Добавить(СтрокаЗапроса);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Лимит JSON=" + СтрокаJSON);
	
	ПараметрыПодключения = ПараметрыПодключенияКБППлановая();
	Путь = "/sah_buh_akea/hs/CheckLimitsDO/Ch";
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
	Исключение
		
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = "БП недоступна: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Плановая заявка в БП не отправлена.";
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат РезультатПроверки;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Лимит HTTP=" + Результат.КодСостояния
		+ " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
	Если Результат.КодСостояния = 401 Или Результат.КодСостояния = 403 Тогда
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = "БП вернула " + Результат.КодСостояния
			+ " (нет доступа). Это не превышение лимита. Проверьте пользователя и пароль HTTP-сервиса. Заявка в БП не отправлена.";
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Если Результат.КодСостояния <> 200 Или Не ЗначениеЗаполнено(ТелоОтвета) Тогда
		РезультатПроверки.ОшибкаОбмена = Истина;
		РезультатПроверки.Сообщение = "БП не вернула лимит (HTTP " + Результат.КодСостояния
			+ "). Заявка в БП не отправлена.";
		Возврат РезультатПроверки;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Данные = ПрочитатьJSON(ЧтениеJSON);
	
	Остаток = Неопределено;
	Дефицит = Неопределено;
	ИмяСтатьи = НаименованиеСтатьиДДС();
	
	Если ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0 Тогда
		СтрокаЛимита = Данные[0];
		РезультатПроверки.ЕстьЛимит = (СтрокаЛимита.success = Истина);
		Если СтрокаЛимита.Свойство("articleName") И ЗначениеЗаполнено(СтрокаЛимита.articleName) Тогда
			ИмяСтатьи = Строка(СтрокаЛимита.articleName);
		КонецЕсли;
		Если СтрокаЛимита.Свойство("remainder") И СтрокаЛимита.remainder <> Неопределено Тогда
			Остаток = ЧислоИзЗначенияЛимита(СтрокаЛимита.remainder);
		КонецЕсли;
		Если СтрокаЛимита.Свойство("deficit") И СтрокаЛимита.deficit <> Неопределено Тогда
			Дефицит = ЧислоИзЗначенияЛимита(СтрокаЛимита.deficit);
		ИначеЕсли Остаток <> Неопределено И Не РезультатПроверки.ЕстьЛимит Тогда
			Дефицит = Сумма - Остаток;
			Если Дефицит < 0 Тогда
				Дефицит = 0;
			КонецЕсли;
		КонецЕсли;
		Если СтрокаЛимита.Свойство("message") И ЗначениеЗаполнено(СтрокаЛимита.message)
			И СтрНайти(ВРег(СтрокаЛимита.message), "СТАТЬ") > 0 Тогда
			РезультатПроверки.Сообщение = СтрокаЛимита.message;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РезультатПроверки.Сообщение) Тогда
		Если Не ЗначениеЗаполнено(ИмяСтатьи) Тогда
			ИмяСтатьи = КодСтатьи;
		КонецЕсли;
		Если РезультатПроверки.ЕстьЛимит Тогда
			ТекстОстатка = ?(Остаток = Неопределено, "", Формат(Остаток, "ЧДЦ=2; ЧН=0; ЧГ="));
			РезультатПроверки.Сообщение = "По статье «" + ИмяСтатьи + "» лимит одобрен. Остаток: "
				+ ТекстОстатка + " руб.";
		ИначеЕсли Дефицит <> Неопределено Тогда
			РезультатПроверки.Сообщение = "По статье «" + ИмяСтатьи + "» превышен лимит на "
				+ Формат(Дефицит, "ЧДЦ=2; ЧН=0; ЧГ=") + " руб.";
		Иначе
			РезультатПроверки.Сообщение = "По статье «" + ИмяСтатьи + "» превышен лимит.";
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ВыгрузитьПлановуюЗаявкуВБП(КодСтатьи, Сумма, ДатаДокумента, СверхЛимит)
	
	ИмяСобытия = "ПлановаяЗаявкаДО";
	РезультатВыгрузки = Новый Структура("Успех, Сообщение", Ложь, "");
	
	ДокументJSON = Новый Структура;
	ДокументJSON.Вставить("ВидДокумента", "ПлановаяЗаявка");
	ДокументJSON.Вставить("ПлановаяЗаявка", Истина);
	ДокументJSON.Вставить("ИдентификаторДО", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	ДокументJSON.Вставить("КодСчета", СокрЛП(Объект.Код));
	ДокументJSON.Вставить("РегистрационныйНомер", СокрЛП(Объект.РегистрационныйНомер));
	ДокументJSON.Вставить("ДатаРегистрации", Формат(ДатаДокумента, "ДФ=yyyyMMdd"));
	ДокументJSON.Вставить("Заголовок", СокрЛП(Объект.Заголовок));
	ДокументJSON.Вставить("Сумма", Сумма);
	ДокументJSON.Вставить("СтатьяДДС", КодСтатьи);
	ДокументJSON.Вставить("СверхЛимит", СверхЛимит);
	ДокументJSON.Вставить("НазначениеПлатежа", НазначениеПлатежаДокумента());
	ДокументJSON.Вставить("ОрганизацияИНН", ИННОрганизации());
	
	Массив = Новый Массив;
	Массив.Добавить(ДокументJSON);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Выгрузка JSON=" + СтрокаJSON);
	
	ПараметрыПодключения = ПараметрыПодключенияКБППлановая();
	Путь = "/sah_buh_akea/hs/ImportFromDO/Download";
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
	Исключение
		
		РезультатВыгрузки.Сообщение = "Не удалось выгрузить в БП: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат РезультатВыгрузки;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Выгрузка HTTP=" + Результат.КодСостояния
		+ " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
	УспехПоТелу = (Результат.КодСостояния = 200);
	Если ЗначениеЗаполнено(ТелоОтвета) Тогда
		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			Данные = ПрочитатьJSON(ЧтениеJSON);
			Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("success") Тогда
				УспехПоТелу = (Данные.success = Истина);
				Если Данные.Свойство("message") И ЗначениеЗаполнено(Данные.message) Тогда
					РезультатВыгрузки.Сообщение = Строка(Данные.message);
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	РезультатВыгрузки.Успех = УспехПоТелу;
	Если РезультатВыгрузки.Успех И Не ЗначениеЗаполнено(РезультатВыгрузки.Сообщение) Тогда
		РезультатВыгрузки.Сообщение = "Плановая заявка создана в БП";
	ИначеЕсли Не РезультатВыгрузки.Успех И Не ЗначениеЗаполнено(РезультатВыгрузки.Сообщение) Тогда
		РезультатВыгрузки.Сообщение = "БП вернула " + Результат.КодСостояния + ": " + ТелоОтвета;
	КонецЕсли;
	
	Возврат РезультатВыгрузки;
	
КонецФункции

&НаСервере
Процедура УстановитьСостояниеНаСогласовании()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСостояния = Новый Структура("Состояние, Установил, Период, НачальноеСостояние",
		Перечисления.СостоянияДокументов.НаСогласовании,
		ПользователиКлиентСервер.ТекущийПользователь(),
		ТекущаяДатаСеанса(),
		Перечисления.СостоянияДокументов.ПустаяСсылка());
	
	МассивСостояний = Новый Массив;
	МассивСостояний.Добавить(СтруктураСостояния);
	ИзменитьСостояние(Объект.Ссылка, МассивСостояний);
	
	ЗаписьЖурналаРегистрации("ПлановаяЗаявкаДО", УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Состояние: На согласовании");
	
КонецПроцедуры

