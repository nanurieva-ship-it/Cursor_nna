// Фрагмент расширения формы элемента справочника ВнутренниеДокументы (ДО).
// Вставить вместо текущих ПроверитьЛимитВДО / вызова в ПередЗаписью.
//
// Схема: ПередЗаписью → ПроверитьЛимитВДО (HTTP CheckLimits) → разобрать JSON.
// После записи → ВыгрузитьСчетВБП (HTTP Download) — как сейчас в ПослеЗаписиНаСервере.

#Область ПроверкаЛимитов

&НаКлиенте
Процедура _ПередЗаписьюПроверкаЛимитов(Отказ, ПараметрыЗаписи)
	
	Если Строка(Объект.ВидДокумента.УникальныйИдентификатор()) <> "361540bf-73d5-11ee-be26-3cecef19f70b" Тогда
		Возврат;
	КонецЕсли;
	
	РезультатПроверки = ПроверитьЛимитВДО();
	
	Если Не РезультатПроверки.Успех Тогда
		ПоказатьПредупреждение(, РезультатПроверки.Сообщение);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если РезультатПроверки.ПревышениеЛимита Тогда
		Текст = ТекстПревышенияЛимитов(РезультатПроверки.Лимиты);
		ПоказатьПредупреждение(, Текст);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЛимитВДО()
	
	РезультатПроверки = Новый Структура("Успех, ПревышениеЛимита, Сообщение, Лимиты",
		Ложь, Ложь, "", Новый Массив);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		ТелоЗапроса = СобратьJSONПроверкиЛимитов();
		HTTPОтвет = ОтправитьВБП("/sah_buh_akea/hs/ImportFromDO/CheckLimits", ТелоЗапроса);
		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
		
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			РезультатПроверки.Сообщение = СтрШаблон(
				"БП вернула код %1. Тело: %2", HTTPОтвет.КодСостояния, ТелоОтвета);
			Возврат РезультатПроверки;
		КонецЕсли;
		
		Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
		
		РезультатПроверки.Успех = БулевоСвойства(Данные, "success", Ложь);
		РезультатПроверки.ПревышениеЛимита = БулевоСвойства(Данные, "overLimit", Ложь);
		РезультатПроверки.Сообщение = СтрокаСвойства(Данные, "message", "");
		
		Лимиты = Неопределено;
		Если Данные.Свойство("limits", Лимиты) И ТипЗнч(Лимиты) = Тип("Массив") Тогда
			РезультатПроверки.Лимиты = Лимиты;
		КонецЕсли;
		
		Если Не РезультатПроверки.Успех И Не ЗначениеЗаполнено(РезультатПроверки.Сообщение) Тогда
			РезультатПроверки.Сообщение = "БП не подтвердила лимиты";
		КонецЕсли;
		
	Исключение
		
		РезультатПроверки.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция СобратьJSONПроверкиЛимитов()
	
	Структура = Новый Структура;
	
	Структура.Вставить("КодСчета", Строка(Объект.Код));
	Структура.Вставить("Сумма", СтрЗаменить(СтрЗаменить(Строка(Объект.Сумма), " ", ""), Символы.НПП, ""));
	
	СтатьяКод = "";
	СтатьяНаим = "";
	НаборЗаписей = РегистрыСведений.СтатьиДвиженияДенежныхСредствДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(Объект.Ссылка);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда
		СтатьяКод = Строка(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств.Код);
		СтатьяНаим = Строка(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств);
	ИначеЕсли СтатьиДвиженияДенежныхСредств.Количество() > 0 Тогда
		СтатьяКод = Строка(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств.Код);
		СтатьяНаим = Строка(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств);
	КонецЕсли;
	Структура.Вставить("СтатьяДДС", СтатьяКод);
	Структура.Вставить("СтатьяДДСНаим", СтатьяНаим);
	
	СтруктураСтрокОплат = Новый Структура;
	НомерСтроки = 1;
	Для Каждого ТекСтр Из Объект.ГрафикПлатежей Цикл
		СтруктураСтроки = Новый Структура;
		СтруктураСтроки.Вставить("ДатаПлатежа", Формат(ТекСтр.ДатаПлатежа, "ДЛФ=Д"));
		СтруктураСтроки.Вставить("Сумма", ТекСтр.Сумма);
		СтруктураСтроки.Вставить("Согласовано", ТекСтр.Согласовано);
		СтруктураСтрокОплат.Вставить("Стр" + Формат(НомерСтроки, "ЧГ="), СтруктураСтроки);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Структура.Вставить("ГрафикПлатежей", СтруктураСтрокОплат);
	
	Массив = Новый Массив;
	Массив.Добавить(Структура);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

&НаСервере
Функция ОтправитьВБП(Путь, СтрокаJSON)
	
	// Хост, порт, пользователь — из константы / регистра сведений, не из модуля формы.
	ПараметрыПодключения = ПараметрыПодключенияКБП();
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	HTTPСоединение = Новый HTTPСоединение(
		ПараметрыПодключения.Сервер,
		ПараметрыПодключения.Порт,
		ПараметрыПодключения.Пользователь,
		ПараметрыПодключения.Пароль,
		,
		,
		ЗащищенноеСоединение);
	
	ЗапросPOST = Новый HTTPЗапрос(Путь);
	ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
	
КонецФункции

&НаСервере
Функция ПараметрыПодключенияКБП()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
	ПараметрыПодключения.Вставить("Порт", 59795);
	ПараметрыПодключения.Вставить("Пользователь", "");
	ПараметрыПодключения.Вставить("Пароль", "");
	Возврат ПараметрыПодключения;
	
КонецФункции

&НаСервере
Функция ПрочитатьJSONИзСтроки(СтрокаJSON)
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(ЧтениеJSON);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстПревышенияЛимитов(Лимиты)
	
	Строки = Новый Массив;
	Строки.Добавить("Превышен лимит графика платежей:");
	
	Для Каждого СтрокаЛимита Из Лимиты Цикл
		Строки.Добавить(СтрШаблон(
			"%1 (%2): заявка %3, остаток %4",
			СтрокаСвойства(СтрокаЛимита, "articleName", ""),
			СтрокаСвойства(СтрокаЛимита, "articleCode", ""),
			Формат(ЧислоСвойства(СтрокаЛимита, "requestAmount"), "ЧДЦ=2; ЧН=0"),
			Формат(ЧислоСвойства(СтрокаЛимита, "remainder"), "ЧДЦ=2; ЧН=0")));
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СтрокаСвойства(Данные, Имя, ЗначениеПоУмолчанию)
	
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Значение) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция БулевоСвойства(Данные, Имя, ЗначениеПоУмолчанию)
	
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение = Истина;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЧислоСвойства(Данные, Имя)
	
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

#КонецОбласти
