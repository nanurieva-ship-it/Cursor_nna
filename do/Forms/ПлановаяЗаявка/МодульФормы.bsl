// Расширение формы внутреннего документа вида «Плановая заявка» (ДО).
// Перед отправкой — лимит в БП. При успехе — заявка в БП с ПлановаяЗаявка = Истина.
// Журнал: ПлановаяЗаявкаДО.
//
// Подставьте UUID вида документа после создания вида в ДО.

&НаКлиенте
Процедура ОтправитьПлановуюЗаявку(Команда)
	
	Если Не ЭтоПлановаяЗаявка() Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ОтправитьПлановуюЗаявкуНаСервере();
	ПоказатьПредупреждение(, Результат.Сообщение);
	
КонецПроцедуры

&НаСервере
Функция ЭтоПлановаяЗаявка()
	
	// Замените на UUID вида «Плановая заявка» из вашей базы ДО.
	ИдентификаторВида = "00000000-0000-0000-0000-000000000000";
	Возврат Строка(Объект.ВидДокумента.УникальныйИдентификатор()) = ИдентификаторВида
		Или ВРег(СокрЛП(Строка(Объект.ВидДокумента))) = ВРег("Плановая заявка")
		Или ВРег(СокрЛП(Строка(Объект.ВидДокумента))) = ВРег("Плановая заявка на оплату");
	
КонецФункции

&НаСервере
Функция ОтправитьПлановуюЗаявкуНаСервере()
	
	ИмяСобытия = "ПлановаяЗаявкаДО";
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Старт отправки. СсылкаЗаполнена=" + (ЗначениеЗаполнено(Объект.Ссылка)));
	
	КодСтатьи = КодСтатьиДДС();
	Сумма = СуммаДокумента();
	СверхЛимит = СверхЛимитДокумента();
	ДатаДокумента = ?(ЗначениеЗаполнено(Объект.ДатаРегистрации), Объект.ДатаРегистрации, ТекущаяДатаСеанса());
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Статья=[" + КодСтатьи + "] Сумма=" + Формат(Сумма, "ЧРД=.; ЧГ=")
		+ " СверхЛимит=" + (СверхЛимит)
		+ " Дата=" + Формат(ДатаДокумента, "ДФ=yyyyMMdd"));
	
	Если Не ЗначениеЗаполнено(КодСтатьи) Тогда
		Результат.Сообщение = "Не заполнена статья ДДС";
		Возврат Результат;
	КонецЕсли;
	Если Сумма <= 0 Тогда
		Результат.Сообщение = "Не заполнена сумма";
		Возврат Результат;
	КонецЕсли;
	
	Проверка = ПроверитьЛимитПлановойЗаявки(КодСтатьи, Сумма, ДатаДокумента);
	Результат.Сообщение = Проверка.Сообщение;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Лимит ЕстьЛимит=" + (Проверка.ЕстьЛимит) + " " + Проверка.Сообщение);
	
	Если Не Проверка.ЕстьЛимит И Не СверхЛимит Тогда
		Результат.Успех = Ложь;
		Возврат Результат;
	КонецЕсли;
	
	Выгрузка = ВыгрузитьПлановуюЗаявкуВБП(КодСтатьи, Сумма, ДатаДокумента, СверхЛимит);
	Если Не Выгрузка.Успех Тогда
		Результат.Сообщение = СокрЛП(Результат.Сообщение + Символы.ПС + Выгрузка.Сообщение);
		Возврат Результат;
	КонецЕсли;
	
	УстановитьСостояниеОтправлен();
	Результат.Успех = Истина;
	Результат.Сообщение = СокрЛП(Проверка.Сообщение + Символы.ПС + "Плановая заявка отправлена в БП.");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПроверитьЛимитПлановойЗаявки(КодСтатьи, Сумма, ДатаДокумента)
	
	ИмяСобытия = "ПлановаяЗаявкаДО";
	РезультатПроверки = Новый Структура("ЕстьЛимит, Сообщение", Ложь, "");
	
	СтрокаЗапроса = Новый Структура;
	СтрокаЗапроса.Вставить("СтатьяДДС", КодСтатьи);
	СтрокаЗапроса.Вставить("Сумма", Сумма);
	СтрокаЗапроса.Вставить("ДатаПлатежа", Формат(ДатаДокумента, "ДФ=yyyyMMdd"));
	
	Массив = Новый Массив;
	Массив.Добавить(СтрокаЗапроса);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Лимит JSON=" + СтрокаJSON);
	
	ПараметрыПодключения = ПараметрыПодключенияКБП();
	Путь = "/sah_buh_akea/hs/CheckLimitsDO/Ch";
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
	Исключение
		
		РезультатПроверки.Сообщение = "БП недоступна: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат РезультатПроверки;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Лимит HTTP=" + Результат.КодСостояния
		+ " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
	Если Результат.КодСостояния <> 200 Или Не ЗначениеЗаполнено(ТелоОтвета) Тогда
		РезультатПроверки.Сообщение = "БП не вернула лимит. HTTP " + Результат.КодСостояния;
		Возврат РезультатПроверки;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Данные = ПрочитатьJSON(ЧтениеJSON);
	
	Если ТипЗнч(Данные) = Тип("Массив") И Данные.Количество() > 0 Тогда
		СтрокаЛимита = Данные[0];
		РезультатПроверки.ЕстьЛимит = (СтрокаЛимита.success = Истина);
		Если СтрокаЛимита.Свойство("message") И ЗначениеЗаполнено(СтрокаЛимита.message) Тогда
			РезультатПроверки.Сообщение = СтрокаЛимита.message;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(РезультатПроверки.Сообщение) Тогда
		Если РезультатПроверки.ЕстьЛимит Тогда
			РезультатПроверки.Сообщение = "Лимит одобрен.";
		Иначе
			РезультатПроверки.Сообщение = "Лимит превышен.";
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ВыгрузитьПлановуюЗаявкуВБП(КодСтатьи, Сумма, ДатаДокумента, СверхЛимит)
	
	ИмяСобытия = "ПлановаяЗаявкаДО";
	РезультатВыгрузки = Новый Структура("Успех, Сообщение", Ложь, "");
	
	ДокументJSON = Новый Структура;
	ДокументJSON.Вставить("ВидДокумента", "ПлановаяЗаявка");
	ДокументJSON.Вставить("ПлановаяЗаявка", Истина);
	ДокументJSON.Вставить("ИдентификаторДО", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	ДокументJSON.Вставить("КодСчета", СокрЛП(Объект.Код));
	ДокументJSON.Вставить("РегистрационныйНомер", СокрЛП(Объект.РегистрационныйНомер));
	ДокументJSON.Вставить("ДатаРегистрации", Формат(ДатаДокумента, "ДФ=yyyyMMdd"));
	ДокументJSON.Вставить("Заголовок", СокрЛП(Объект.Заголовок));
	ДокументJSON.Вставить("Сумма", Сумма);
	ДокументJSON.Вставить("СтатьяДДС", КодСтатьи);
	ДокументJSON.Вставить("СверхЛимит", СверхЛимит);
	ДокументJSON.Вставить("НазначениеПлатежа", НазначениеПлатежаДокумента());
	ДокументJSON.Вставить("ОрганизацияИНН", ИННОрганизации());
	
	Массив = Новый Массив;
	Массив.Добавить(ДокументJSON);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Массив);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Выгрузка JSON=" + СтрокаJSON);
	
	ПараметрыПодключения = ПараметрыПодключенияКБП();
	Путь = "/sah_buh_akea/hs/ImportFromDO/Download";
	
	Попытка
		
		HTTPСоединение = Новый HTTPСоединение(
			ПараметрыПодключения.Сервер,
			ПараметрыПодключения.Порт,
			ПараметрыПодключения.Пользователь,
			ПараметрыПодключения.Пароль,
			,
			,
			Новый ЗащищенноеСоединениеOpenSSL);
		
		ЗапросPOST = Новый HTTPЗапрос(Путь);
		ЗапросPOST.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ЗапросPOST.УстановитьТелоИзСтроки(СтрокаJSON, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку("UTF-8");
		
	Исключение
		
		РезультатВыгрузки.Сообщение = "Не удалось выгрузить в БП: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , Объект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат РезультатВыгрузки;
		
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Выгрузка HTTP=" + Результат.КодСостояния
		+ " пустое=" + (Не ЗначениеЗаполнено(ТелоОтвета))
		+ " тело=" + Лев(ТелоОтвета, 2000));
	
	Если Результат.КодСостояния = 200 Тогда
		РезультатВыгрузки.Успех = Истина;
		РезультатВыгрузки.Сообщение = "Заявка создана в БП";
	Иначе
		РезультатВыгрузки.Сообщение = "БП вернула " + Результат.КодСостояния + ": " + ТелоОтвета;
	КонецЕсли;
	
	Возврат РезультатВыгрузки;
	
КонецФункции

&НаСервере
Процедура УстановитьСостояниеОтправлен()
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Состояние = Неопределено;
	Попытка
		Состояние = Перечисления.СостоянияДокументов.Отправлен;
	Исключение
		Состояние = Перечисления.СостоянияДокументов.НаСогласовании;
	КонецПопытки;
	
	СтруктураСостояния = Новый Структура("Состояние, Установил, Период, НачальноеСостояние",
		Состояние,
		ПользователиКлиентСервер.ТекущийПользователь(),
		ТекущаяДатаСеанса(),
		Перечисления.СостоянияДокументов.ПустаяСсылка());
	
	МассивСостояний = Новый Массив;
	МассивСостояний.Добавить(СтруктураСостояния);
	ИзменитьСостояние(Объект.Ссылка, МассивСостояний);
	
	ЗаписьЖурналаРегистрации("ПлановаяЗаявкаДО", УровеньЖурналаРегистрации.Информация, , Объект.Ссылка,
		"Состояние установлено: " + Строка(Состояние));
	
КонецПроцедуры

&НаСервере
Функция КодСтатьиДДС()
	
	Если СтатьиДвиженияДенежныхСредств.Количество() > 0 Тогда
		Возврат СокрЛП(СтатьиДвиженияДенежныхСредств[0].СтатьяДвиженияДенежныхСредств.Код);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		НаборЗаписей = РегистрыСведений.СтатьиДвиженияДенежныхСредствДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Документ.Установить(Объект.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			Возврат СокрЛП(НаборЗаписей[0].СтатьяДвиженияДенежныхСредств.Код);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция СуммаДокумента()
	
	Попытка
		Возврат Объект.Сумма;
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция СверхЛимитДокумента()
	
	Попытка
		Возврат (Объект.СверхЛимит = Истина);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция НазначениеПлатежаДокумента()
	
	Попытка
		Возврат СокрЛП(Объект.НазначениеПлатежа);
	Исключение
		Возврат СокрЛП(Объект.Содержание);
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ИННОрганизации()
	
	Попытка
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			Возврат СокрЛП(Объект.Организация.ИНН);
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ПараметрыПодключенияКБП()
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("Сервер", "1c.sah18.ru");
	ПараметрыПодключения.Вставить("Порт", 59795);
	ПараметрыПодключения.Вставить("Пользователь", "Аналитик");
	ПараметрыПодключения.Вставить("Пароль", "");
	Возврат ПараметрыПодключения;
	
КонецФункции
