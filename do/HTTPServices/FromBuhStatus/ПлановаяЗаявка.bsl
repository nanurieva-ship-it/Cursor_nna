// Доп. метод HTTP-сервиса FromBuhStatus: шаблон DownloadPlanStatus → ЗагрузкаСтатусаПлановой.
// БП шлёт Одобрен / Отклонен по плановой заявке. Журнал: FromBuhStatus.

Функция ЗагрузкаСтатусаПлановой(Запрос)
	
	ИмяСобытия = "FromBuhStatus";
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Старт ЗагрузкаСтатусаПлановой");
	
	Попытка
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело длина=" + Формат(СтрДлина(ТелоЗапроса), "ЧН=0; ЧГ=")
			+ " пустое=" + (Не ЗначениеЗаполнено(ТелоЗапроса))
			+ " текст=" + Лев(ТелоЗапроса, 2000));
		
		Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Возврат ОтветJSONПлановой(Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
			СтруктураИзБух = ДанныеЗапроса[0];
		Иначе
			СтруктураИзБух = ДанныеЗапроса;
		КонецЕсли;
		
		КодСчета = СокрЛП(Строка(ЗначениеСвойстваПлановой(СтруктураИзБух, "КодСчета", "")));
		СтатусТекст = ВРег(СокрЛП(Строка(ЗначениеСвойстваПлановой(СтруктураИзБух, "Статус", ""))));
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"КодСчета=[" + КодСчета + "] Статус=[" + СтатусТекст + "]");
		
		НайдСчет = НайтиСчетВДО(КодСчета, ИмяСобытия);
		Если Не ЗначениеЗаполнено(НайдСчет) Тогда
			Возврат ОтветJSONПлановой(Ложь, "Плановая заявка не найдена: " + КодСчета);
		КонецЕсли;
		
		Если СтатусТекст = "ОДОБРЕН" Или СтатусТекст = "ОДОБРЕНА" Или СтатусТекст = "APPROVED" Тогда
			УстановитьСостояниеПоИмени(НайдСчет, "Согласован", ИмяСобытия);
			СоздатьПодзадачуСчетНаОплату(НайдСчет, ИмяСобытия);
			Возврат ОтветJSONПлановой(Истина, "Одобрена. Создана подзадача на счёт.", НайдСчет);
		ИначеЕсли СтатусТекст = "ОТКЛОНЕН" Или СтатусТекст = "ОТКЛОНЕНА" Или СтатусТекст = "REJECTED" Тогда
			УстановитьСостояниеПоИмени(НайдСчет, "НеСогласован", ИмяСобытия);
			Возврат ОтветJSONПлановой(Истина, "Отклонена. Состояние сброшено.", НайдСчет);
		КонецЕсли;
		
		Возврат ОтветJSONПлановой(Ложь, "Неизвестный статус: " + СтатусТекст);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветJSONПлановой(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецФункции

Процедура УстановитьСостояниеПоИмени(ДокументСсылка, ИмяСостояния, ИмяСобытия)
	
	Состояние = Неопределено;
	Если ИмяСостояния = "Согласован" Тогда
		Состояние = Перечисления.СостоянияДокументов.Согласован;
	Иначе
		Попытка
			Состояние = Перечисления.СостоянияДокументов.НеСогласован;
		Исключение
			Состояние = Перечисления.СостоянияДокументов.НаСогласовании;
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		Делопроизводство.ЗаписатьСостояниеДокумента(
			ДокументСсылка,
			ТекущаяДатаСеанса(),
			Состояние,
			ПользователиКлиентСервер.ТекущийПользователь());
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ДокументСсылка,
			"Состояние плановой: " + Строка(Состояние));
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ДокументСсылка,
			"Не удалось сменить состояние: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьПодзадачуСчетНаОплату(ПлановаяСсылка, ИмяСобытия)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ПлановаяСсылка,
		"Создание подзадачи «Создать документ Счет на оплату»");
	
	// Штатное поручение / задача ДО — подставьте ваш общий модуль.
	// Тема: Создать документ Счет на оплату
	// Предмет: ПлановаяСсылка
	// Исполнитель: ответственный плановой заявки
	
	Попытка
		Ответственный = ПлановаяСсылка.Ответственный;
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ПлановаяСсылка,
			"Ответственный=" + Строка(Ответственный) + ". Вызов создания задачи — в расширении ДО.");
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ПлановаяСсылка,
			"Нет реквизита Ответственный: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ОтветJSONПлановой(Успех, Сообщение, Счет = Неопределено)
	
	Возврат ОтветJSON(Успех, Сообщение, Счет);
	
КонецФункции

Функция ЗначениеСвойстваПлановой(Данные, Имя, ЗначениеПоУмолчанию)
	
	Возврат ЗначениеСвойства(Данные, Имя, ЗначениеПоУмолчанию);
	
КонецФункции
