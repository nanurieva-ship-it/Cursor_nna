// =============================================================================
// ТОЛЬКО HTTP-сервис ДО: ФУ_ЗагрузкаСтатусовИзБух
// Конфигуратор: HTTP-сервисы → ФУ_ЗагрузкаСтатусовИзБух → модуль
// Шаблоны: DownloadStatus → ЗагрузкаСтатусаStatus
//          DownloadPlanStatus → ЗагрузкаСтатусаPlanStatus
//
// НЕ вставлять в форму Справочник.ВнутренниеДокументы — там файл do/FormExtension.bsl
// Журнал: событие «FromBuhStatus»
// =============================================================================

Функция ЗагрузкаСтатусаStatus(Запрос)
	
	ИмяСобытия = "FromBuhStatus";
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Старт ЗагрузкаСтатусаStatus. Пользователь=" + Строка(ПользователиИнформационнойБазы.ТекущийПользователь())
		+ " привилегированный=" + (ПривилегированныйРежим()));
	
	Попытка
		
		МетодЗапроса = "";
		Попытка
			МетодЗапроса = Строка(Запрос.HTTPМетод);
		Исключение
			МетодЗапроса = "?";
		КонецПопытки;
		
		БазовыйURL = "";
		Попытка
			БазовыйURL = Строка(Запрос.БазовыйURL);
		Исключение
		КонецПопытки;
		
		ОтносительныйURL = "";
		Попытка
			ОтносительныйURL = Строка(Запрос.ОтносительныйURL);
		Исключение
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"HTTP " + МетодЗапроса + " " + БазовыйURL + ОтносительныйURL);
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело длина=" + Формат(СтрДлина(ТелоЗапроса), "ЧН=0; ЧГ=")
			+ " пустое=" + (Не ЗначениеЗаполнено(ТелоЗапроса))
			+ " текст=" + Лев(ТелоЗапроса, 2000));
		
		Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
				"Отказ: пустое тело запроса");
			Возврат ОтветJSON(Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"JSON разобран. ТипКорня=" + Строка(ТипЗнч(ДанныеЗапроса))
			+ ?(ТипЗнч(ДанныеЗапроса) = Тип("Массив"),
				" количество=" + ДанныеЗапроса.Количество(),
				""));
		
		Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
			Если ДанныеЗапроса.Количество() = 0 Тогда
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
					"Отказ: пустой массив");
				Возврат ОтветJSON(Ложь, "Пустой массив в теле запроса");
			КонецЕсли;
			СтруктураИзБух = ДанныеЗапроса[0];
		Иначе
			СтруктураИзБух = ДанныеЗапроса;
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тип элемента=" + Строка(ТипЗнч(СтруктураИзБух))
			+ " ключи=" + КлючиСтруктурыСтрокой(СтруктураИзБух));
		
		СыройКод = ЗначениеСвойства(СтруктураИзБух, "КодСчета", "");
		СыраяДата = ЗначениеСвойства(СтруктураИзБух, "ДатаПлатежа", Неопределено);
		СыройСтатус = ЗначениеСвойства(СтруктураИзБух, "Статус", Ложь);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Сырые поля: КодСчета тип=" + Строка(ТипЗнч(СыройКод)) + " значение=[" + Строка(СыройКод) + "]"
			+ " ДатаПлатежа тип=" + Строка(ТипЗнч(СыраяДата)) + " значение=[" + Строка(СыраяДата) + "]"
			+ " Статус тип=" + Строка(ТипЗнч(СыройСтатус)) + " значение=[" + Строка(СыройСтатус) + "]"
			+ " Оплачена=[" + Строка(ЗначениеСвойства(СтруктураИзБух, "Оплачена", "")) + "]");
		
		КодСчета = СокрЛП(Строка(СыройКод));
		ДатаИзБух = ДатаИзЗначения(СыраяДата);
		Статус = БулевоИзЗначения(СыройСтатус);
		ПлановаяИзJSON = ЭтоПризнакПлановойВJSON(СтруктураИзБух);
		ОплатаИзJSON = ЭтоПризнакОплатыВJSON(СтруктураИзБух);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"После разбора: КодСчета=[" + КодСчета + "]"
			+ " Дата=" + Формат(ДатаИзБух, "ДФ=yyyyMMdd; ДП=00010101")
			+ " заполнена=" + (ЗначениеЗаполнено(ДатаИзБух))
			+ " Статус=" + (Статус)
			+ " ПлановаяJSON=" + (ПлановаяИзJSON)
			+ " ОплатаJSON=" + (ОплатаИзJSON));
		
		Если Не ЗначениеЗаполнено(КодСчета) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
				"Отказ: не передан КодСчета");
			Возврат ОтветJSON(Ложь, "Не передан КодСчета");
		КонецЕсли;
		
		НайдСчет = НайтиСчетВДО(КодСчета, ИмяСобытия);
		Если Не ЗначениеЗаполнено(НайдСчет) Тогда
			Текст = "Счёт в ДО не найден ни по коду, ни по регистрационному номеру: [" + КодСчета + "]";
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		Если ОплатаИзJSON Тогда
			Возврат ОбработатьОплатуДокумента(НайдСчет, ИмяСобытия);
		КонецЕсли;
		
		СчетОбъект = НайдСчет.ПолучитьОбъект();
		КоличествоСтрок = 0;
		Попытка
			КоличествоСтрок = СчетОбъект.ГрафикПлатежей.Количество();
		Исключение
			КоличествоСтрок = 0;
		КонецПопытки;
		
		Если ПлановаяИзJSON Или ЭтоПлановаяЗаявкаДО(НайдСчет) Или КоличествоСтрок = 0 Тогда
			Возврат ОбработатьСтатусПлановойЗаявки(НайдСчет, Статус, ИмяСобытия);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДатаИзБух) Тогда
			Текст = "Не разобрана ДатаПлатежа: " + Строка(СыраяДата);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , "Отказ: " + Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Найден счёт ссылка=" + Строка(НайдСчет)
			+ " код=[" + СокрЛП(НайдСчет.Код) + "]"
			+ " рег.номер=[" + СокрЛП(НайдСчет.РегистрационныйНомер) + "]"
			+ " помечен=" + (НайдСчет.ПометкаУдаления)
			+ " строкГрафика=" + КоличествоСтрок);
		
		ИзмДок = Ложь;
		НайденныеДаты = Новый Массив;
		НомерСтроки = 0;
		
		Для Каждого ТекГрафик Из СчетОбъект.ГрафикПлатежей Цикл
			
			НомерСтроки = НомерСтроки + 1;
			ДатаСтроки = НачалоДня(ТекГрафик.ДатаПлатежа);
			СогласованоБыло = Неопределено;
			Попытка
				СогласованоБыло = ТекГрафик.Согласовано;
			Исключение
				СогласованоБыло = "?";
			КонецПопытки;
			
			НайденныеДаты.Добавить(Формат(ДатаСтроки, "ДФ=yyyyMMdd"));
			Совпадает = (ДатаСтроки = НачалоДня(ДатаИзБух));
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
				"График[" + НомерСтроки + "] датаДок=" + Формат(ДатаСтроки, "ДФ=yyyyMMdd")
				+ " датаБП=" + Формат(НачалоДня(ДатаИзБух), "ДФ=yyyyMMdd")
				+ " совпадает=" + (Совпадает)
				+ " СогласованоБыло=" + Строка(СогласованоБыло));
			
			Если Совпадает Тогда
				ТекГрафик.Согласовано = Статус;
				ИзмДок = Истина;
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
					"Строка " + НомерСтроки + ": Согласовано " + Строка(СогласованоБыло) + " → " + (Статус));
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ИзмДок Тогда
			Если КоличествоСтрок = 0 И ЭтоПлановаяЗаявкаДО(НайдСчет) Тогда
				Возврат ОбработатьСтатусПлановойЗаявки(НайдСчет, Статус, ИмяСобытия);
			КонецЕсли;
			Текст = "В графике счёта нет даты " + Формат(ДатаИзБух, "ДФ=dd.MM.yyyy")
				+ ". Строк=" + КоличествоСтрок
				+ ". Даты в ДО: " + СтрСоединить(НайденныеДаты, ", ");
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , НайдСчет, Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Перед Записать()");
		
		Попытка
			СчетОбъект.Записать();
		Исключение
			Текст = "Не удалось записать счёт: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , НайдСчет,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат ОтветJSON(Ложь, Текст);
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Записано. Согласовано=" + (Статус) + " дата=" + Формат(ДатаИзБух, "ДФ=dd.MM.yyyy"));
		
		СообщениеОтвета = ОбновитьСостояниеПоГрафику(СчетОбъект, НайдСчет, ИмяСобытия);
		
		Возврат ОтветJSON(Истина, СообщениеОтвета, НайдСчет);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			"Исключение в ЗагрузкаСтатусаStatus: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветJSON(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецФункции

Функция ВесьГрафикСогласован(СчетОбъект, СчетСсылка, ИмяСобытия)
	
	Всего = СчетОбъект.ГрафикПлатежей.Количество();
	Если Всего = 0 Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
			"График пустой — состояние Согласован не ставим");
		Возврат Ложь;
	КонецЕсли;
	
	СогласованоСтрок = 0;
	НомерСтроки = 0;
	Для Каждого СтрокаГрафика Из СчетОбъект.ГрафикПлатежей Цикл
		НомерСтроки = НомерСтроки + 1;
		СтрокаСогласована = (СтрокаГрафика.Согласовано = Истина);
		Если СтрокаСогласована Тогда
			СогласованоСтрок = СогласованоСтрок + 1;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"Проверка графика[" + НомерСтроки + "] дата=" + Формат(СтрокаГрафика.ДатаПлатежа, "ДФ=yyyyMMdd")
			+ " Согласовано=" + (СтрокаГрафика.Согласовано));
	КонецЦикла;
	
	Весь = (СогласованоСтрок = Всего);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
		"Итог графика: согласовано " + СогласованоСтрок + " из " + Всего + " весь=" + (Весь));
	
	Возврат Весь;
	
КонецФункции

Функция ОбновитьСостояниеПоГрафику(СчетОбъект, СчетСсылка, ИмяСобытия)
	
	ВесьСогласован = ВесьГрафикСогласован(СчетОбъект, СчетСсылка, ИмяСобытия);
	Если СчетОбъект.ГрафикПлатежей.Количество() = 0 Тогда
		Возврат "Согласование записано";
	КонецЕсли;
	
	Если ВесьСогласован Тогда
		ЦелевоеСостояние = Перечисления.СостоянияДокументов.Согласован;
		ИмяЦелевого = "Согласован";
	Иначе
		ЦелевоеСостояние = Перечисления.СостоянияДокументов.НаСогласовании;
		ИмяЦелевого = "На согласовании";
	КонецЕсли;
	
	ТекущееСостояние = ПолучитьТекущееСостояниеДокумента(СчетСсылка, ИмяСобытия);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
		"Состояние сейчас=[" + Строка(ТекущееСостояние) + "] цель=[" + ИмяЦелевого
		+ "] весьГрафик=" + (ВесьСогласован));
	
	Если ЗначениеЗаполнено(ТекущееСостояние) И ТекущееСостояние = ЦелевоеСостояние Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"Состояние уже " + ИмяЦелевого + ", не переписываем");
		Возврат "Согласование записано. Состояние документа: " + ИмяЦелевого;
	КонецЕсли;
	
	Если УстановитьСостояниеДокумента(СчетСсылка, ЦелевоеСостояние, ИмяЦелевого, ИмяСобытия) Тогда
		Если ВесьСогласован Тогда
			Возврат "Согласование записано. Состояние документа: Согласован";
		КонецЕсли;
		Возврат "Строка снята. Состояние документа сброшено: На согласовании";
	КонецЕсли;
	
	Если ВесьСогласован Тогда
		Возврат "График согласован полностью, но состояние документа сменить не удалось. Смотрите журнал FromBuhStatus";
	КонецЕсли;
	Возврат "Строка снята, но состояние Согласован сбросить не удалось. Смотрите журнал FromBuhStatus";
	
КонецФункции

Функция ПолучитьТекущееСостояниеДокумента(СчетСсылка, ИмяСобытия)
	
	Попытка
		Состояния = Делопроизводство.ПолучитьСостоянияДокумента(СчетСсылка);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"ПолучитьСостоянияДокумента тип=" + Строка(ТипЗнч(Состояния)) + " значение=" + Строка(Состояния));
		Если ТипЗнч(Состояния) = Тип("Массив") Тогда
			Для Каждого Элемент Из Состояния Цикл
				Если Элемент = Перечисления.СостоянияДокументов.Согласован
					Или Элемент = Перечисления.СостоянияДокументов.НаСогласовании Тогда
					Возврат Элемент;
				КонецЕсли;
			КонецЦикла;
			Если Состояния.Количество() > 0 Тогда
				Возврат Состояния[0];
			КонецЕсли;
		ИначеЕсли ТипЗнч(Состояния) = Тип("Соответствие") Тогда
			Для Каждого КлючИЗначение Из Состояния Цикл
				Значение = КлючИЗначение.Значение;
				Если Значение = Перечисления.СостоянияДокументов.Согласован
					Или Значение = Перечисления.СостоянияДокументов.НаСогласовании Тогда
					Возврат Значение;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ТипЗнч(Состояния) = Тип("ПеречислениеСсылка.СостоянияДокументов") Тогда
			Возврат Состояния;
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
			"Не удалось прочитать состояние: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Перечисления.СостоянияДокументов.ПустаяСсылка();
	
КонецФункции

Функция УстановитьСостояниеДокумента(СчетСсылка, Состояние, ИмяСостояния, ИмяСобытия)
	
	Период = ТекущаяДатаСеанса();
	Установил = Неопределено;
	Попытка
		Установил = ПользователиКлиентСервер.ТекущийПользователь();
	Исключение
		Попытка
			Установил = Пользователи.ТекущийПользователь();
		Исключение
			Установил = Неопределено;
		КонецПопытки;
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
		"Ставим состояние " + ИмяСостояния + ". Установил=" + Строка(Установил) + " период=" + Период);
	
	Попытка
		Делопроизводство.ЗаписатьСостояниеДокумента(СчетСсылка, Период, Состояние, Установил);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"Делопроизводство.ЗаписатьСостояниеДокумента выполнена");
		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
			"ЗаписатьСостояниеДокумента: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Пробуем УстановитьСостояние.");
	КонецПопытки;
	
	Попытка
		Делопроизводство.УстановитьСостояние(СчетСсылка, Состояние);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"Делопроизводство.УстановитьСостояние выполнена");
		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , СчетСсылка,
			"УстановитьСостояние: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

Функция НайтиСчетВДО(КодИлиНомер, ИмяСобытия)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Поиск счёта. Ищем=[" + КодИлиНомер + "] длина=" + СтрДлина(КодИлиНомер));
	
	НайдСчет = Справочники.ВнутренниеДокументы.НайтиПоКоду(КодИлиНомер);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"НайтиПоКоду: найдено=" + (ЗначениеЗаполнено(НайдСчет)) + " ссылка=" + Строка(НайдСчет));
	Если ЗначениеЗаполнено(НайдСчет) Тогда
		Возврат НайдСчет;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВнутренниеДокументы.Ссылка КАК Ссылка,
	|	ВнутренниеДокументы.Код КАК Код,
	|	ВнутренниеДокументы.РегистрационныйНомер КАК РегистрационныйНомер
	|ИЗ
	|	Справочник.ВнутренниеДокументы КАК ВнутренниеДокументы
	|ГДЕ
	|	НЕ ВнутренниеДокументы.ПометкаУдаления
	|	И (ВнутренниеДокументы.РегистрационныйНомер = &Номер
	|		ИЛИ ВнутренниеДокументы.Код = &Номер)";
	Запрос.УстановитьПараметр("Номер", КодИлиНомер);
	
	РезультатЗапроса = Запрос.Выполнить();
	Пустой = РезультатЗапроса.Пустой();
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Запрос по рег.номеру/коду: пустой=" + (Пустой));
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Выборка.Ссылка,
			"Найден запросом код=[" + СокрЛП(Выборка.Код) + "] рег.номер=["
			+ СокрЛП(Выборка.РегистрационныйНомер) + "]");
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
		"Поиск не дал ссылки для [" + КодИлиНомер + "]");
	
	Возврат Справочники.ВнутренниеДокументы.ПустаяСсылка();
	
КонецФункции

Функция ИдВидаПлановойЗаявки()
	Возврат "0f8f6296-ba4a-11f1-a615-9c69b465b0dd";
КонецФункции

Функция ЭтоПризнакОплатыВJSON(Данные)
	
	Если БулевоИзЗначенияОплаты(ЗначениеСвойства(Данные, "Оплачена", Ложь)) Тогда
		Возврат Истина;
	КонецЕсли;
	Если БулевоИзЗначенияОплаты(ЗначениеСвойства(Данные, "Исполнен", Ложь)) Тогда
		Возврат Истина;
	КонецЕсли;
	
	СтатусТекст = ВРег(СокрЛП(Строка(ЗначениеСвойства(Данные, "Статус", ""))));
	Возврат СтатусТекст = "ОПЛАЧЕНА"
		Или СтатусТекст = "ОПЛАЧЕН"
		Или СтатусТекст = "ИСПОЛНЕН"
		Или СтатусТекст = "ИСПОЛНЕНА"
		Или СтатусТекст = "PAID";
	
КонецФункции

Функция БулевоИзЗначенияОплаты(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	СтрокаЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "ИСТИНА"
		Или СтрокаЗначения = "TRUE"
		Или СтрокаЗначения = "1"
		Или СтрокаЗначения = "ДА"
		Или СтрокаЗначения = "ОПЛАЧЕНА"
		Или СтрокаЗначения = "ОПЛАЧЕН"
		Или СтрокаЗначения = "ИСПОЛНЕН";
	
КонецФункции

Функция ОбработатьОплатуДокумента(ДокументСсылка, ИмяСобытия)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ДокументСсылка,
		"Оплата заявки: ставим состояние Исполнен");
	
	ЦелевоеСостояние = СостояниеИсполненДокумента();
	Если Не ЗначениеЗаполнено(ЦелевоеСостояние) Тогда
		Возврат ОтветJSON(Ложь, "В ДО нет состояния Исполнен/Оплачен. Журнал FromBuhStatus.", ДокументСсылка);
	КонецЕсли;
	
	Если УстановитьСостояниеДокумента(ДокументСсылка, ЦелевоеСостояние, "Исполнен", ИмяСобытия) Тогда
		Возврат ОтветJSON(Истина, "Заявка оплачена. Состояние документа в ДО: Исполнен", ДокументСсылка);
	КонецЕсли;
	Возврат ОтветJSON(Ложь, "Не удалось поставить состояние Исполнен. Журнал FromBuhStatus.", ДокументСсылка);
	
КонецФункции

Функция СостояниеИсполненДокумента()
	
	Для Каждого Имя Из СтрРазделить("Исполнен,Исполнено,Оплачен,Оплачена", ",", Ложь) Цикл
		Попытка
			Возврат Перечисления.СостоянияДокументов[Имя];
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Перечисления.СостоянияДокументов.ПустаяСсылка();
	
КонецФункции

Функция ЭтоПризнакПлановойВJSON(Данные)
	
	Если БулевоИзЗначения(ЗначениеСвойства(Данные, "ПлановаяЗаявка", Ложь)) Тогда
		Возврат Истина;
	КонецЕсли;
	ВидДокумента = ВРег(СтрЗаменить(СокрЛП(Строка(ЗначениеСвойства(Данные, "ВидДокумента", ""))), " ", ""));
	Возврат ВидДокумента = "ПЛАНОВАЯЗАЯВКА";
	
КонецФункции

Функция ЭтоПлановаяЗаявкаДО(ДокументСсылка)
	
	Попытка
		ВидДокумента = ДокументСсылка.ВидДокумента;
		Если Строка(ВидДокумента.УникальныйИдентификатор()) = ИдВидаПлановойЗаявки() Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат СтрНайти(ВРег(СокрЛП(Строка(ВидДокумента))), "ПЛАНОВ") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ОбработатьСтатусПлановойЗаявки(ДокументСсылка, Статус, ИмяСобытия)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ДокументСсылка,
		"Плановая заявка: статус=" + (Статус) + " (график в ДО не требуется)");
	
	Если Статус Тогда
		Если УстановитьСостояниеДокумента(ДокументСсылка, Перечисления.СостоянияДокументов.Согласован,
			"Согласован", ИмяСобытия) Тогда
			ТекстЗадачи = СоздатьЗадачуСоздатьСчетаНаОплату(ДокументСсылка, ИмяСобытия);
			Возврат ОтветJSON(Истина, "Плановая заявка согласована. " + ТекстЗадачи, ДокументСсылка);
		КонецЕсли;
		Возврат ОтветJSON(Ложь, "Не удалось поставить состояние Согласован. Журнал FromBuhStatus.", ДокументСсылка);
	КонецЕсли;
	
	Если УстановитьСостояниеДокумента(ДокументСсылка, Перечисления.СостоянияДокументов.НаСогласовании,
		"На согласовании", ИмяСобытия) Тогда
		Возврат ОтветJSON(Истина, "Согласование плановой снято. Состояние: На согласовании", ДокументСсылка);
	КонецЕсли;
	Возврат ОтветJSON(Ложь, "Не удалось вернуть состояние На согласовании. Журнал FromBuhStatus.", ДокументСсылка);
	
КонецФункции

Функция СоздатьЗадачуСоздатьСчетаНаОплату(Предмет, ИмяСобытия)
	
	Тема = "Создать документ Счет на оплату";
	
	Если ЕстьОткрытаяЗадачаПоПредмету(Предмет, Тема) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Предмет,
			"Задача уже есть, повторно не создаём");
		Возврат "Задача на создание счетов уже существует.";
	КонецЕсли;
	
	Исполнитель = ИсполнительПлановойЗаявки(Предмет);
	
	ИменаПроцессов = СтрРазделить("Поручение,Исполнение,Ознакомление", ",", Ложь);
	Для Каждого ИмяПроцесса Из ИменаПроцессов Цикл
		Текст = ЗапуститьБизнесПроцессПоПредмету(ИмяПроцесса, Предмет, Тема, Исполнитель, ИмяСобытия);
		Если ЗначениеЗаполнено(Текст) Тогда
			Возврат Текст;
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Предмет,
		"Не удалось создать БП Поручение/Исполнение/Ознакомление. Состояние Согласован записано — штатный БП вида может создать задачу.");
	Возврат "Состояние Согласован записано. Задачу создайте из БП вида, если она не появилась.";
	
КонецФункции

Функция ЕстьОткрытаяЗадачаПоПредмету(Предмет, Тема)
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗадачаИсполнителяПредметы.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя.Предметы КАК ЗадачаИсполнителяПредметы
		|ГДЕ
		|	ЗадачаИсполнителяПредметы.Предмет = &Предмет
		|	И ЗадачаИсполнителяПредметы.Ссылка.Выполнена = ЛОЖЬ
		|	И ЗадачаИсполнителяПредметы.Ссылка.Наименование ПОДОБНО &Тема";
		Запрос.УстановитьПараметр("Предмет", Предмет);
		Запрос.УстановитьПараметр("Тема", "%" + Тема + "%");
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ИсполнительПлановойЗаявки(Предмет)
	
	Имена = СтрРазделить("Ответственный,Подготовил,Автор", ",", Ложь);
	Для Каждого ИмяРеквизита Из Имена Цикл
		Попытка
			Значение = Предмет[ИмяРеквизита];
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		Возврат Пользователи.ТекущийПользователь();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ЗапуститьБизнесПроцессПоПредмету(ИмяПроцесса, Предмет, Тема, Исполнитель, ИмяСобытия)
	
	Попытка
		Менеджер = БизнесПроцессы[ИмяПроцесса];
	Исключение
		Возврат "";
	КонецПопытки;
	
	Попытка
		
		БП = Менеджер.СоздатьБизнесПроцесс();
		БП.Дата = ТекущаяДатаСеанса();
		БП.Наименование = Тема;
		Попытка
			БП.Описание = "На основании плановой заявки создайте счета на оплату.";
		Исключение
		КонецПопытки;
		Попытка
			БП.Автор = Пользователи.ТекущийПользователь();
		Исключение
		КонецПопытки;
		
		Попытка
			БП.Предмет = Предмет;
		Исключение
			Попытка
				СтрокаПредмета = БП.Предметы.Добавить();
				СтрокаПредмета.Предмет = Предмет;
				Попытка
					СтрокаПредмета.ИмяПредмета = "Документ";
				Исключение
				КонецПопытки;
			Исключение
			КонецПопытки;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(Исполнитель) Тогда
			Попытка
				БП.Исполнитель = Исполнитель;
			Исключение
				Попытка
					СтрокаИсп = БП.Исполнители.Добавить();
					СтрокаИсп.Исполнитель = Исполнитель;
				Исключение
				КонецПопытки;
			КонецПопытки;
		КонецЕсли;
		
		БП.Записать();
		БП.Старт();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Предмет,
			"Создан и стартован БП " + ИмяПроцесса + " " + Строка(БП.Ссылка));
		Возврат "Создана задача: " + Тема + ".";
		
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , Предмет,
			"БП " + ИмяПроцесса + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "";
	КонецПопытки;
	
КонецФункции

Функция ОтветJSON(Успех, Сообщение, Счет = Неопределено)
	
	Данные = Новый Структура;
	Данные.Вставить("success", Успех);
	Данные.Вставить("message", Сообщение);
	Если Счет <> Неопределено И ЗначениеЗаполнено(Счет) Тогда
		Данные.Вставить("documentCode", СокрЛП(Счет.Код));
		Данные.Вставить("registrationNumber", СокрЛП(Счет.РегистрационныйНомер));
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации("FromBuhStatus", УровеньЖурналаРегистрации.Информация, , ,
		"HTTP-ответ 200 success=" + (Успех) + " тело=" + СтрокаJSON);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

Функция КлючиСтруктурыСтрокой(Данные)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	
	Имена = Новый Массив;
	Для Каждого КлючИЗначение Из Данные Цикл
		Имена.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Возврат СтрСоединить(Имена, ",");
	
КонецФункции

Функция ЗначениеСвойства(Данные, Имя, ЗначениеПоУмолчанию)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция БулевоИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	
	СтрокаЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "ИСТИНА"
		Или СтрокаЗначения = "TRUE"
		Или СтрокаЗначения = "YES"
		Или СтрокаЗначения = "ДА"
		Или СтрокаЗначения = "1"
		Или СтрокаЗначения = "ОДОБРЕН"
		Или СтрокаЗначения = "ОДОБРЕНА"
		Или СтрокаЗначения = "СОГЛАСОВАН"
		Или СтрокаЗначения = "СОГЛАСОВАНА"
		Или СтрокаЗначения = "APPROVED";
	
КонецФункции

Функция ДатаИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат НачалоДня(Значение);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	СтрокаДаты = СокрЛП(Строка(Значение));
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "-", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, ".", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "/", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, " ", "");
	
	Если СтрДлина(СтрокаДаты) >= 8 И СтрокаСодержитТолькоЦифры(Лев(СтрокаДаты, 8)) Тогда
		Фрагмент = Лев(СтрокаДаты, 8);
		Если Лев(Фрагмент, 4) > "1900" Тогда
			Попытка
				Возврат Дата(Число(Лев(Фрагмент, 4)), Число(Сред(Фрагмент, 5, 2)), Число(Сред(Фрагмент, 7, 2)));
			Исключение
			КонецПопытки;
		Иначе
			Попытка
				Возврат Дата(Число(Сред(Фрагмент, 5, 4)), Число(Сред(Фрагмент, 3, 2)), Число(Лев(Фрагмент, 2)));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Возврат НачалоДня(СтроковыеФункцииКлиентСервер.СтрокаВДату(СокрЛП(Строка(Значение))));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

Функция СтрокаСодержитТолькоЦифры(СтрокаПроверки)
	
	Для Индекс = 1 По СтрДлина(СтрокаПроверки) Цикл
		Если СтрНайти("0123456789", Сред(СтрокаПроверки, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрДлина(СтрокаПроверки) > 0;
	
КонецФункции

// Обработчик шаблона DownloadPlanStatus в живом сервисе ФУ_ЗагрузкаСтатусовИзБух.
Функция ЗагрузкаСтатусаPlanStatus(Запрос)
	
	Возврат ЗагрузкаСтатусаПлановой(Запрос);
	
КонецФункции

Функция ЗагрузкаСтатусаПлановой(Запрос)
	
	ИмяСобытия = "FromBuhStatus";
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Старт ЗагрузкаСтатусаПлановой");
	
	Попытка
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Возврат ОтветJSON(Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
			Если ДанныеЗапроса.Количество() = 0 Тогда
				Возврат ОтветJSON(Ложь, "Пустой массив в теле запроса");
			КонецЕсли;
			СтруктураИзБух = ДанныеЗапроса[0];
		Иначе
			СтруктураИзБух = ДанныеЗапроса;
		КонецЕсли;
		
		КодСчета = СокрЛП(Строка(ЗначениеСвойства(СтруктураИзБух, "КодСчета", "")));
		Статус = БулевоИзЗначения(ЗначениеСвойства(СтруктураИзБух, "Статус", Ложь));
		
		Если Не ЗначениеЗаполнено(КодСчета) Тогда
			Возврат ОтветJSON(Ложь, "Не передан КодСчета");
		КонецЕсли;
		
		НайдСчет = НайтиСчетВДО(КодСчета, ИмяСобытия);
		Если Не ЗначениеЗаполнено(НайдСчет) Тогда
			Возврат ОтветJSON(Ложь, "Плановая заявка не найдена: " + КодСчета);
		КонецЕсли;
		
		Возврат ОбработатьСтатусПлановойЗаявки(НайдСчет, Статус, ИмяСобытия);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветJSON(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецФункции

