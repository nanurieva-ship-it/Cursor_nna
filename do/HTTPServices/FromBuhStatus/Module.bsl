// =============================================================================
// ТОЛЬКО HTTP-сервис ДО: ФУ_ЗагрузкаСтатусовИзБух
// Конфигуратор: HTTP-сервисы → ФУ_ЗагрузкаСтатусовИзБух → модуль
// Шаблоны: DownloadStatus → ЗагрузкаСтатусаStatus
//          DownloadPlanStatus → ЗагрузкаСтатусаPlanStatus
//
// НЕ вставлять в форму Справочник.ВнутренниеДокументы — там файл do/FormExtension.bsl
// Журнал: событие «FromBuhStatus»
// =============================================================================

Функция ЗагрузкаСтатусаStatus(Запрос)
	
	ИмяСобытия = "FromBuhStatus";
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Старт ЗагрузкаСтатусаStatus. Пользователь=" + Строка(ПользователиИнформационнойБазы.ТекущийПользователь())
		+ " привилегированный=" + (ПривилегированныйРежим()));
	
	Попытка
		
		МетодЗапроса = "";
		Попытка
			МетодЗапроса = Строка(Запрос.HTTPМетод);
		Исключение
			МетодЗапроса = "?";
		КонецПопытки;
		
		БазовыйURL = "";
		Попытка
			БазовыйURL = Строка(Запрос.БазовыйURL);
		Исключение
		КонецПопытки;
		
		ОтносительныйURL = "";
		Попытка
			ОтносительныйURL = Строка(Запрос.ОтносительныйURL);
		Исключение
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"HTTP " + МетодЗапроса + " " + БазовыйURL + ОтносительныйURL);
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело длина=" + Формат(СтрДлина(ТелоЗапроса), "ЧН=0; ЧГ=")
			+ " пустое=" + (Не ЗначениеЗаполнено(ТелоЗапроса))
			+ " текст=" + Лев(ТелоЗапроса, 2000));
		
		Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
				"Отказ: пустое тело запроса");
			Возврат ОтветJSON(Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"JSON разобран. ТипКорня=" + Строка(ТипЗнч(ДанныеЗапроса))
			+ ?(ТипЗнч(ДанныеЗапроса) = Тип("Массив"),
				" количество=" + ДанныеЗапроса.Количество(),
				""));
		
		Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
			Если ДанныеЗапроса.Количество() = 0 Тогда
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
					"Отказ: пустой массив");
				Возврат ОтветJSON(Ложь, "Пустой массив в теле запроса");
			КонецЕсли;
			СтруктураИзБух = ДанныеЗапроса[0];
		Иначе
			СтруктураИзБух = ДанныеЗапроса;
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тип элемента=" + Строка(ТипЗнч(СтруктураИзБух))
			+ " ключи=" + КлючиСтруктурыСтрокой(СтруктураИзБух));
		
		СыройКод = ЗначениеСвойства(СтруктураИзБух, "КодСчета", "");
		СыраяДата = ЗначениеСвойства(СтруктураИзБух, "ДатаПлатежа", Неопределено);
		СыройСтатус = ЗначениеСвойства(СтруктураИзБух, "Статус", Ложь);
		АвтоСогласование = БулевоИзЗначения(ЗначениеСвойства(СтруктураИзБух, "АвтоСогласование", Ложь));
		Если Не АвтоСогласование Тогда
			АвтоСогласование = БулевоИзЗначения(ЗначениеСвойства(СтруктураИзБух, "Автосогласование", Ложь));
		КонецЕсли;
		НеСогласованоИзJSON = ЭтоПризнакНеСогласованоВJSON(СтруктураИзБух, СыройСтатус);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Сырые поля: КодСчета тип=" + Строка(ТипЗнч(СыройКод)) + " значение=[" + Строка(СыройКод) + "]"
			+ " ДатаПлатежа тип=" + Строка(ТипЗнч(СыраяДата)) + " значение=[" + Строка(СыраяДата) + "]"
			+ " Статус тип=" + Строка(ТипЗнч(СыройСтатус)) + " значение=[" + Строка(СыройСтатус) + "]"
			+ " АвтоСогласование=" + (АвтоСогласование)
			+ " Оплачена=[" + Строка(ЗначениеСвойства(СтруктураИзБух, "Оплачена", "")) + "]");
		
		КодСчета = СокрЛП(Строка(СыройКод));
		ДатаИзБух = ДатаИзЗначения(СыраяДата);
		Статус = БулевоИзЗначения(СыройСтатус);
		ПлановаяИзJSON = ЭтоПризнакПлановойВJSON(СтруктураИзБух);
		ОплатаИзJSON = ЭтоПризнакОплатыВJSON(СтруктураИзБух);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"После разбора: КодСчета=[" + КодСчета + "]"
			+ " Дата=" + Формат(ДатаИзБух, "ДФ=yyyyMMdd; ДП=00010101")
			+ " заполнена=" + (ЗначениеЗаполнено(ДатаИзБух))
			+ 			" Статус=" + (Статус)
			+ " АвтоСогласование=" + (АвтоСогласование)
			+ " ПлановаяJSON=" + (ПлановаяИзJSON)
			+ " ОплатаJSON=" + (ОплатаИзJSON)
			+ " НеСогласованоJSON=" + (НеСогласованоИзJSON));
		
		Если Не ЗначениеЗаполнено(КодСчета) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
				"Отказ: не передан КодСчета");
			Возврат ОтветJSON(Ложь, "Не передан КодСчета");
		КонецЕсли;
		
		НайдСчет = НайтиСчетВДО(КодСчета, ИмяСобытия);
		Если Не ЗначениеЗаполнено(НайдСчет) Тогда
			Текст = "Счёт в ДО не найден ни по коду, ни по регистрационному номеру: [" + КодСчета + "]";
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		Если ОплатаИзJSON Тогда
			Возврат ОбработатьОплатуДокумента(НайдСчет, ИмяСобытия);
		КонецЕсли;
		
		Если НеСогласованоИзJSON Тогда
			Возврат ОбработатьНеСогласованиеДокумента(НайдСчет, ИмяСобытия);
		КонецЕсли;
		
		Если АвтоСогласование Тогда
			Возврат ОбработатьАвтоСогласованиеСчета(НайдСчет, Статус, ИмяСобытия);
		КонецЕсли;
		
		СчетОбъект = НайдСчет.ПолучитьОбъект();
		КоличествоСтрок = 0;
		Попытка
			КоличествоСтрок = СчетОбъект.ГрафикПлатежей.Количество();
		Исключение
			КоличествоСтрок = 0;
		КонецПопытки;
		
		Если ПлановаяИзJSON Или ЭтоПлановаяЗаявкаДО(НайдСчет) Или КоличествоСтрок = 0 Тогда
			Возврат ОбработатьСтатусПлановойЗаявки(НайдСчет, Статус, ИмяСобытия);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДатаИзБух) Тогда
			Текст = "Не разобрана ДатаПлатежа: " + Строка(СыраяДата);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , "Отказ: " + Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Найден счёт ссылка=" + Строка(НайдСчет)
			+ " код=[" + СокрЛП(НайдСчет.Код) + "]"
			+ " рег.номер=[" + СокрЛП(НайдСчет.РегистрационныйНомер) + "]"
			+ " помечен=" + (НайдСчет.ПометкаУдаления)
			+ " строкГрафика=" + КоличествоСтрок);
		
		ИзмДок = Ложь;
		НайденныеДаты = Новый Массив;
		НомерСтроки = 0;
		
		Для Каждого ТекГрафик Из СчетОбъект.ГрафикПлатежей Цикл
			
			НомерСтроки = НомерСтроки + 1;
			ДатаСтроки = НачалоДня(ТекГрафик.ДатаПлатежа);
			СогласованоБыло = Неопределено;
			Попытка
				СогласованоБыло = ТекГрафик.Согласовано;
			Исключение
				СогласованоБыло = "?";
			КонецПопытки;
			
			НайденныеДаты.Добавить(Формат(ДатаСтроки, "ДФ=yyyyMMdd"));
			Совпадает = (ДатаСтроки = НачалоДня(ДатаИзБух));
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
				"График[" + НомерСтроки + "] датаДок=" + Формат(ДатаСтроки, "ДФ=yyyyMMdd")
				+ " датаБП=" + Формат(НачалоДня(ДатаИзБух), "ДФ=yyyyMMdd")
				+ " совпадает=" + (Совпадает)
				+ " СогласованоБыло=" + Строка(СогласованоБыло));
			
			Если Совпадает Тогда
				ТекГрафик.Согласовано = Статус;
				ИзмДок = Истина;
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
					"Строка " + НомерСтроки + ": Согласовано " + Строка(СогласованоБыло) + " → " + (Статус));
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ИзмДок Тогда
			Если КоличествоСтрок = 0 И ЭтоПлановаяЗаявкаДО(НайдСчет) Тогда
				Возврат ОбработатьСтатусПлановойЗаявки(НайдСчет, Статус, ИмяСобытия);
			КонецЕсли;
			Текст = "В графике счёта нет даты " + Формат(ДатаИзБух, "ДФ=dd.MM.yyyy")
				+ ". Строк=" + КоличествоСтрок
				+ ". Даты в ДО: " + СтрСоединить(НайденныеДаты, ", ");
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , НайдСчет, Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Перед Записать()");
		
		Попытка
			СчетОбъект.Записать();
		Исключение
			Текст = "Не удалось записать счёт: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , НайдСчет,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат ОтветJSON(Ложь, Текст);
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Записано. Согласовано=" + (Статус) + " дата=" + Формат(ДатаИзБух, "ДФ=dd.MM.yyyy"));
		
		СообщениеОтвета = ОбновитьСостояниеПоГрафику(СчетОбъект, НайдСчет, ИмяСобытия);
		
		Возврат ОтветJSON(Истина, СообщениеОтвета, НайдСчет);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			"Исключение в ЗагрузкаСтатусаStatus: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветJSON(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецФункции

Функция ВесьГрафикСогласован(СчетОбъект, СчетСсылка, ИмяСобытия)
	
	Всего = СчетОбъект.ГрафикПлатежей.Количество();
	Если Всего = 0 Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
			"График пустой — состояние Согласован не ставим");
		Возврат Ложь;
	КонецЕсли;
	
	СогласованоСтрок = 0;
	НомерСтроки = 0;
	Для Каждого СтрокаГрафика Из СчетОбъект.ГрафикПлатежей Цикл
		НомерСтроки = НомерСтроки + 1;
		СтрокаСогласована = Ложь;
		Попытка
			СтрокаСогласована = (СтрокаГрафика.Согласовано = Истина);
		Исключение
		КонецПопытки;
		Если Не СтрокаСогласована Тогда
			Попытка
				СтрокаСогласована = (СтрокаГрафика.Статус = Истина);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Если СтрокаСогласована Тогда
			СогласованоСтрок = СогласованоСтрок + 1;
		КонецЕсли;
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"Проверка графика[" + НомерСтроки + "] дата=" + Формат(СтрокаГрафика.ДатаПлатежа, "ДФ=yyyyMMdd")
			+ " согласована=" + (СтрокаСогласована));
	КонецЦикла;
	
	Весь = (СогласованоСтрок = Всего);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
		"Итог графика: согласовано " + СогласованоСтрок + " из " + Всего + " весь=" + (Весь));
	
	Возврат Весь;
	
КонецФункции

Функция ОбновитьСостояниеПоГрафику(СчетОбъект, СчетСсылка, ИмяСобытия)
	
	ВесьСогласован = ВесьГрафикСогласован(СчетОбъект, СчетСсылка, ИмяСобытия);
	Если СчетОбъект.ГрафикПлатежей.Количество() = 0 Тогда
		Возврат "Согласование записано";
	КонецЕсли;
	
	Если ВесьСогласован Тогда
		ЦелевоеСостояние = Перечисления.СостоянияДокументов.Согласован;
		ИмяЦелевого = "Согласован";
	Иначе
		ЦелевоеСостояние = Перечисления.СостоянияДокументов.НаСогласовании;
		ИмяЦелевого = "На согласовании";
	КонецЕсли;
	
	ТекущееСостояние = ПолучитьТекущееСостояниеДокумента(СчетСсылка, ИмяСобытия);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
		"Состояние сейчас=[" + Строка(ТекущееСостояние) + "] цель=[" + ИмяЦелевого
		+ "] весьГрафик=" + (ВесьСогласован));
	
	Если ЗначениеЗаполнено(ТекущееСостояние) И ТекущееСостояние = ЦелевоеСостояние Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"Состояние уже " + ИмяЦелевого + ", не переписываем");
		Возврат "Согласование записано. Состояние документа: " + ИмяЦелевого;
	КонецЕсли;
	
	Если УстановитьСостояниеДокумента(СчетСсылка, ЦелевоеСостояние, ИмяЦелевого, ИмяСобытия) Тогда
		Если ВесьСогласован Тогда
			Возврат "Согласование записано. Состояние документа: Согласован";
		КонецЕсли;
		Возврат "Строка снята. Состояние документа сброшено: На согласовании";
	КонецЕсли;
	
	Если ВесьСогласован Тогда
		Возврат "График согласован полностью, но состояние документа сменить не удалось. Смотрите журнал FromBuhStatus";
	КонецЕсли;
	Возврат "Строка снята, но состояние Согласован сбросить не удалось. Смотрите журнал FromBuhStatus";
	
КонецФункции

Функция ПолучитьТекущееСостояниеДокумента(СчетСсылка, ИмяСобытия)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СостояниеИзРегистра = СостояниеСогласованияИзРегистра(СчетСсылка);
	Если ЗначениеЗаполнено(СостояниеИзРегистра) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"Состояние из регистра=[" + Строка(СостояниеИзРегистра) + "]");
		Возврат СостояниеИзРегистра;
	КонецЕсли;
	
	ВариантыВызова = Новый Массив;
	ВариантыВызова.Добавить("1");
	ВариантыВызова.Добавить("2");
	Для Каждого Вариант Из ВариантыВызова Цикл
		Попытка
			Если Вариант = "1" Тогда
				Состояния = Делопроизводство.ПолучитьСостоянияДокумента(СчетСсылка);
			Иначе
				Состояния = Делопроизводство.ПолучитьСостоянияДокумента(СчетСсылка, Неопределено);
			КонецЕсли;
			Разобранное = СостояниеСогласованияИзЗначения(Состояния);
			Если ЗначениеЗаполнено(Разобранное) Тогда
				Возврат Разобранное;
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
				"ПолучитьСостоянияДокумента (" + Вариант + "): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Возврат Перечисления.СостоянияДокументов.ПустаяСсылка();
	
КонецФункции

Функция СостояниеСогласованияИзЗначения(Состояния)
	
	Если Состояния = Неопределено Тогда
		Возврат Перечисления.СостоянияДокументов.ПустаяСсылка();
	КонецЕсли;
	Если ТипЗнч(Состояния) = Тип("Массив") Тогда
		Для Каждого Элемент Из Состояния Цикл
			Найденное = СостояниеСогласованияИзЗначения(Элемент);
			Если ЗначениеЗаполнено(Найденное) Тогда
				Возврат Найденное;
			КонецЕсли;
		КонецЦикла;
		Если Состояния.Количество() > 0 Тогда
			Возврат Состояния[0];
		КонецЕсли;
	ИначеЕсли ТипЗнч(Состояния) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Состояния Цикл
			Найденное = СостояниеСогласованияИзЗначения(КлючИЗначение.Значение);
			Если ЗначениеЗаполнено(Найденное) Тогда
				Возврат Найденное;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Состояния) = Тип("Структура") Тогда
		ЗначениеСостояния = Неопределено;
		Если Состояния.Свойство("СостояниеСогласования", ЗначениеСостояния)
			И ЗначениеЗаполнено(ЗначениеСостояния) Тогда
			Возврат ЗначениеСостояния;
		КонецЕсли;
		Если Состояния.Свойство("Состояние", ЗначениеСостояния) И ЗначениеЗаполнено(ЗначениеСостояния) Тогда
			Возврат ЗначениеСостояния;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Состояния) = Тип("ПеречислениеСсылка.СостоянияДокументов") Тогда
		Возврат Состояния;
	КонецЕсли;
	
	Возврат Перечисления.СостоянияДокументов.ПустаяСсылка();
	
КонецФункции

Функция СостояниеСогласованияИзРегистра(СчетСсылка)
	
	Тексты = Новый Массив;
	Тексты.Добавить(
	"ВЫБРАТЬ
	|	ТекущиеСостоянияДокументов.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.ТекущиеСостоянияДокументов КАК ТекущиеСостоянияДокументов
	|ГДЕ
	|	ТекущиеСостоянияДокументов.Документ = &Документ");
	Тексты.Добавить(
	"ВЫБРАТЬ
	|	СостоянияДокументов.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.СостоянияДокументов КАК СостоянияДокументов
	|ГДЕ
	|	СостоянияДокументов.Документ = &Документ");
	
	Для Каждого ТекстЗапроса Из Тексты Цикл
		Попытка
			Запрос = Новый Запрос;
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("Документ", СчетСсылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Имя = ВРег(СтрЗаменить(СокрЛП(Строка(Выборка.Состояние)), " ", ""));
				Если СтрНайти(Имя, "СОГЛАС") > 0 Или СтрНайти(Имя, "УТВЕРЖД") > 0 Тогда
					Возврат Выборка.Состояние;
				КонецЕсли;
			КонецЦикла;
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Состояние;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Перечисления.СостоянияДокументов.ПустаяСсылка();
	
КонецФункции

Функция ЭтоТожеСостояние(Фактическое, Ожидаемое)
	
	Если Фактическое = Ожидаемое Тогда
		Возврат Истина;
	КонецЕсли;
	ИмяФакт = ВРег(СтрЗаменить(СокрЛП(Строка(Фактическое)), " ", ""));
	ИмяОжид = ВРег(СтрЗаменить(СокрЛП(Строка(Ожидаемое)), " ", ""));
	Возврат ЗначениеЗаполнено(ИмяФакт) И ИмяФакт = ИмяОжид;
	
КонецФункции

Функция УстановитьСостояниеДокумента(СчетСсылка, Состояние, ИмяСостояния, ИмяСобытия)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Период = ТекущаяДатаСеанса();
	Установил = Неопределено;
	Попытка
		Установил = ПользователиКлиентСервер.ТекущийПользователь();
	Исключение
		Попытка
			Установил = Пользователи.ТекущийПользователь();
		Исключение
			Установил = Неопределено;
		КонецПопытки;
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
		"Ставим состояние " + ИмяСостояния + ". Установил=" + Строка(Установил) + " период=" + Период);
	
	Попытка
		РаботаССостояниямиДокументов.УстановитьСостояние(СчетСсылка, Состояние);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"РаботаССостояниямиДокументов.УстановитьСостояние выполнена");
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
			"РаботаССостояниямиДокументов: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ЭтоТожеСостояние(СостояниеСогласованияИзРегистра(СчетСсылка), Состояние) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		Делопроизводство.ЗаписатьСостояниеДокумента(СчетСсылка, Состояние);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"ЗаписатьСостояниеДокумента(Документ, Состояние) выполнена");
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
			"ЗаписатьСостояниеДокумента(2): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ЭтоТожеСостояние(СостояниеСогласованияИзРегистра(СчетСсылка), Состояние) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		Делопроизводство.ЗаписатьСостояниеДокумента(СчетСсылка, Период, Состояние, Установил);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"ЗаписатьСостояниеДокумента(Документ, Период, Состояние, Установил) выполнена");
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
			"ЗаписатьСостояниеДокумента(4): " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ЭтоТожеСостояние(СостояниеСогласованияИзРегистра(СчетСсылка), Состояние) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		Делопроизводство.УстановитьСостояние(СчетСсылка, Состояние);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
			"Делопроизводство.УстановитьСостояние выполнена");
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
			"Делопроизводство.УстановитьСостояние: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ЭтоТожеСостояние(СостояниеСогласованияИзРегистра(СчетСсылка), Состояние) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗаписатьСостояниеВРегистрНапрямую(СчетСсылка, Состояние, Установил, Период, ИмяСобытия) Тогда
		Если ЭтоТожеСостояние(СостояниеСогласованияИзРегистра(СчетСсылка), Состояние) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
				"Состояние записано в регистр напрямую: " + ИмяСостояния);
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , СчетСсылка,
		"Состояние " + ИмяСостояния + " не появилось в регистре. Сейчас=["
		+ Строка(СостояниеСогласованияИзРегистра(СчетСсылка)) + "]");
	Возврат Ложь;
	
КонецФункции

Функция ВидСостоянияСогласования()
	
	Имена = СтрРазделить("СостояниеСогласования,Согласование,Согласован", ",", Ложь);
	Для Каждого Имя Из Имена Цикл
		Попытка
			Значение = Перечисления.ВидыСостоянийДокументов[Имя];
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		Для Каждого МетаЗначение Из Метаданные.Перечисления.ВидыСостоянийДокументов.ЗначенияПеречисления Цикл
			Если СтрНайти(ВРег(МетаЗначение.Имя), "СОГЛАС") > 0 Тогда
				Возврат Перечисления.ВидыСостоянийДокументов[МетаЗначение.Имя];
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗаписатьСостояниеВРегистрНапрямую(СчетСсылка, Состояние, Установил, Период, ИмяСобытия)
	
	ИменаРегистров = СтрРазделить("ТекущиеСостоянияДокументов,СостоянияДокументов", ",", Ложь);
	Записано = Ложь;
	
	Для Каждого ИмяРегистра Из ИменаРегистров Цикл
		МетаРегистр = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
		Если МетаРегистр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяДокумента = "";
		ИмяВида = "";
		Для Каждого Измерение Из МетаРегистр.Измерения Цикл
			ИмяИзм = ВРег(Измерение.Имя);
			Если ИмяДокумента = "" И СтрНайти(ИмяИзм, "ДОКУМЕНТ") > 0 Тогда
				ИмяДокумента = Измерение.Имя;
			ИначеЕсли СтрНайти(ИмяИзм, "ВИД") > 0 Тогда
				ИмяВида = Измерение.Имя;
			КонецЕсли;
		КонецЦикла;
		Если Не ЗначениеЗаполнено(ИмяДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
			Набор.Отбор[ИмяДокумента].Установить(СчетСсылка);
			Вид = Неопределено;
			Если ЗначениеЗаполнено(ИмяВида) Тогда
				Вид = ВидСостоянияСогласования();
				Если ЗначениеЗаполнено(Вид) Тогда
					Набор.Отбор[ИмяВида].Установить(Вид);
				КонецЕсли;
			КонецЕсли;
			Набор.Прочитать();
			Набор.Очистить();
			
			Запись = Набор.Добавить();
			Запись[ИмяДокумента] = СчетСсылка;
			Если ЗначениеЗаполнено(ИмяВида) И ЗначениеЗаполнено(Вид) Тогда
				Запись[ИмяВида] = Вид;
			КонецЕсли;
			Если МетаРегистр.Ресурсы.Найти("Состояние") <> Неопределено Тогда
				Запись.Состояние = Состояние;
			КонецЕсли;
			Для Каждого Ресурс Из МетаРегистр.Ресурсы Цикл
				ИмяРес = ВРег(Ресурс.Имя);
				Если СтрНайти(ИмяРес, "УСТАНОВИЛ") > 0 И ЗначениеЗаполнено(Установил) Тогда
					Запись[Ресурс.Имя] = Установил;
				ИначеЕсли СтрНайти(ИмяРес, "ДАТА") > 0 Или ИмяРес = "ПЕРИОД" Тогда
					Запись[Ресурс.Имя] = Период;
				КонецЕсли;
			КонецЦикла;
			Если МетаРегистр.Периодичность <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
				Попытка
					Запись.Период = Период;
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			Набор.Записать();
			Записано = Истина;
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СчетСсылка,
				"Набор " + ИмяРегистра + " записан. вид=[" + Строка(Вид) + "] состояние=[" + Строка(Состояние) + "]");
		Исключение
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , СчетСсылка,
				"Регистр " + ИмяРегистра + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Возврат Записано;
	
КонецФункции

Функция НайтиСчетВДО(КодИлиНомер, ИмяСобытия)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Поиск счёта. Ищем=[" + КодИлиНомер + "] длина=" + СтрДлина(КодИлиНомер));
	
	ВариантыКода = Новый Массив;
	ВариантыКода.Добавить(КодИлиНомер);
	КодБезНулей = СокрЛП(КодИлиНомер);
	Пока СтрДлина(КодБезНулей) > 1 И Лев(КодБезНулей, 1) = "0" Цикл
		КодБезНулей = Сред(КодБезНулей, 2);
	КонецЦикла;
	Если КодБезНулей <> КодИлиНомер Тогда
		ВариантыКода.Добавить(КодБезНулей);
	КонецЕсли;
	
	Для Каждого Вариант Из ВариантыКода Цикл
		НайдСчет = Справочники.ВнутренниеДокументы.НайтиПоКоду(Вариант);
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"НайтиПоКоду [" + Вариант + "]: найдено=" + (ЗначениеЗаполнено(НайдСчет)) + " ссылка=" + Строка(НайдСчет));
		Если ЗначениеЗаполнено(НайдСчет) Тогда
			Возврат НайдСчет;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВнутренниеДокументы.Ссылка КАК Ссылка,
	|	ВнутренниеДокументы.Код КАК Код,
	|	ВнутренниеДокументы.РегистрационныйНомер КАК РегистрационныйНомер
	|ИЗ
	|	Справочник.ВнутренниеДокументы КАК ВнутренниеДокументы
	|ГДЕ
	|	НЕ ВнутренниеДокументы.ПометкаУдаления
	|	И (ВнутренниеДокументы.РегистрационныйНомер = &Номер
	|		ИЛИ ВнутренниеДокументы.Код = &Номер)";
	Запрос.УстановитьПараметр("Номер", КодИлиНомер);
	Если ВариантыКода.Количество() > 1 Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВнутренниеДокументы.Ссылка КАК Ссылка,
		|	ВнутренниеДокументы.Код КАК Код,
		|	ВнутренниеДокументы.РегистрационныйНомер КАК РегистрационныйНомер
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК ВнутренниеДокументы
		|ГДЕ
		|	НЕ ВнутренниеДокументы.ПометкаУдаления
		|	И (ВнутренниеДокументы.РегистрационныйНомер В (&Номера)
		|		ИЛИ ВнутренниеДокументы.Код В (&Номера))";
		Запрос.УстановитьПараметр("Номера", ВариантыКода);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Пустой = РезультатЗапроса.Пустой();
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Запрос по рег.номеру/коду: пустой=" + (Пустой));
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Выборка.Ссылка,
			"Найден запросом код=[" + СокрЛП(Выборка.Код) + "] рег.номер=["
			+ СокрЛП(Выборка.РегистрационныйНомер) + "]");
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
		"Поиск не дал ссылки для [" + КодИлиНомер + "]");
	
	Возврат Справочники.ВнутренниеДокументы.ПустаяСсылка();
	
КонецФункции

