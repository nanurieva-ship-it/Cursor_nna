Функция ЭтоПризнакОплатыВJSON(Данные)
	
	Если БулевоИзЗначенияОплаты(ЗначениеСвойства(Данные, "Оплачена", Ложь)) Тогда
		Возврат Истина;
	КонецЕсли;
	Если БулевоИзЗначенияОплаты(ЗначениеСвойства(Данные, "Исполнен", Ложь)) Тогда
		Возврат Истина;
	КонецЕсли;
	
	СтатусТекст = ВРег(СокрЛП(Строка(ЗначениеСвойства(Данные, "Статус", ""))));
	Возврат СтатусТекст = "ОПЛАЧЕНА"
		Или СтатусТекст = "ОПЛАЧЕН"
		Или СтатусТекст = "ИСПОЛНЕН"
		Или СтатусТекст = "ИСПОЛНЕНА"
		Или СтатусТекст = "PAID";
	
КонецФункции

Функция БулевоИзЗначенияОплаты(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	СтрокаЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "ИСТИНА"
		Или СтрокаЗначения = "TRUE"
		Или СтрокаЗначения = "1"
		Или СтрокаЗначения = "ДА"
		Или СтрокаЗначения = "ОПЛАЧЕНА"
		Или СтрокаЗначения = "ОПЛАЧЕН"
		Или СтрокаЗначения = "ИСПОЛНЕН";
	
КонецФункции

Функция ОбработатьОплатуДокумента(ДокументСсылка, ИмяСобытия)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ДокументСсылка,
		"Оплата заявки: ставим состояние Исполнен");
	
	ЦелевоеСостояние = СостояниеИсполненДокумента();
	Если Не ЗначениеЗаполнено(ЦелевоеСостояние) Тогда
