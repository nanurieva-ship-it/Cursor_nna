// HTTP-сервис ДО: FromBuhStatus / DownloadStatus
// Журнал регистрации: событие «FromBuhStatus» (без отладки смотреть его).

Функция ЗагрузкаСтатусаStatus(Запрос)
	
	ИмяСобытия = "FromBuhStatus";
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Старт ЗагрузкаСтатусаStatus. Пользователь=" + Строка(ПользователиИнформационнойБазы.ТекущийПользователь())
		+ " привилегированный=" + ПривилегированныйРежим());
	
	Попытка
		
		МетодЗапроса = "";
		Попытка
			МетодЗапроса = Строка(Запрос.HTTPМетод);
		Исключение
			МетодЗапроса = "?";
		КонецПопытки;
		
		БазовыйURL = "";
		Попытка
			БазовыйURL = Строка(Запрос.БазовыйURL);
		Исключение
		КонецПопытки;
		
		ОтносительныйURL = "";
		Попытка
			ОтносительныйURL = Строка(Запрос.ОтносительныйURL);
		Исключение
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"HTTP " + МетодЗапроса + " " + БазовыйURL + ОтносительныйURL);
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело длина=" + Формат(СтрДлина(ТелоЗапроса), "ЧН=0; ЧГ=")
			+ " пустое=" + Не ЗначениеЗаполнено(ТелоЗапроса)
			+ " текст=" + Лев(ТелоЗапроса, 2000));
		
		Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
				"Отказ: пустое тело запроса");
			Возврат ОтветJSON(Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"JSON разобран. ТипКорня=" + Строка(ТипЗнч(ДанныеЗапроса))
			+ ?(ТипЗнч(ДанныеЗапроса) = Тип("Массив"),
				" количество=" + ДанныеЗапроса.Количество(),
				""));
		
		Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
			Если ДанныеЗапроса.Количество() = 0 Тогда
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
					"Отказ: пустой массив");
				Возврат ОтветJSON(Ложь, "Пустой массив в теле запроса");
			КонецЕсли;
			СтруктураИзБух = ДанныеЗапроса[0];
		Иначе
			СтруктураИзБух = ДанныеЗапроса;
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тип элемента=" + Строка(ТипЗнч(СтруктураИзБух))
			+ " ключи=" + КлючиСтруктурыСтрокой(СтруктураИзБух));
		
		СыройКод = ЗначениеСвойства(СтруктураИзБух, "КодСчета", "");
		СыраяДата = ЗначениеСвойства(СтруктураИзБух, "ДатаПлатежа", Неопределено);
		СыройСтатус = ЗначениеСвойства(СтруктураИзБух, "Статус", Ложь);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Сырые поля: КодСчета тип=" + Строка(ТипЗнч(СыройКод)) + " значение=[" + Строка(СыройКод) + "]"
			+ " ДатаПлатежа тип=" + Строка(ТипЗнч(СыраяДата)) + " значение=[" + Строка(СыраяДата) + "]"
			+ " Статус тип=" + Строка(ТипЗнч(СыройСтатус)) + " значение=[" + Строка(СыройСтатус) + "]");
		
		КодСчета = СокрЛП(Строка(СыройКод));
		ДатаИзБух = ДатаИзЗначения(СыраяДата);
		Статус = БулевоИзЗначения(СыройСтатус);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"После разбора: КодСчета=[" + КодСчета + "]"
			+ " Дата=" + Формат(ДатаИзБух, "ДФ=yyyyMMdd; ДП=00010101")
			+ " заполнена=" + ЗначениеЗаполнено(ДатаИзБух)
			+ " Статус=" + Статус);
		
		Если Не ЗначениеЗаполнено(КодСчета) Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
				"Отказ: не передан КодСчета");
			Возврат ОтветJSON(Ложь, "Не передан КодСчета");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДатаИзБух) Тогда
			Текст = "Не разобрана ДатаПлатежа: " + Строка(СыраяДата);
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , "Отказ: " + Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		НайдСчет = НайтиСчетВДО(КодСчета, ИмяСобытия);
		Если Не ЗначениеЗаполнено(НайдСчет) Тогда
			Текст = "Счёт в ДО не найден ни по коду, ни по регистрационному номеру: [" + КодСчета + "]";
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , , Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Найден счёт ссылка=" + Строка(НайдСчет)
			+ " код=[" + СокрЛП(НайдСчет.Код) + "]"
			+ " рег.номер=[" + СокрЛП(НайдСчет.РегистрационныйНомер) + "]"
			+ " помечен=" + НайдСчет.ПометкаУдаления);
		
		СчетОбъект = НайдСчет.ПолучитьОбъект();
		КоличествоСтрок = СчетОбъект.ГрафикПлатежей.Количество();
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Строк графика=" + КоличествоСтрок);
		
		ИзмДок = Ложь;
		НайденныеДаты = Новый Массив;
		НомерСтроки = 0;
		
		Для Каждого ТекГрафик Из СчетОбъект.ГрафикПлатежей Цикл
			
			НомерСтроки = НомерСтроки + 1;
			ДатаСтроки = НачалоДня(ТекГрафик.ДатаПлатежа);
			СогласованоБыло = Неопределено;
			Попытка
				СогласованоБыло = ТекГрафик.Согласовано;
			Исключение
				СогласованоБыло = "?";
			КонецПопытки;
			
			НайденныеДаты.Добавить(Формат(ДатаСтроки, "ДФ=yyyyMMdd"));
			Совпадает = (ДатаСтроки = НачалоДня(ДатаИзБух));
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
				"График[" + НомерСтроки + "] датаДок=" + Формат(ДатаСтроки, "ДФ=yyyyMMdd")
				+ " датаБП=" + Формат(НачалоДня(ДатаИзБух), "ДФ=yyyyMMdd")
				+ " совпадает=" + Совпадает
				+ " СогласованоБыло=" + Строка(СогласованоБыло));
			
			Если Совпадает Тогда
				ТекГрафик.Согласовано = Статус;
				ИзмДок = Истина;
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
					"Строка " + НомерСтроки + ": Согласовано " + Строка(СогласованоБыло) + " → " + Статус);
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ИзмДок Тогда
			Текст = "В графике счёта нет даты " + Формат(ДатаИзБух, "ДФ=dd.MM.yyyy")
				+ ". Строк=" + КоличествоСтрок
				+ ". Даты в ДО: " + СтрСоединить(НайденныеДаты, ", ");
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , НайдСчет, Текст);
			Возврат ОтветJSON(Ложь, Текст);
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Перед Записать()");
		
		Попытка
			СчетОбъект.Записать();
		Исключение
			Текст = "Не удалось записать счёт: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , НайдСчет,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат ОтветJSON(Ложь, Текст);
		КонецПопытки;
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , НайдСчет,
			"Записано. Согласовано=" + Статус + " дата=" + Формат(ДатаИзБух, "ДФ=dd.MM.yyyy"));
		
		Возврат ОтветJSON(Истина, "Согласование записано", НайдСчет);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			"Исключение в ЗагрузкаСтатусаStatus: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветJSON(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецФункции

Функция НайтиСчетВДО(КодИлиНомер, ИмяСобытия)
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Поиск счёта. Ищем=[" + КодИлиНомер + "] длина=" + СтрДлина(КодИлиНомер));
	
	НайдСчет = Справочники.ВнутренниеДокументы.НайтиПоКоду(КодИлиНомер);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"НайтиПоКоду: найдено=" + ЗначениеЗаполнено(НайдСчет) + " ссылка=" + Строка(НайдСчет));
	Если ЗначениеЗаполнено(НайдСчет) Тогда
		Возврат НайдСчет;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВнутренниеДокументы.Ссылка КАК Ссылка,
	|	ВнутренниеДокументы.Код КАК Код,
	|	ВнутренниеДокументы.РегистрационныйНомер КАК РегистрационныйНомер
	|ИЗ
	|	Справочник.ВнутренниеДокументы КАК ВнутренниеДокументы
	|ГДЕ
	|	НЕ ВнутренниеДокументы.ПометкаУдаления
	|	И (ВнутренниеДокументы.РегистрационныйНомер = &Номер
	|		ИЛИ ВнутренниеДокументы.Код = &Номер)";
	Запрос.УстановитьПараметр("Номер", КодИлиНомер);
	
	РезультатЗапроса = Запрос.Выполнить();
	Пустой = РезультатЗапроса.Пустой();
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Запрос по рег.номеру/коду: пустой=" + Пустой);
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , Выборка.Ссылка,
			"Найден запросом код=[" + СокрЛП(Выборка.Код) + "] рег.номер=["
			+ СокрЛП(Выборка.РегистрационныйНомер) + "]");
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение, , ,
		"Поиск не дал ссылки для [" + КодИлиНомер + "]");
	
	Возврат Справочники.ВнутренниеДокументы.ПустаяСсылка();
	
КонецФункции

Функция ОтветJSON(Успех, Сообщение, Счет = Неопределено)
	
	Данные = Новый Структура;
	Данные.Вставить("success", Успех);
	Данные.Вставить("message", Сообщение);
	Если Счет <> Неопределено И ЗначениеЗаполнено(Счет) Тогда
		Данные.Вставить("documentCode", СокрЛП(Счет.Код));
		Данные.Вставить("registrationNumber", СокрЛП(Счет.РегистрационныйНомер));
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации("FromBuhStatus", УровеньЖурналаРегистрации.Информация, , ,
		"HTTP-ответ 200 success=" + Успех + " тело=" + СтрокаJSON);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

Функция КлючиСтруктурыСтрокой(Данные)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;
	
	Имена = Новый Массив;
	Для Каждого КлючИЗначение Из Данные Цикл
		Имена.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Возврат СтрСоединить(Имена, ",");
	
КонецФункции

Функция ЗначениеСвойства(Данные, Имя, ЗначениеПоУмолчанию)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция БулевоИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	
	СтрокаЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "ИСТИНА"
		Или СтрокаЗначения = "TRUE"
		Или СтрокаЗначения = "YES"
		Или СтрокаЗначения = "ДА"
		Или СтрокаЗначения = "1";
	
КонецФункции

Функция ДатаИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат НачалоДня(Значение);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	СтрокаДаты = СокрЛП(Строка(Значение));
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "-", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, ".", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, "/", "");
	СтрокаДаты = СтрЗаменить(СтрокаДаты, " ", "");
	
	Если СтрДлина(СтрокаДаты) >= 8 И СтрокаСодержитТолькоЦифры(Лев(СтрокаДаты, 8)) Тогда
		Фрагмент = Лев(СтрокаДаты, 8);
		Если Лев(Фрагмент, 4) > "1900" Тогда
			Попытка
				Возврат Дата(Число(Лев(Фрагмент, 4)), Число(Сред(Фрагмент, 5, 2)), Число(Сред(Фрагмент, 7, 2)));
			Исключение
			КонецПопытки;
		Иначе
			Попытка
				Возврат Дата(Число(Сред(Фрагмент, 5, 4)), Число(Сред(Фрагмент, 3, 2)), Число(Лев(Фрагмент, 2)));
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		Возврат НачалоДня(СтроковыеФункцииКлиентСервер.СтрокаВДату(СокрЛП(Строка(Значение))));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
	
КонецФункции

Функция СтрокаСодержитТолькоЦифры(СтрокаПроверки)
	
	Для Индекс = 1 По СтрДлина(СтрокаПроверки) Цикл
		Если СтрНайти("0123456789", Сред(СтрокаПроверки, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрДлина(СтрокаПроверки) > 0;
	
КонецФункции
