		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		Для Каждого ЗначениеМета Из Метаданные.Перечисления.СостоянияДокументов.ЗначенияПеречисления Цикл
			Имя = ВРег(СтрЗаменить(ЗначениеМета.Имя, " ", ""));
			Синоним = ВРег(СтрЗаменить(ЗначениеМета.Синоним, " ", ""));
			Если СтрНайти(Имя, "НЕСОГЛАСОВ") > 0 Или СтрНайти(Синоним, "НЕ СОГЛАСОВ") > 0
				Или СтрНайти(Синоним, "НЕСОГЛАСОВ") > 0 Тогда
				Возврат Перечисления.СостоянияДокументов[ЗначениеМета.Имя];
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат Перечисления.СостоянияДокументов.ПустаяСсылка();
	
