// HTTP-сервис ДО ImportNSIDO, шаблон Article → ЗагрузкаСтатьиДДС.
// Мастер статей — БП. Журнал: ImportNSIDO.

Функция ЗагрузкаСтатьиДДС(Запрос)
	
	ИмяСобытия = "ImportNSIDO";
	УстановитьПривилегированныйРежим(Истина);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
		"Старт ЗагрузкаСтатьиДДС. Пользователь=" + Строка(ПользователиИнформационнойБазы.ТекущийПользователь()));
	
	Попытка
		
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Тело длина=" + Формат(СтрДлина(ТелоЗапроса), "ЧН=0; ЧГ=")
			+ " пустое=" + (Не ЗначениеЗаполнено(ТелоЗапроса))
			+ " текст=" + Лев(ТелоЗапроса, 2000));
		
		Если Не ЗначениеЗаполнено(ТелоЗапроса) Тогда
			Возврат ОтветJSON(Ложь, "Пустое тело запроса");
		КонецЕсли;
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		ДанныеЗапроса = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		Если ТипЗнч(ДанныеЗапроса) = Тип("Массив") Тогда
			Если ДанныеЗапроса.Количество() = 0 Тогда
				Возврат ОтветJSON(Ложь, "Пустой массив");
			КонецЕсли;
			СтатьяJSON = ДанныеЗапроса[0];
		Иначе
			СтатьяJSON = ДанныеЗапроса;
		КонецЕсли;
		
		Код = СокрЛП(Строка(ЗначениеСвойства(СтатьяJSON, "Код", "")));
		Наименование = СокрЛП(Строка(ЗначениеСвойства(СтатьяJSON, "Наименование", "")));
		ИдентификаторБП = СокрЛП(Строка(ЗначениеСвойства(СтатьяJSON, "ИдентификаторБП", "")));
		ПометкаУдаления = БулевоИзЗначения(ЗначениеСвойства(СтатьяJSON, "ПометкаУдаления", Ложь));
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"Код=[" + Код + "] Наименование=[" + Наименование + "] ИдентификаторБП=[" + ИдентификаторБП + "]"
			+ " ПометкаУдаления=" + (ПометкаУдаления));
		
		Если Не ЗначениеЗаполнено(Код) Тогда
			Возврат ОтветJSON(Ложь, "Не передан Код статьи");
		КонецЕсли;
		
		Статья = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(Код);
		ЭтоНовая = Не ЗначениеЗаполнено(Статья);
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , ,
			"НайтиПоКоду: найдено=" + (Не ЭтоНовая) + " ссылка=" + Строка(Статья));
		
		Если ЭтоНовая Тогда
			СтатьяОбъект = Справочники.СтатьиДвиженияДенежныхСредств.СоздатьЭлемент();
			СтатьяОбъект.Код = Код;
		Иначе
			СтатьяОбъект = Статья.ПолучитьОбъект();
		КонецЕсли;
		
		СтатьяОбъект.Наименование = ?(ЗначениеЗаполнено(Наименование), Наименование, Код);
		СтатьяОбъект.ПометкаУдаления = ПометкаУдаления;
		СтатьяОбъект.ОбменДанными.Загрузка = Истина;
		СтатьяОбъект.Записать();
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация, , СтатьяОбъект.Ссылка,
			?(ЭтоНовая, "Создана", "Обновлена") + " статья код=[" + Код + "]");
		
		Возврат ОтветJSON(Истина, ?(ЭтоНовая, "Статья создана в ДО", "Статья обновлена в ДО"), Код);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат ОтветJSON(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецФункции

Функция ОтветJSON(Успех, Сообщение, Код = "")
	
	Данные = Новый Структура;
	Данные.Вставить("success", Успех);
	Данные.Вставить("message", Сообщение);
	Если ЗначениеЗаполнено(Код) Тогда
		Данные.Вставить("code", Код);
	КонецЕсли;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	ЗаписьЖурналаРегистрации("ImportNSIDO", УровеньЖурналаРегистрации.Информация, , ,
		"HTTP-ответ 200 success=" + (Успех) + " тело=" + СтрокаJSON);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

Функция ЗначениеСвойства(Данные, Имя, ЗначениеПоУмолчанию)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Значение = Неопределено;
	Если Данные.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

Функция БулевоИзЗначения(Значение)
	
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение <> 0;
	КонецЕсли;
	
	СтрокаЗначения = ВРег(СокрЛП(Строка(Значение)));
	Возврат СтрокаЗначения = "ИСТИНА"
		Или СтрокаЗначения = "TRUE"
		Или СтрокаЗначения = "1"
		Или СтрокаЗначения = "ДА";
	
КонецФункции
